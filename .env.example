# =============================================================================
# HolyOS — Environment variables (příklad)
# Zkopíruj do .env a doplň reálné hodnoty.
# =============================================================================

# ─── Databáze ───────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/holyos"

# ─── Aplikace ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000                  # pro absolutní odkazy v emailech

# ─── Autentizace (JWT) ──────────────────────────────────────────────────────
JWT_SECRET="zmen-tenhle-secret-v-produkci"
JWT_EXPIRY=24h

# ─── Anthropic Claude ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...

# ─── SMTP (emailové notifikace) ─────────────────────────────────────────────
# Nastav pro odesílání notifikací o nových chat zprávách na email.
# Pokud SMTP_HOST chybí, emaily jsou tiše vypnuté.
#
# Gmail:   host=smtp.gmail.com, port=465, secure=true, vygeneruj "App password"
# Seznam:  host=smtp.seznam.cz, port=465, secure=true
# SendGrid: host=smtp.sendgrid.net, port=587, secure=false, user=apikey, pass=SG.xxx
# Railway: zvaž službu jako Mailgun, SendGrid, Postmark (vnitřní SMTP na Railway není)

SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="HolyOS <noreply@example.com>"

# Pokud chceš emaily v dev prostředí úplně vypnout bez mazání SMTP_HOST:
# EMAIL_DISABLED=true

# ─── Factorify API (volitelné) ──────────────────────────────────────────────
FACTORIFY_BASE_URL=
FACTORIFY_TOKEN=
FACTORIFY_ACCOUNTING_UNIT=

# ─── Kalendář výrobních slotů — externí API ────────────────────────────────
# Statický klíč pro externí integrace (kolegova aplikace na jiné doméně).
# Vygeneruj 32+ znakový random řetězec, např:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Volání: curl -H "X-API-Key: <klíč>" https://holyos.cz/api/slots/calendar
# Pokud je prázdné, externí API auth je vypnuté (jen cookie auth funguje).
SLOT_CALENDAR_API_KEY=

# Volitelný whitelist originu pro CORS (pokud chceš omezit, kdo smí volat).
# Nechceš-li omezit, nech prázdné — platí globální CORS_ORIGIN níže.
# Příklad: CORS_ORIGIN=https://kolega-aplikace.cz
CORS_ORIGIN=


# ─── AI Vývojář (modul #13) ─────────────────────────────────────────────────
# Worker poller je defaultně VYPNUTÝ. Pro zapnutí nastav obojí:
#   1) AGENT_WORKER_ENABLED=true v env
#   2) AgentSettings.enabled = true v DB (přes Super admin → AI Vývojář → Kill switch)
AGENT_WORKER_ENABLED=false

# GitHub PAT s `repo` scope pro servisní účet AI Vývojáře. Použije se pro
# clone, push do feature větve a otevírání PR. Bez tokenu agent neběží.
AI_DEV_GITHUB_TOKEN=

# Volitelné — kořen pro pracovní adresáře (per-run sandbox). Default os.tmpdir().
# AI_DEV_TMP_DIR=/tmp/holyos-agent

# Volitelné — model pro Claude SDK (default claude-sonnet-4-6).
# AI_DEV_MODEL=claude-sonnet-4-6

# Volitelné — interval pollingu fronty v ms (default 30000).
# AI_DEV_POLL_INTERVAL_MS=30000

# Triage preflight (haiku call PŘED coding loopem). Vypne se nastavením na
# 'false' — pak se každý run pošle rovnou na coding bez triage filtru.
# Default true (zapnuto). Cca 650 tokenů na triage = velmi levné, ale
# zachrání 30k+ tokenů na úkolech se špatným target_repo nebo prázdnými AC.
# AI_DEV_TRIAGE_ENABLED=true

# Volitelné — model pro triage call (default claude-haiku-4-5-20251001).
# Haiku stačí, je výrazně levnější/rychlejší než Sonnet a klasifikační task
# (ok / needs_clarification / stop) zvládá v pohodě.
# AI_DEV_TRIAGE_MODEL=claude-haiku-4-5-20251001

# Planning fáze (Sonnet tool-use call PO clone, PŘED coding). Agent vrátí
# strukturovaný plán (files_to_change, risk, requires_approval). Pokud
# default_autonomy='plan_review' nebo planner sám označí plán jako
# requires_approval=true, run končí na status='awaiting_approval' a čeká na
# schválení v UI Schválení. Default true.
# AI_DEV_PLANNER_ENABLED=true

# Volitelné — model pro planner call. Default AI_DEV_MODEL nebo
# claude-sonnet-4-6 (planner potřebuje větší rozhled než triage).
# AI_DEV_PLANNER_MODEL=claude-sonnet-4-6
