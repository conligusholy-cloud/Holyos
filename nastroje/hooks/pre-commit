#!/bin/sh
# =============================================================================
# Před commitem: dopřeložit, co přibylo
# =============================================================================
# Tohle je to, co drží českou a anglickou verzi pohromadě. Při každém commitu
# se podívá, jestli v katalogu nepřibyl text bez překladu nebo jestli se
# některý český text nezměnil pod hotovým překladem. Když ano a je po ruce
# klíč k API, nechá to dopřeložit a přidá do stejného commitu.
#
# Commit nikdy nezastaví kvůli překladu — chybějící angličtina hráče nezabije,
# hra spadne zpátky do češtiny. Zastaví ho jediná věc: klíč použitý v kódu,
# ke kterému žádný text není. To by hráč viděl jako holý klíč v okně.

if [ -z "$(git diff --cached --name-only | grep -E 'public/compounder/game/game\.js|services/game/texty/|routes/game-')" ]; then
  exit 0
fi

node nastroje/texty-kontrola.js
STAV=$?

# Prohlídka hlídá to horší než chybějící překlad: že přeložené JE, ale špatně.
# Chybějící značka ubere z věty číslo, rozbitá stavba shodí celé okno, z korun
# se stanou herní peníze. Tohle commit zastaví — takhle to hráči nefunguje.
# Každý cizí jazyk v katalogu se prohlédne zvlášť.
for KATALOG in services/game/texty/*.json; do
  JAZYK=$(basename "$KATALOG" .json)
  case "$JAZYK" in cs|*.meta|linka.*|slovnik) continue ;; esac
  if ! node nastroje/texty-prohlidka.js "$JAZYK"; then
    echo ""
    echo "STOP: překlad do $JAZYK má tvrdé nálezy (viz výš)."
    echo "Chybějící překlad commit nezastaví, rozbitý ano — hra by se hráči"
    echo "rozsypala a vypadalo by to jako chyba hry, ne překladu."
    exit 1
  fi
done

if [ "$STAV" -eq 2 ]; then
  echo ""
  echo "STOP: v kódu je klíč, ke kterému v katalogu není žádný text."
  echo "Hráč by na tom místě viděl holý klíč. Doplň ho a zkus to znovu."
  exit 1
fi

# Měny ceníku. Když se sáhne na tabulku měn nebo na kurzy, musí pořád platit,
# že se nezaokrouhluje dolů, že značka stojí na správné straně čísla a že
# žádný jazyk neukazuje na měnu, za kterou Stripe nic nestrhne. Tohle commit
# zastaví — špatná měna v ceníku je horší než chybějící překlad.
if git diff --cached --name-only | grep -qE 'services/game/meny'; then
  if ! node nastroje/tmenypl.js; then
    echo ""
    echo "STOP: měny ceníku nesedí (viz výš)."
    exit 1
  fi
fi

# Překladač: záchranná síť na rozbité uvozovky v odpovědi od API. Když
# přestane fungovat, padá celá dávka kvůli jednomu znaku a nikdo si toho
# nevšimne, dokud nechybí čtyřicet textů.
if git diff --cached --name-only | grep -qE 'nastroje/texty-prelozit'; then
  if ! node nastroje/tprelozit.js; then
    echo ""
    echo "STOP: oprava uvozovek v překladači nesedí (viz výš)."
    exit 1
  fi
fi

# Kurzy měn. Jediné místo, kde se počítají skutečné peníze — rozbor spletený
# o řád znamená stonásobnou cenu a pozná se to až z výpisu.
if git diff --cached --name-only | grep -qE 'services/game/(kurzy|meny)'; then
  if ! node nastroje/tkurzy.js; then
    echo ""
    echo "STOP: kurzy měn nesedí (viz výš)."
    exit 1
  fi
fi

# Auditní zápis vlastnických změn. Je to jediná paměť na to, kdo kdy přišel
# o kus firmy — chyba se pozná až ve chvíli, kdy se někdo ptá a odpověď lže.
if git diff --cached --name-only | grep -qE 'services/game/audit'; then
  if ! node nastroje/taudit.js; then
    echo ""
    echo "STOP: auditní zápis nesedí (viz výš)."
    exit 1
  fi
fi

# Kdo je v nouzi. Hlídá se i tvar dotazu: nulový bajt jako „nemožné id"
# Postgres odmítne a hráč se pak nedozví, čím může ručit.
if git diff --cached --name-only | grep -qE 'services/game/krize'; then
  if ! node nastroje/tkrize.js; then
    echo ""
    echo "STOP: krize nesedí (viz výš)."
    exit 1
  fi
fi

# Přípojky. Server si je počítá sám z otisku místa a musí mu vyjít totéž co
# hře — jinak to není menší díra v čekané změně hotovosti, ale jiný výdaj.
if git diff --cached --name-only | grep -qE 'services/game/pozemky|public/compounder/game/game\.js'; then
  if ! node nastroje/tpripojky.js; then
    echo ""
    echo "STOP: přípojky serveru nesedí s hrou (viz výš)."
    exit 1
  fi
fi

# Pověst z infolinky. Násobí tržbu celé sítě, takže je to poslední místo,
# kde by si šlo přilepšit přepsáním jednoho čísla v uložené hře.
if git diff --cached --name-only | grep -qE 'services/game/(povest|navstevnost)|services/game/texty/linka'; then
  if ! node nastroje/tpovest.js; then
    echo ""
    echo "STOP: počítání pověsti nesedí (viz výš)."
    exit 1
  fi
fi

# Souběh na burze. Dva lidé ve stejnou vteřinu, nebo dvojklik: bez zámku se
# jeden podíl převede dvěma lidem a cena vyplatí dvakrát. Test pouští
# skutečnou obsluhu proti podstrčené databázi a uspí první požadavek přesně
# mezi čtením a zápisem.
if git diff --cached --name-only | grep -qE 'services/game/(soubeh|audit|prevzeti)|routes/game-trade'; then
  if ! node nastroje/tsoubeh.js; then
    echo ""
    echo "STOP: zámky proti souběhu na burze nesedí (viz výš)."
    exit 1
  fi
fi

# Nouzová brzda na burzu. Brzda, která zastaví víc, než má, zamkne hráče
# uprostřed rozjednaného obchodu — a vypadá to jako rozbitá hra. Brzda, která
# zastaví míň, nechá otevřenou díru, kvůli které se tahala.
if git diff --cached --name-only | grep -qE 'services/game/brzda|routes/game-trade'; then
  if ! node nastroje/tbrzda.js; then
    echo ""
    echo "STOP: nouzová brzda na burzu nesedí (viz výš)."
    exit 1
  fi
fi

# Co propadá soudu. Bralo to i koupenou zem a ocenilo ji jako MINI — hráč
# přišel o pozemek, který mu zůstal viset ve hře a nedalo se na něm stavět.
if git diff --cached --name-only | grep -qE 'services/game/zlocin'; then
  if ! node nastroje/tzabaveni.js; then
    echo ""
    echo "STOP: zabavení majetku nesedí (viz výš)."
    exit 1
  fi
fi

# Šipka u měsíčního výnosu drženého podílu. Měří se proti minulému vzorku;
# kdyby se za chybějící vzorek dosadila nula, vypadal by nový podíl jako propad.
if git diff --cached --name-only | grep -qE 'public/compounder/game/game.js|services/game/fond-historie'; then
  if ! node nastroje/tfondsipka.js; then
    echo ""
    echo "STOP: šipka u výnosu podílu nesedí (viz výš)."
    exit 1
  fi
fi

# Návrat do fondu po vlastní akci. Dokud se nerozlišovalo ruční zavření od
# toho po hlasování, vyhodilo to hráče z fondu na mapu.
if git diff --cached --name-only | grep -qE 'public/compounder/game/game.js'; then
  if ! node nastroje/tfondnavrat.js; then
    echo ""
    echo "STOP: návrat do fondu nesedí (viz výš)."
    exit 1
  fi
fi

# Nákup víc kiosků naráz. Objednávka sahá na peníze i na sklad: cena musí
# být za celou objednávku a každá zásilka musí mít vlastní klíč, jinak
# Expresní dovoz zrychlí všechny kusy naráz.
if git diff --cached --name-only | grep -qE 'public/compounder/game/game.js'; then
  if ! node nastroje/tnakupvic.js; then
    echo ""
    echo "STOP: nákup víc kusů nesedí (viz výš)."
    exit 1
  fi
fi

# Utáhne fond dividendu, kterou slíbil? Podle těch čísel se člen rozhoduje,
# jestli sazbu zvednout nebo srazit — špatně změřený odliv ho poslal buď do
# paniky, nebo do rozdávání, na které fond nemá.
if git diff --cached --name-only | grep -qE 'public/compounder/game/game.js'; then
  if ! node nastroje/tudrzitelnost.js; then
    echo ""
    echo "STOP: bilance dividendy nesedí (viz výš)."
    exit 1
  fi
fi

# Prahy hlasování ve fondu. Člen musí PŘEDEM vidět, kolik hlasů je potřeba —
# jinak dá návrh hlasovat, nic se nestane a vypadá to jako porouchaná hra.
if git diff --cached --name-only | grep -qE 'services/game/fond|routes/game-trade|public/compounder/game/game.js'; then
  if ! node nastroje/tprahy.js; then
    echo ""
    echo "STOP: prahy hlasování nesedí (viz výš)."
    exit 1
  fi
fi

# Průběžná dividenda členům fondu. Teče z téže pokladny jako akcionářská
# a dělí se podle vkladů — chyba v dělení vezme jednomu členovi a dá druhému.
if git diff --cached --name-only | grep -qE 'services/game/fond|services/game/akcie|routes/game-trade'; then
  if ! node nastroje/tdividendaclen.js; then
    echo ""
    echo "STOP: dividenda členům nesedí (viz výš)."
    exit 1
  fi
fi

# Dividenda z akcií, která nabíhá. Teče z ní pokladna fondu akcionářům,
# takže chyba tu bere peníze jedním a dává druhým, aniž by si toho někdo všiml.
if git diff --cached --name-only | grep -qE 'services/game/akcie|services/game/fond|routes/game-trade'; then
  if ! node nastroje/tdividendanabeh.js; then
    echo ""
    echo "STOP: nabíhající dividenda nesedí (viz výš)."
    exit 1
  fi
fi

# Přecenění akcie podle hodnoty fondu. Sáhá na cenu, za kterou hráči kupují,
# a to bez jejich přičinění — chyba tu hráče okrade, aniž by něco udělal.
if git diff --cached --name-only | grep -qE 'services/game/akcie|services/game/fond-historie|routes/game-trade'; then
  if ! node nastroje/tprecena.js; then
    echo ""
    echo "STOP: přecenění akcií nesedí (viz výš)."
    exit 1
  fi
fi

# Burza akcií: graf, šipka u ceny a návrat ze seznamu. Hráč se podle grafu
# rozhoduje o skutečných penězích — rovná čára u ceny, která se hejbe, je
# lž, a šipka bez obchodu by dělala z prvního dne propad.
if git diff --cached --name-only | grep -qE 'public/compounder/game/game.js|public/compounder/game/index.html|routes/game-trade'; then
  if ! node nastroje/takcieburza.js; then
    echo ""
    echo "STOP: burza akcií nesedí (viz výš)."
    exit 1
  fi
fi

# Akcie fondu: kolik fondu se vydáním prodá a jak se páruje pořadník nabídek.
# Obojí je o skutečných penězích hráčů — chyba ve vydání okrade členy o díl,
# chyba v párování toho, kdo v knize čekal.
if git diff --cached --name-only | grep -qE 'services/game/akcie|services/game/rezervace|routes/game-trade'; then
  if ! node nastroje/takcie.js; then
    echo ""
    echo "STOP: akcie fondu nesedí (viz výš)."
    exit 1
  fi
fi

# Co hráč vlastní mimo svou firmu: fond a podíly v karte majetku. Nejzrádnější
# je znaménko — co z MÉ firmy drží jiní, se musí odečíst, ne přičíst.
if git diff --cached --name-only | grep -qE 'public/compounder/game/game.js|routes/game-account'; then
  if ! node nastroje/tmujmajetek.js; then
    echo ""
    echo "STOP: karta majetku nesedí (viz výš)."
    exit 1
  fi
fi

# Výnos a návratnost drženého podílu. Samotná částka měsíčně neřekne nic;
# teprve podíl k zaplacené ceně srovná nákupy mezi sebou.
if git diff --cached --name-only | grep -qE 'public/compounder/game/game.js'; then
  if ! node nastroje/tfondvynos.js; then
    echo ""
    echo "STOP: výnos drženého podílu nesedí (viz výš)."
    exit 1
  fi
fi

# Křivka hodnoty fondu. Vzorkuje se po každém pohybu penězi — bez toho se
# člen po nákupu za desítky milionů dívá na rovnou čáru až hodinu.
if git diff --cached --name-only | grep -qE 'services/game/fond-historie|routes/game-trade'; then
  if ! node nastroje/tfondkrivka.js; then
    echo ""
    echo "STOP: křivka hodnoty fondu nesedí (viz výš)."
    exit 1
  fi
fi

# Prodej majitele do veřejné nabídky na vlastní firmu. Majitel nemá v evidenci
# řádek a dřív proto prodat nemohl vůbec. Chyba tady buď prodej zablokuje,
# nebo pustí majitele pod sto procent firmy.
if git diff --cached --name-only | grep -qE 'services/game/prevzeti|routes/game-trade|public/compounder/game/game.js'; then
  if ! node nastroje/tprodejmajitele.js; then
    echo ""
    echo "STOP: prodej majitele do nabídky nesedí (viz výš)."
    exit 1
  fi
fi

# Co schválenému návrhu fondu chybí, aby šel provést. Měří se proti volným
# penězům, ne proti pokladně — proti pokladně se návrh dostal na hlasování
# a po dni hlasování spadl na to, že fond nemá.
if git diff --cached --name-only | grep -qE 'public/compounder/game/game.js|routes/game-trade'; then
  if ! node nastroje/tfondkarta.js; then
    echo ""
    echo "STOP: karta návrhu fondu nesedí (viz výš)."
    exit 1
  fi
fi

# Náprava po odebraném stroji: sundání náhrobku u jednoho hráče a výběr míst
# k úklidu duchů. Obojí sahá na cizí majetek — chyba tady smaže stroj, který
# hráči doopravdy chybí, nebo mu vrátí ten, co mu vzal soud.
if git diff --cached --name-only | grep -qE 'services/game/nahrobek|services/game/srovnani|routes/game-admin'; then
  if ! node nastroje/tnahrobek.js; then
    echo ""
    echo "STOP: náprava po odebraném stroji nesedí (viz výš)."
    exit 1
  fi
fi

# Stavba na místě, kde zábor už leží, a náhrobek po odebraném stroji. Obojí
# bralo hráči zaplacený prádlomat: jednou se nedalo postavit na vlastní ploše,
# podruhé stroj po stavbě zmizel z mapy a nevrátil se ani na sklad.
if git diff --cached --name-only | grep -qE 'public/compounder/game/game.js'; then
  if ! node nastroje/tstavba.js; then
    echo ""
    echo "STOP: stavba na vlastním místě nesedí (viz výš)."
    exit 1
  fi
fi

# Předplatné na techniky: co se účtuje a co hráč dostane. Jsou to skutečné
# peníze — chyba tady buď okrade hráče, nebo dá obejít placení.
if git diff --cached --name-only | grep -qE 'services/game/predplatne|routes/game-stripe|routes/game-account'; then
  if ! node nastroje/tpredplatne.js; then
    echo ""
    echo "STOP: počty u předplatného nesedí (viz výš)."
    exit 1
  fi
fi

# Nabídka podílu fondu zvenču. Jediné místo, kde do fondu vstupuje člověk,
# který v něm není — a platí se tu cizími penězi.
if git diff --cached --name-only | grep -qE 'services/game/fond-nabidka|routes/game-trade'; then
  if ! node nastroje/tfondnabidka.js; then
    echo ""
    echo "STOP: nabídka podílu fondu nesedí (viz výš)."
    exit 1
  fi
fi

# Jmění podle skutečného vlastnictví. Když se tentýž podíl spočte majiteli
# i držiteli, je hra bohatší, než je — a když ani jednomu, peníze zmizí.
if git diff --cached --name-only | grep -qE 'services/game/vlastnictvi|services/game/jmeni|routes/game-account'; then
  if ! node nastroje/tvlastnictvi.js; then
    echo ""
    echo "STOP: jmění podle vlastnictví nesedí (viz výš)."
    exit 1
  fi
fi

# Verze uloženého stavu. Je to jediná zábrana proti tomu, aby druhá
# rozehraná hra přepsala novější stav — když povolí, mizí hráčům peníze.
if git diff --cached --name-only | grep -qE 'services/game/stav-verze|routes/game-account'; then
  if ! node nastroje/trevverze.js; then
    echo ""
    echo "STOP: hlídání verze stavu nesedí (viz výš)."
    exit 1
  fi
fi

# Které měřítko škody platí u soudu. Počítá se z toho trest v desítkách
# milionů — chyba tady není překlep, je to cizí majetek.
if git diff --cached --name-only | grep -qE 'services/game/zlocin\.js'; then
  if ! node nastroje/tzlocinmeritko.js; then
    echo ""
    echo "STOP: měřítko škody nesedí (viz výš)."
    exit 1
  fi
fi

# Škoda u běžícího případu. Počítá se z ní trest, takže chyba tady je buď
# trest z čísla starého týden, nebo naopak zmrazení, na které hráč nemá.
if git diff --cached --name-only | grep -qE 'services/game/zlocin-rizeni'; then
  if ! node nastroje/tzlocinskoda.js; then
    echo ""
    echo "STOP: přeměření škody nesedí (viz výš)."
    exit 1
  fi
fi

# Vzorky hodnoty fondu. Když se píšou moc často, je z křivky šum a tabulka
# roste zbytečně; když se nepíšou vůbec, graf tiše zmizí a vypadá to jako
# „zatím nic".
if git diff --cached --name-only | grep -qE 'services/game/fond-historie'; then
  if ! node nastroje/tfondhistorie.js; then
    echo ""
    echo "STOP: vzorkování hodnoty fondu nesedí (viz výš)."
    exit 1
  fi
fi

# Ukončení hry a úklid podílů. Podíl může držet i fond — a fond nemá zvonek,
# takže se mu peníze musí připsat do pokladny. Doručenka na prázdné id shodí
# vyrovnání celé firmy a nikdo se to z provozu nedozví.
if git diff --cached --name-only | grep -qE 'services/game/konec'; then
  if ! node nastroje/tkonecfond.js; then
    echo ""
    echo "STOP: vyrovnání podílů s fondem nesedí (viz výš)."
    exit 1
  fi
fi

# Fond aliance. Počítají se v něm cizí peníze — kdo kolik vložil, co z toho
# dostane a co si odnese při odchodu. Chyba o korunu se z provozu nepozná.
if git diff --cached --name-only | grep -qE 'services/game/fond|routes/game-trade|prisma/schema.prisma'; then
  if ! node nastroje/tfond.js; then
    echo ""
    echo "STOP: výpočet fondu aliance nesedí (viz výš)."
    exit 1
  fi
  # Žebříček fondů je jediné místo, kde se o cizím fondu říká číslo veřejně.
  # Hráč si ho nemá jak přepočítat, takže chybu by nikdo neohlásil.
  if ! node nastroje/tfondzeb.js; then
    echo ""
    echo "STOP: žebříček fondů nesedí (viz výš)."
    exit 1
  fi
fi

# Investiční aliance. Posouvá práva z člověka na blok — chyba tady znamená
# moc nad cizí firmou, na kterou ten blok nemá, nebo ztrátu práva, které má.
if git diff --cached --name-only | grep -qE 'services/game/(aliance|prava)'; then
  if ! node nastroje/taliance.js; then
    echo ""
    echo "STOP: investiční aliance nesedí (viz výš)."
    exit 1
  fi
fi

# Co smí podílník podle velikosti podílu. Posunutý práh o setinu znamená
# moc nad cizí firmou, na kterou ten člověk nemá.
if git diff --cached --name-only | grep -qE 'services/game/prava'; then
  if ! node nastroje/tprava.js; then
    echo ""
    echo "STOP: práva podílníků nesedí (viz výš)."
    exit 1
  fi
fi

# Dividendová politika. Rozhoduje, kolik peněz měsíčně odejde z firmy —
# a jestli se ztráta krátí stejně jako zisk, což by byl úhyb většinového
# podílníka na majitele.
if git diff --cached --name-only | grep -qE 'services/game/(dividenda|finance|prava)'; then
  if ! node nastroje/tdividenda.js; then
    echo ""
    echo "STOP: dividendová politika nesedí (viz výš)."
    exit 1
  fi
fi

# Veřejná nabídka na odkup. Jde o cizí firmu a cizí peníze; jedna špatně
# spočítaná cena za procento znamená prodanou půlku firmy za cenu oběda.
if git diff --cached --name-only | grep -qE 'services/game/prevzeti'; then
  if ! node nastroje/tprevzeti.js; then
    echo ""
    echo "STOP: veřejná nabídka na odkup nesedí (viz výš)."
    exit 1
  fi
fi

# Ředění podílů. Podíl rozhoduje o tom, komu kolik teče ze zisku — chyba tady
# není chyba v zobrazení, ale krádež na splátky. Commit zastaví.
if git diff --cached --name-only | grep -qE 'services/game/podily'; then
  if ! node nastroje/tpodily.js; then
    echo ""
    echo "STOP: ředění podílů nesedí (viz výš)."
    exit 1
  fi
fi

# Firmy v nouzi. Rozhoduje to o tom, čí jméno se objeví ostatním na nástěnce.
if git diff --cached --name-only | grep -qE 'services/game/krize'; then
  if ! node nastroje/tkrize.js; then
    echo ""
    echo "STOP: určení firem v nouzi nesedí (viz výš)."
    exit 1
  fi
fi

# Čisté jmění a hodnosti. Rozhodují o žebříčku i o odměnách, které se za
# hodnosti vyplácejí v herních penězích a kartách. Commit zastaví.
if git diff --cached --name-only | grep -qE 'services/game/(jmeni|hodnosti)'; then
  if ! node nastroje/tjmeni.js; then
    echo ""
    echo "STOP: serverové jmění nebo hodnosti nesedí (viz výš)."
    exit 1
  fi
fi

# Dopočet skladu. Sáhne na majetek všech hráčů najednou, takže nesmí nikomu
# nic ubrat a druhé spuštění nesmí nic přidat. Commit zastaví.
if git diff --cached --name-only | grep -qE 'services/game/sklad'; then
  if ! node nastroje/tsklad.js; then
    echo ""
    echo "STOP: dopočet skladu nesedí (viz výš)."
    exit 1
  fi
fi

# Cena pozemku. Server a hra ji počítají každý zvlášť a musí se trefit do
# stejného čísla — je to nemovitost, banka proti ní půjčuje. Commit zastaví.
if git diff --cached --name-only | grep -qE 'services/game/pozemky'; then
  if ! node nastroje/tpozemky.js; then
    echo ""
    echo "STOP: cena pozemku na serveru nesedí s hrou (viz výš)."
    exit 1
  fi
fi

# Mez přírůstku hotovosti. Je to první kámen serverového počítání peněz —
# až se z meze stane strop, rozhoduje o tom, jestli poctivému hráči půjde
# uložit hra. Commit zastaví.
if git diff --cached --name-only | grep -qE 'services/game/strop'; then
  if ! node nastroje/tstrop.js; then
    echo ""
    echo "STOP: mez přírůstku hotovosti nesedí (viz výš)."
    exit 1
  fi
fi

# Minimální dividenda. Stojí celá na jediné mezi: víc než svůj díl zisku
# firma nevyplatí nikdy. Bez ní by z dividendy byla exekuce na hotovost
# majitele. Commit zastaví.
if git diff --cached --name-only | grep -qE 'services/game/(dividenda|finance)'; then
  if ! node nastroje/tdividendamin.js; then
    echo ""
    echo "STOP: minimální dividenda nesedí (viz výš)."
    exit 1
  fi
fi

# Výplata podílu, který drží fond aliance. Fond nemá doručenky — peníze mu
# chodí do pokladny. Kdyby se mu poslala doručenka, nikdo by si ji
# nevyzvedl; kdyby se nepřipsalo nic, výplata by zmizela. Commit zastaví.
if git diff --cached --name-only | grep -qE 'services/game/(finance|dividenda|drzitel)'; then
  if ! node nastroje/tvyplatyfond.js; then
    echo ""
    echo "STOP: výplata podílu fondu nesedí (viz výš)."
    exit 1
  fi
fi

# Retence záloh databáze. Smazaná záloha se nevrací a chyba se pozná až
# ve chvíli, kdy ji někdo potřebuje. Commit zastaví.
if git diff --cached --name-only | grep -qE 'services/backup/db-backup'; then
  if ! node nastroje/tzalohy.js; then
    echo ""
    echo "STOP: retence záloh nesedí (viz výš)."
    exit 1
  fi
fi

# Kdo drží podíl. Od chvíle, kdy do firem investuje i fond aliance, můžou
# ve firmě sedět hráč i fond vedle sebe. Kdyby se někde sečetly podle
# investor_id, fondu by se podíl ztratil — a podíl rozhoduje o většině
# i o výplatách. Commit zastaví.
if git diff --cached --name-only | grep -qE 'services/game/(drzitel|podily|prava|prevzeti)'; then
  if ! node nastroje/tdrzitel.js; then
    echo ""
    echo "STOP: držitel podílu nesedí (viz výš)."
    exit 1
  fi
fi

# Rezervace peněz pod běžícími nabídkami. Bez ní jde vyhlásit tři nabídky
# z jedněch peněz a dvěma podílníkům pak říct, že se to nepovedlo. Commit
# zastaví.
if git diff --cached --name-only | grep -qE 'services/game/rezervace|routes/game-trade'; then
  if ! node nastroje/trezervace.js; then
    echo ""
    echo "STOP: rezervace peněz nesedí (viz výš)."
    exit 1
  fi
fi

# Výdaje, o kterých server ví ze svého: výměna stroje, poplatek za
# vyjednávání, odstupné a poplatek za změnu splatnosti. Musí sedět s cenami
# ve hře — rozejdou se tichounce a projeví se až jako nevysvětlený rozdíl
# v pokladně. Commit zastaví.
if git diff --cached --name-only | grep -qE 'services/game/(vydaje|pozemky|strop)'; then
  if ! node nastroje/tvydaje.js; then
    echo ""
    echo "STOP: výdaje nesedí (viz výš)."
    exit 1
  fi
fi

# Hlášení nákupu stroje. Když se ztratí, server o stroji neví: povinný sklad
# pak odmítne stavbu a v pokladně chybí největší výdaj ze všech. Fronta musí
# žít v ukládaném stavu a opakovat se se STEJNÝM klíčem. Commit zastaví.
if git diff --cached --name-only | grep -qE 'public/compounder/game/game.js|routes/game-account'; then
  if ! node nastroje/tnakup.js; then
    echo ""
    echo "STOP: hlášení nákupu nesedí (viz výš)."
    exit 1
  fi
fi

# Deterministické poruchy. Celé to stojí na tom, že hra i server počítají
# STEJNĚ — kdyby se rozešly, hra by ukazovala poruchu, o které server neví,
# a v pokladně by z toho byl nevysvětlený rozdíl. Commit zastaví.
if git diff --cached --name-only | grep -qE 'services/game/(poruchy|pozemky)|public/compounder/game/game.js'; then
  if ! node nastroje/tporuchydet.js; then
    echo ""
    echo "STOP: hra a server se neshodnou na poruchách (viz výš)."
    exit 1
  fi
fi

# Výpadek za poruchu. Jedna porucha umaže až půl herního roku tržby toho
# stroje, takže chyba ve výpočtu je rovnou v milionech. Konstanty navíc musí
# sedět s hrou — rozejdou se tiše. Commit zastaví.
if git diff --cached --name-only | grep -qE 'services/game/strop|public/compounder/game/game.js'; then
  if ! node nastroje/tporuchy.js; then
    echo ""
    echo "STOP: výpadek za poruchu nesedí (viz výš)."
    exit 1
  fi
fi

# Stínová pokladna. Dvě vlastnosti, na kterých stojí, se dají rozbít jedním
# řádkem: nesmí se srovnávat sama (to by zahodilo, co má měřit) a musí
# počítat od svého posledního kroku, ne od minulého uložení hry (jinak jí
# vynechané intervaly propadnou). Commit zastaví.
if git diff --cached --name-only | grep -qE 'services/game/(pokladna|strop)'; then
  if ! node nastroje/tpokladna.js; then
    echo ""
    echo "STOP: stínová pokladna nesedí (viz výš)."
    exit 1
  fi
fi

# Čekaná změna hotovosti: denní odměna (příjem) a opravy po poruše (výdaj).
# Obojí se pozná jen z rozdílu dvou uložení, takže se to snadno rozbije
# přejmenováním pole ve stavu hry. Odměna navíc musí počítat ze zisku, který
# si spočítal server — jinak by si šlo částku nafouknout. Commit zastaví.
if git diff --cached --name-only | grep -qE 'services/game/strop'; then
  if ! node nastroje/tcekana.js; then
    echo ""
    echo "STOP: denní odměna nebo opravy v čekané změně nesedí (viz výš)."
    exit 1
  fi
fi

# Co se prodává, musí jít vyzvednout. Zapomenutá rodina položek ve výčtu
# znamená zaplacenou kartu, o které se hra nikdy nedozví — stalo se to
# kampaním hned první den prodeje. Je to přímo o penězích, takže commit zastaví.
if git diff --cached --name-only | grep -qE 'routes/game-account'; then
  if ! node nastroje/tvlastni.js; then
    echo ""
    echo "STOP: něco, co jde koupit, se hráči nepočítá mezi nevyzvednuté (viz výš)."
    exit 1
  fi
fi

# Platby. Dvojí doručení webhooku nesmí nikdy připsat zboží dvakrát — tohle
# je přímo o penězích, takže commit zastaví.
if git diff --cached --name-only | grep -qE 'routes/game-stripe'; then
  if ! node nastroje/twebhook.js; then
    echo ""
    echo "STOP: webhook plateb nesedí (viz výš)."
    exit 1
  fi
fi

if [ "$STAV" -eq 1 ]; then
  if [ -n "$ANTHROPIC_API_KEY" ]; then
    echo ""
    echo "Dopřekládám, co přibylo..."
    if node nastroje/texty-prelozit.js; then
      git add services/game/texty/en.json services/game/texty/en.meta.json
      echo "Překlad přidán do commitu."
    else
      echo "Překlad se nepovedl — commit jde dál, hra zůstane česky."
    fi
  else
    echo ""
    echo "Něco je bez překladu, ale v prostředí není ANTHROPIC_API_KEY."
    echo "Commit jde dál. Až budeš mít klíč, spusť: npm run texty:prelozit"
  fi
fi

exit 0
