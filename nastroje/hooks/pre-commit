#!/bin/sh
# =============================================================================
# Před commitem: dopřeložit, co přibylo
# =============================================================================
# Tohle je to, co drží českou a anglickou verzi pohromadě. Při každém commitu
# se podívá, jestli v katalogu nepřibyl text bez překladu nebo jestli se
# některý český text nezměnil pod hotovým překladem. Když ano a je po ruce
# klíč k API, nechá to dopřeložit a přidá do stejného commitu.
#
# Commit nikdy nezastaví kvůli překladu — chybějící angličtina hráče nezabije,
# hra spadne zpátky do češtiny. Zastaví ho jediná věc: klíč použitý v kódu,
# ke kterému žádný text není. To by hráč viděl jako holý klíč v okně.

if [ -z "$(git diff --cached --name-only | grep -E 'public/compounder/game/game\.js|services/game/texty/|routes/game-')" ]; then
  exit 0
fi

node nastroje/texty-kontrola.js
STAV=$?

# Prohlídka hlídá to horší než chybějící překlad: že přeložené JE, ale špatně.
# Chybějící značka ubere z věty číslo, rozbitá stavba shodí celé okno, z korun
# se stanou herní peníze. Tohle commit zastaví — takhle to hráči nefunguje.
# Každý cizí jazyk v katalogu se prohlédne zvlášť.
for KATALOG in services/game/texty/*.json; do
  JAZYK=$(basename "$KATALOG" .json)
  case "$JAZYK" in cs|*.meta|linka.*|slovnik) continue ;; esac
  if ! node nastroje/texty-prohlidka.js "$JAZYK"; then
    echo ""
    echo "STOP: překlad do $JAZYK má tvrdé nálezy (viz výš)."
    echo "Chybějící překlad commit nezastaví, rozbitý ano — hra by se hráči"
    echo "rozsypala a vypadalo by to jako chyba hry, ne překladu."
    exit 1
  fi
done

if [ "$STAV" -eq 2 ]; then
  echo ""
  echo "STOP: v kódu je klíč, ke kterému v katalogu není žádný text."
  echo "Hráč by na tom místě viděl holý klíč. Doplň ho a zkus to znovu."
  exit 1
fi

# Měny ceníku. Když se sáhne na tabulku měn nebo na kurzy, musí pořád platit,
# že se nezaokrouhluje dolů, že značka stojí na správné straně čísla a že
# žádný jazyk neukazuje na měnu, za kterou Stripe nic nestrhne. Tohle commit
# zastaví — špatná měna v ceníku je horší než chybějící překlad.
if git diff --cached --name-only | grep -qE 'services/game/meny'; then
  if ! node nastroje/tmenypl.js; then
    echo ""
    echo "STOP: měny ceníku nesedí (viz výš)."
    exit 1
  fi
fi

# Překladač: záchranná síť na rozbité uvozovky v odpovědi od API. Když
# přestane fungovat, padá celá dávka kvůli jednomu znaku a nikdo si toho
# nevšimne, dokud nechybí čtyřicet textů.
if git diff --cached --name-only | grep -qE 'nastroje/texty-prelozit'; then
  if ! node nastroje/tprelozit.js; then
    echo ""
    echo "STOP: oprava uvozovek v překladači nesedí (viz výš)."
    exit 1
  fi
fi

# Kurzy měn. Jediné místo, kde se počítají skutečné peníze — rozbor spletený
# o řád znamená stonásobnou cenu a pozná se to až z výpisu.
if git diff --cached --name-only | grep -qE 'services/game/(kurzy|meny)'; then
  if ! node nastroje/tkurzy.js; then
    echo ""
    echo "STOP: kurzy měn nesedí (viz výš)."
    exit 1
  fi
fi

# Auditní zápis vlastnických změn. Je to jediná paměť na to, kdo kdy přišel
# o kus firmy — chyba se pozná až ve chvíli, kdy se někdo ptá a odpověď lže.
if git diff --cached --name-only | grep -qE 'services/game/audit'; then
  if ! node nastroje/taudit.js; then
    echo ""
    echo "STOP: auditní zápis nesedí (viz výš)."
    exit 1
  fi
fi

# Pověst z infolinky. Násobí tržbu celé sítě, takže je to poslední místo,
# kde by si šlo přilepšit přepsáním jednoho čísla v uložené hře.
if git diff --cached --name-only | grep -qE 'services/game/(povest|navstevnost)|services/game/texty/linka'; then
  if ! node nastroje/tpovest.js; then
    echo ""
    echo "STOP: počítání pověsti nesedí (viz výš)."
    exit 1
  fi
fi

# Souběh na burze. Dva lidé ve stejnou vteřinu, nebo dvojklik: bez zámku se
# jeden podíl převede dvěma lidem a cena vyplatí dvakrát. Test pouští
# skutečnou obsluhu proti podstrčené databázi a uspí první požadavek přesně
# mezi čtením a zápisem.
if git diff --cached --name-only | grep -qE 'services/game/(soubeh|audit|prevzeti)|routes/game-trade'; then
  if ! node nastroje/tsoubeh.js; then
    echo ""
    echo "STOP: zámky proti souběhu na burze nesedí (viz výš)."
    exit 1
  fi
fi

# Nouzová brzda na burzu. Brzda, která zastaví víc, než má, zamkne hráče
# uprostřed rozjednaného obchodu — a vypadá to jako rozbitá hra. Brzda, která
# zastaví míň, nechá otevřenou díru, kvůli které se tahala.
if git diff --cached --name-only | grep -qE 'services/game/brzda|routes/game-trade'; then
  if ! node nastroje/tbrzda.js; then
    echo ""
    echo "STOP: nouzová brzda na burzu nesedí (viz výš)."
    exit 1
  fi
fi

# Investiční aliance. Posouvá práva z člověka na blok — chyba tady znamená
# moc nad cizí firmou, na kterou ten blok nemá, nebo ztrátu práva, které má.
if git diff --cached --name-only | grep -qE 'services/game/(aliance|prava)'; then
  if ! node nastroje/taliance.js; then
    echo ""
    echo "STOP: investiční aliance nesedí (viz výš)."
    exit 1
  fi
fi

# Co smí podílník podle velikosti podílu. Posunutý práh o setinu znamená
# moc nad cizí firmou, na kterou ten člověk nemá.
if git diff --cached --name-only | grep -qE 'services/game/prava'; then
  if ! node nastroje/tprava.js; then
    echo ""
    echo "STOP: práva podílníků nesedí (viz výš)."
    exit 1
  fi
fi

# Dividendová politika. Rozhoduje, kolik peněz měsíčně odejde z firmy —
# a jestli se ztráta krátí stejně jako zisk, což by byl úhyb většinového
# podílníka na majitele.
if git diff --cached --name-only | grep -qE 'services/game/(dividenda|finance|prava)'; then
  if ! node nastroje/tdividenda.js; then
    echo ""
    echo "STOP: dividendová politika nesedí (viz výš)."
    exit 1
  fi
fi

# Veřejná nabídka na odkup. Jde o cizí firmu a cizí peníze; jedna špatně
# spočítaná cena za procento znamená prodanou půlku firmy za cenu oběda.
if git diff --cached --name-only | grep -qE 'services/game/prevzeti'; then
  if ! node nastroje/tprevzeti.js; then
    echo ""
    echo "STOP: veřejná nabídka na odkup nesedí (viz výš)."
    exit 1
  fi
fi

# Ředění podílů. Podíl rozhoduje o tom, komu kolik teče ze zisku — chyba tady
# není chyba v zobrazení, ale krádež na splátky. Commit zastaví.
if git diff --cached --name-only | grep -qE 'services/game/podily'; then
  if ! node nastroje/tpodily.js; then
    echo ""
    echo "STOP: ředění podílů nesedí (viz výš)."
    exit 1
  fi
fi

# Firmy v nouzi. Rozhoduje to o tom, čí jméno se objeví ostatním na nástěnce.
if git diff --cached --name-only | grep -qE 'services/game/krize'; then
  if ! node nastroje/tkrize.js; then
    echo ""
    echo "STOP: určení firem v nouzi nesedí (viz výš)."
    exit 1
  fi
fi

# Čisté jmění a hodnosti. Rozhodují o žebříčku i o odměnách, které se za
# hodnosti vyplácejí v herních penězích a kartách. Commit zastaví.
if git diff --cached --name-only | grep -qE 'services/game/(jmeni|hodnosti)'; then
  if ! node nastroje/tjmeni.js; then
    echo ""
    echo "STOP: serverové jmění nebo hodnosti nesedí (viz výš)."
    exit 1
  fi
fi

# Dopočet skladu. Sáhne na majetek všech hráčů najednou, takže nesmí nikomu
# nic ubrat a druhé spuštění nesmí nic přidat. Commit zastaví.
if git diff --cached --name-only | grep -qE 'services/game/sklad'; then
  if ! node nastroje/tsklad.js; then
    echo ""
    echo "STOP: dopočet skladu nesedí (viz výš)."
    exit 1
  fi
fi

# Cena pozemku. Server a hra ji počítají každý zvlášť a musí se trefit do
# stejného čísla — je to nemovitost, banka proti ní půjčuje. Commit zastaví.
if git diff --cached --name-only | grep -qE 'services/game/pozemky'; then
  if ! node nastroje/tpozemky.js; then
    echo ""
    echo "STOP: cena pozemku na serveru nesedí s hrou (viz výš)."
    exit 1
  fi
fi

# Mez přírůstku hotovosti. Je to první kámen serverového počítání peněz —
# až se z meze stane strop, rozhoduje o tom, jestli poctivému hráči půjde
# uložit hra. Commit zastaví.
if git diff --cached --name-only | grep -qE 'services/game/strop'; then
  if ! node nastroje/tstrop.js; then
    echo ""
    echo "STOP: mez přírůstku hotovosti nesedí (viz výš)."
    exit 1
  fi
fi

# Co se prodává, musí jít vyzvednout. Zapomenutá rodina položek ve výčtu
# znamená zaplacenou kartu, o které se hra nikdy nedozví — stalo se to
# kampaním hned první den prodeje. Je to přímo o penězích, takže commit zastaví.
if git diff --cached --name-only | grep -qE 'routes/game-account'; then
  if ! node nastroje/tvlastni.js; then
    echo ""
    echo "STOP: něco, co jde koupit, se hráči nepočítá mezi nevyzvednuté (viz výš)."
    exit 1
  fi
fi

# Platby. Dvojí doručení webhooku nesmí nikdy připsat zboží dvakrát — tohle
# je přímo o penězích, takže commit zastaví.
if git diff --cached --name-only | grep -qE 'routes/game-stripe'; then
  if ! node nastroje/twebhook.js; then
    echo ""
    echo "STOP: webhook plateb nesedí (viz výš)."
    exit 1
  fi
fi

if [ "$STAV" -eq 1 ]; then
  if [ -n "$ANTHROPIC_API_KEY" ]; then
    echo ""
    echo "Dopřekládám, co přibylo..."
    if node nastroje/texty-prelozit.js; then
      git add services/game/texty/en.json services/game/texty/en.meta.json
      echo "Překlad přidán do commitu."
    else
      echo "Překlad se nepovedl — commit jde dál, hra zůstane česky."
    fi
  else
    echo ""
    echo "Něco je bez překladu, ale v prostředí není ANTHROPIC_API_KEY."
    echo "Commit jde dál. Až budeš mít klíč, spusť: npm run texty:prelozit"
  fi
fi

exit 0
