        </w:numPr>
        <w:spacing w:after="100" w:line="276"/>
      </w:pPr>
      <w:r>
        <w:t xml:space="preserve">Předmětem této smlouvy je závazek prodávajícího odevzdat kupujícímu níže specifikované zařízení („</w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:b/>
          <w:bCs/>
        </w:rPr>
        <w:t xml:space="preserve">kiosek</w:t>
      </w:r>
      <w:r>
        <w:t xml:space="preserve">&#x201C;) a umožnit mu nabýt vlastnické právo k němu, a závazek kupujícího kiosek převzít a zaplatit prodávajícímu kupní cenu.</w:t>
      </w:r>
    </w:p>
    <w:p>
