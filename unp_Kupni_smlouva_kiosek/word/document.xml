      </w:r>
      <w:r>
        <w:rPr>
          <w:highlight w:val="yellow"/>
          
        </w:rPr>
        <w:t xml:space="preserve">[%]</w:t>
      </w:r>
      <w:r>
        <w:t xml:space="preserve"> na základě zálohové faktury se splatností </w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:highlight w:val="yellow"/>
          
        </w:rPr>
        <w:t xml:space="preserve">[X]</w:t>
      </w:r>
      <w:r>
        <w:t xml:space="preserve"> dní,</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="ListParagraph"/>
        <w:numPr>
          <w:ilvl w:val="0"/>
          <w:numId w:val="5"/>
        </w:numPr>
        <w:spacing w:after="60" w:line="276"/>
      </w:pPr>
      <w:r>
        <w:t xml:space="preserve">doplatek do </w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:highlight w:val="yellow"/>
          
        </w:rPr>
        <w:t xml:space="preserve">[X]</w:t>
      </w:r>
      <w:r>
        <w:t xml:space="preserve"> dní od </w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:highlight w:val="yellow"/>
          
        </w:rPr>
        <w:t xml:space="preserve">[předání / vystavení faktury]</w:t>
      </w:r>
      <w:r>
        <w:t xml:space="preserve">.</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="ListParagraph"/>
        <w:numPr>
          <w:ilvl w:val="0"/>
          <w:numId w:val="4"/>
        </w:numPr>
        <w:spacing w:after="100" w:line="276"/>
      </w:pPr>
      <w:r>
        <w:t xml:space="preserve">Kupní cena se hradí bezhotovostně na účet prodávajícího uvedený v záhlaví, případně na účet uvedený na faktuře. Cena je uhrazena dnem připsání na účet prodávajícího.</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="ListParagraph"/>
        <w:numPr>
          <w:ilvl w:val="0"/>
          <w:numId w:val="4"/>
        </w:numPr>
        <w:spacing w:after="100" w:line="276"/>
      </w:pPr>
      <w:r>
        <w:t xml:space="preserve">V případě prodlení kupujícího s úhradou je prodávající oprávněn požadovat úrok z prodlení ve výši </w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:highlight w:val="yellow"/>
          
        </w:rPr>
        <w:t xml:space="preserve">[0,05 % z dlužné částky za každý den prodlení]</w:t>
      </w:r>
      <w:r>
        <w:t xml:space="preserve">.</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="ListParagraph"/>
        <w:numPr>
          <w:ilvl w:val="0"/>
          <w:numId w:val="4"/>
        </w:numPr>
        <w:spacing w:after="100" w:line="276"/>
      </w:pPr>
      <w:r>
        <w:t xml:space="preserve">Prodávající vystaví daňový doklad (fakturu) se všemi náležitostmi dle zákona o DPH.</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="Heading1"/>
        <w:jc w:val="center"/>
      </w:pPr>
      <w:r>
        <w:t xml:space="preserve">Článek III – Předání a převzetí</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="ListParagraph"/>
        <w:numPr>
          <w:ilvl w:val="0"/>
          <w:numId w:val="6"/>
        </w:numPr>
        <w:spacing w:after="100" w:line="276"/>
      </w:pPr>
      <w:r>
        <w:t xml:space="preserve">Prodávající předá kiosek kupujícímu v místě: </w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:highlight w:val="yellow"/>
          
        </w:rPr>
        <w:t xml:space="preserve">[místo předání]</w:t>
      </w:r>
      <w:r>
        <w:t xml:space="preserve">, v termínu do </w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:highlight w:val="yellow"/>
          
        </w:rPr>
        <w:t xml:space="preserve">[datum / lhůta]</w:t>
      </w:r>
      <w:r>
        <w:t xml:space="preserve">.</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="ListParagraph"/>
        <w:numPr>
          <w:ilvl w:val="0"/>
          <w:numId w:val="6"/>
        </w:numPr>
        <w:spacing w:after="100" w:line="276"/>
      </w:pPr>
      <w:r>
        <w:t xml:space="preserve">O předání a převzetí kiosku bude sepsán předávací protokol podepsaný oběma stranami, v němž bude uveden stav kiosku, předané příslušenství a dokumentace, případně zjištěné vady.</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="ListParagraph"/>
        <w:numPr>
          <w:ilvl w:val="0"/>
          <w:numId w:val="6"/>
        </w:numPr>
        <w:spacing w:after="100" w:line="276"/>
      </w:pPr>
      <w:r>
        <w:t xml:space="preserve">Nebezpečí škody na kiosku přechází na kupujícího okamžikem jeho převzetí, resp. okamžikem, kdy byl kupující v prodlení s převzetím.</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="ListParagraph"/>
        <w:numPr>
          <w:ilvl w:val="0"/>
          <w:numId w:val="6"/>
        </w:numPr>
        <w:spacing w:after="100" w:line="276"/>
      </w:pPr>
      <w:r>
        <w:t xml:space="preserve">Vlastnické právo ke kiosku přechází na kupujícího </w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:highlight w:val="yellow"/>
          
        </w:rPr>
        <w:t xml:space="preserve">[úplným zaplacením kupní ceny / okamžikem předání – zvolit]</w:t>
      </w:r>
      <w:r>
        <w:t xml:space="preserve">.</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="Heading1"/>
        <w:jc w:val="center"/>
      </w:pPr>
      <w:r>
        <w:t xml:space="preserve">Článek IV – Záruka a odpovědnost za vady</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="ListParagraph"/>
        <w:numPr>
          <w:ilvl w:val="0"/>
          <w:numId w:val="7"/>
        </w:numPr>
        <w:spacing w:after="100" w:line="276"/>
      </w:pPr>
      <w:r>
        <w:t xml:space="preserve">Prodávající poskytuje na kiosek záruku za jakost v délce </w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:highlight w:val="yellow"/>
          
        </w:rPr>
        <w:t xml:space="preserve">[24]</w:t>
      </w:r>
      <w:r>
        <w:t xml:space="preserve"> měsíců ode dne předání kiosku kupujícímu.</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="ListParagraph"/>
        <w:numPr>
          <w:ilvl w:val="0"/>
          <w:numId w:val="7"/>
        </w:numPr>
        <w:spacing w:after="100" w:line="276"/>
      </w:pPr>
      <w:r>
        <w:t xml:space="preserve">Záruka se nevztahuje na vady způsobené neodborným zásahem, nesprávnou obsluhou, běžným opotřebením, zásahem třetí osoby nebo vyšší mocí.</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="ListParagraph"/>
        <w:numPr>
          <w:ilvl w:val="0"/>
          <w:numId w:val="7"/>
        </w:numPr>
        <w:spacing w:after="100" w:line="276"/>
      </w:pPr>
      <w:r>
        <w:t xml:space="preserve">Kupující je povinen vady bez zbytečného odkladu po jejich zjištění písemně oznámit prodávajícímu (reklamovat) na adresu </w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:highlight w:val="yellow"/>
          
        </w:rPr>
        <w:t xml:space="preserve">[kontakt pro reklamace]</w:t>
      </w:r>
      <w:r>
        <w:t xml:space="preserve">.</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="ListParagraph"/>
        <w:numPr>
          <w:ilvl w:val="0"/>
          <w:numId w:val="7"/>
        </w:numPr>
        <w:spacing w:after="100" w:line="276"/>
      </w:pPr>
      <w:r>
        <w:t xml:space="preserve">Způsob a lhůty vyřízení reklamací se řídí občanským zákoníkem; případná návaznost na servisní zajištění je upravena samostatnou servisní smlouvou.</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="Heading1"/>
        <w:jc w:val="center"/>
      </w:pPr>
      <w:r>
        <w:t xml:space="preserve">Článek V – Závěrečná ustanovení</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="ListParagraph"/>
        <w:numPr>
          <w:ilvl w:val="0"/>
          <w:numId w:val="2"/>
        </w:numPr>
        <w:spacing w:after="100" w:line="276"/>
      </w:pPr>
      <w:r>
        <w:t xml:space="preserve">Tato smlouva nabývá platnosti a účinnosti dnem podpisu oběma smluvními stranami.</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="ListParagraph"/>
        <w:numPr>
          <w:ilvl w:val="0"/>
          <w:numId w:val="2"/>
        </w:numPr>
        <w:spacing w:after="100" w:line="276"/>
      </w:pPr>
      <w:r>
        <w:t xml:space="preserve">Vztahy touto smlouvou výslovně neupravené se řídí občanským zákoníkem a dalšími právními předpisy České republiky.</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="ListParagraph"/>
        <w:numPr>
          <w:ilvl w:val="0"/>
          <w:numId w:val="2"/>
        </w:numPr>
        <w:spacing w:after="100" w:line="276"/>
      </w:pPr>
      <w:r>
        <w:t xml:space="preserve">Smlouvu lze měnit pouze písemnými, vzestupně číslovanými dodatky podepsanými oběma stranami.</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="ListParagraph"/>
        <w:numPr>
          <w:ilvl w:val="0"/>
          <w:numId w:val="2"/>
        </w:numPr>
        <w:spacing w:after="100" w:line="276"/>
      </w:pPr>
      <w:r>
        <w:t xml:space="preserve">Je-li nebo stane-li se některé ustanovení smlouvy neplatným či neúčinným, nemá to vliv na platnost ostatních ustanovení; strany takové ustanovení nahradí ustanovením obsahově nejbližším.</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="ListParagraph"/>
        <w:numPr>
          <w:ilvl w:val="0"/>
          <w:numId w:val="2"/>
        </w:numPr>
        <w:spacing w:after="100" w:line="276"/>
      </w:pPr>
      <w:r>
        <w:t xml:space="preserve">Smlouva je vyhotovena ve dvou stejnopisech s platností originálu, po jednom pro každou smluvní stranu (nebo elektronicky s uznávanými podpisy).</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="ListParagraph"/>
        <w:numPr>
          <w:ilvl w:val="0"/>
          <w:numId w:val="2"/>
        </w:numPr>
        <w:spacing w:after="100" w:line="276"/>
      </w:pPr>
      <w:r>
        <w:t xml:space="preserve">Smluvní strany prohlašují, že si smlouvu přečetly, jejímu obsahu rozumějí a uzavírají ji svobodně, vážně a bez tísně, na důkaz čehož připojují své podpisy.</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:spacing w:after="120" w:before="240"/>
      </w:pPr>
