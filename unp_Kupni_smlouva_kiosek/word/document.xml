        <w:rPr>
          <w:b/>
          <w:bCs/>
        </w:rPr>
        <w:t xml:space="preserve">Přílohy: </w:t>
      </w:r>
      <w:r>
        <w:t xml:space="preserve">č. 1 – Technická specifikace kiosku; </w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:highlight w:val="yellow"/>
          
        </w:rPr>
        <w:t xml:space="preserve">[další přílohy dle potřeby]</w:t>
      </w:r>
    </w:p>
