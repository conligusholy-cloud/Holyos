      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="ListParagraph"/>
        <w:numPr>
          <w:ilvl w:val="0"/>
          <w:numId w:val="2"/>
        </w:numPr>
        <w:spacing w:after="100" w:line="276"/>
      </w:pPr>
      <w:r>
        <w:t xml:space="preserve">Prodávající prohlašuje, že je výlučným vlastníkem kiosku, že kiosek není zatížen žádnými právy třetích osob a že jeho prodeji nebrání žádná právní ani faktická překážka.</w:t>
      </w:r>
    </w:p>
