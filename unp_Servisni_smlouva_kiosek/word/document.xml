    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="ListParagraph"/>
        <w:numPr>
          <w:ilvl w:val="0"/>
          <w:numId w:val="6"/>
        </w:numPr>
        <w:spacing w:after="100" w:line="276"/>
      </w:pPr>
      <w:r>
        <w:t xml:space="preserve">Objednatel je povinen řádně a včas hradit sjednanou odměnu.</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="ListParagraph"/>
        <w:numPr>
          <w:ilvl w:val="0"/>
          <w:numId w:val="6"/>
        </w:numPr>
        <w:spacing w:after="100" w:line="276"/>
      </w:pPr>
      <w:r>
        <w:t xml:space="preserve">Objednatel je povinen bez zbytečného odkladu oznamovat poskytovateli zjištěné závady a neprovádět na kiosku sám ani prostřednictvím třetích osob zásahy bez souhlasu poskytovatele.</w:t>
      </w:r>
