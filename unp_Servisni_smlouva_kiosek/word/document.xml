        <w:t xml:space="preserve">Objednatel zajistí </w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:highlight w:val="yellow"/>
          
        </w:rPr>
        <w:t xml:space="preserve">[přípojky energií, umístění, pojištění kiosku – dle dohody]</w:t>
      </w:r>
      <w:r>
        <w:t xml:space="preserve">.</w:t>
      </w:r>
