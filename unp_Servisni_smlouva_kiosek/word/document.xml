        <w:numPr>
          <w:ilvl w:val="0"/>
          <w:numId w:val="4"/>
        </w:numPr>
        <w:spacing w:after="100" w:line="276"/>
      </w:pPr>
      <w:r>
        <w:t xml:space="preserve">Smluvní strany budou zpracovávat osobní údaje v souladu s nařízením GDPR a příslušnými předpisy; v případě potřeby uzavřou samostatnou smlouvu o zpracování osobních údajů.</w:t>
      </w:r>
    </w:p>
    <w:p>
