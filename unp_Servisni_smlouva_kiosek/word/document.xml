        <w:t xml:space="preserve">[např. poskytovatel inkasuje tržby, sráží si 13 % odměnu a zbytek poukazuje objednateli / objednatel hradí odměnu samostatně – zvolit].</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="ListParagraph"/>
        <w:numPr>
          <w:ilvl w:val="0"/>
          <w:numId w:val="4"/>
        </w:numPr>
        <w:spacing w:after="100" w:line="276"/>
      </w:pPr>
      <w:r>
        <w:t xml:space="preserve">V odměně </w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:highlight w:val="yellow"/>
          
        </w:rPr>
        <w:t xml:space="preserve">[jsou / nejsou]</w:t>
      </w:r>
      <w:r>
        <w:t xml:space="preserve"> zahrnuty náklady na náhradní díly a spotřební materiál. Náklady, které nejsou zahrnuty, hradí </w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:highlight w:val="yellow"/>
          
        </w:rPr>
        <w:t xml:space="preserve">[objednatel]</w:t>
      </w:r>
      <w:r>
        <w:t xml:space="preserve"> samostatně proti doložení.</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="ListParagraph"/>
        <w:numPr>
          <w:ilvl w:val="0"/>
          <w:numId w:val="4"/>
        </w:numPr>
        <w:spacing w:after="100" w:line="276"/>
      </w:pPr>
      <w:r>
        <w:t xml:space="preserve">K odměně bude připočtena DPH v zákonné výši.</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="Heading1"/>
        <w:jc w:val="center"/>
      </w:pPr>
      <w:r>
        <w:t xml:space="preserve">Článek III – Práva a povinnosti poskytovatele</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="ListParagraph"/>
        <w:numPr>
          <w:ilvl w:val="0"/>
          <w:numId w:val="5"/>
        </w:numPr>
        <w:spacing w:after="100" w:line="276"/>
      </w:pPr>
      <w:r>
        <w:t xml:space="preserve">Poskytovatel se zavazuje zajišťovat provoz kiosku s odbornou péčí, v souladu s pokyny výrobce a platnými právními předpisy.</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="ListParagraph"/>
        <w:numPr>
          <w:ilvl w:val="0"/>
          <w:numId w:val="5"/>
        </w:numPr>
        <w:spacing w:after="100" w:line="276"/>
      </w:pPr>
      <w:r>
        <w:t xml:space="preserve">Poskytovatel zajistí reakci na nahlášenou závadu v reakční době </w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:highlight w:val="yellow"/>
          
        </w:rPr>
        <w:t xml:space="preserve">[X hodin / pracovních dní]</w:t>
      </w:r>
      <w:r>
        <w:t xml:space="preserve"> a její odstranění ve lhůtě </w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:highlight w:val="yellow"/>
          
        </w:rPr>
        <w:t xml:space="preserve">[Y]</w:t>
      </w:r>
      <w:r>
        <w:t xml:space="preserve">, nebrání-li tomu okolnosti nezávislé na jeho vůli.</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="ListParagraph"/>
        <w:numPr>
          <w:ilvl w:val="0"/>
          <w:numId w:val="5"/>
        </w:numPr>
        <w:spacing w:after="100" w:line="276"/>
      </w:pPr>
      <w:r>
        <w:t xml:space="preserve">Poskytovatel vede evidenci provedených zásahů a na vyžádání ji zpřístupní objednateli.</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="ListParagraph"/>
        <w:numPr>
          <w:ilvl w:val="0"/>
          <w:numId w:val="5"/>
        </w:numPr>
        <w:spacing w:after="100" w:line="276"/>
      </w:pPr>
      <w:r>
        <w:t xml:space="preserve">Poskytovatel je oprávněn zajišťovat plnění prostřednictvím poddodavatelů; za jejich činnost odpovídá jako za činnost vlastní.</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="Heading1"/>
        <w:jc w:val="center"/>
      </w:pPr>
      <w:r>
        <w:t xml:space="preserve">Článek IV – Práva a povinnosti objednatele</w:t>
