      <w:r>
        <w:rPr>
          <w:highlight w:val="yellow"/>
          
        </w:rPr>
        <w:t xml:space="preserve">[3]</w:t>
      </w:r>
      <w:r>
        <w:t xml:space="preserve"> měsíce, která počíná běžet prvním dnem měsíce následujícího po doručení výpovědi.</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="ListParagraph"/>
        <w:numPr>
          <w:ilvl w:val="0"/>
          <w:numId w:val="2"/>
        </w:numPr>
        <w:spacing w:after="100" w:line="276"/>
      </w:pPr>
      <w:r>
        <w:t xml:space="preserve">Kterákoli strana může od smlouvy odstoupit v případě podstatného porušení povinností druhou stranou, které nebylo odstraněno ani v dodatečné přiměřené lhůtě.</w:t>
      </w:r>
