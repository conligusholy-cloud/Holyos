      </w:pPr>
      <w:r>
        <w:t xml:space="preserve">Smluvní strany se zavazují zachovávat mlčenlivost o důvěrných informacích získaných v souvislosti s touto smlouvou, a to i po jejím ukončení.</w:t>
      </w:r>
