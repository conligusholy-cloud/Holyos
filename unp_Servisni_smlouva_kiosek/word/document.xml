        <w:spacing w:after="100" w:line="276"/>
      </w:pPr>
      <w:r>
        <w:t xml:space="preserve">Vztahy touto smlouvou neupravené se řídí občanským zákoníkem a dalšími právními předpisy České republiky.</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="ListParagraph"/>
        <w:numPr>
          <w:ilvl w:val="0"/>
          <w:numId w:val="5"/>
        </w:numPr>
        <w:spacing w:after="100" w:line="276"/>
      </w:pPr>
      <w:r>
        <w:t xml:space="preserve">Smlouvu lze měnit pouze písemnými, vzestupně číslovanými dodatky podepsanými oběma stranami.</w:t>
      </w:r>
