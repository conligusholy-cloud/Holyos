        <w:spacing w:after="100" w:line="276"/>
      </w:pPr>
      <w:r>
        <w:t xml:space="preserve">Objednatel je povinen poskytnout poskytovateli veškerou nezbytnou součinnost, zejména přístup ke kiosku, potřebné podklady a informace.</w:t>
