// =============================================================================
// VÝROBA — PRODUKTY & PRACOVIŠTĚ (nahrazuje Factorify)
// =============================================================================

model Product {
  id                   Int     @id @default(autoincrement())
  code                 String  @unique @db.VarChar(50) // BS-M-xxxx
  name                 String  @db.VarChar(255)
  type                 String  @default("product") @db.VarChar(50) // product, semi-product
  show_in_configurator Boolean @default(false) // zobrazit v konfigurátoru pro zákazníka a v prodejních objednávkách
  takt_time            Int? // linkový takt v minutách (max čas na operaci)
  factorify_id         Int? // původní ID z Factorify
  material_id          Int? // vazba na Material pokud existuje

  // Fotografie produktu — ukládáme do persistent volume na Railway (/app/data/product-images/<id>.<ext>).
  // image_path je název souboru relativně k adresáři product-images/.
  image_path String? @db.VarChar(255)

  // Plánovač — dávkové parametry
  min_batch_size      Int? // minimální velikost výrobní dávky (kvůli setupům, ekonomice)
  economic_batch_size Int? // EOQ — preferovaná velikost dávky
  batch_size_step     Int? // krok zvětšení dávky (např. 5 ks)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  operations      ProductOperation[]
  bom_usages      OperationMaterial[] // kde se tento produkt používá jako BOM položka
  config_groups   ProductConfigGroup[] // konfigurační skupiny (Rám, Barva, ...)
  pricelist_items SalesPricelistItem[] // položky v prodejním ceníku navázané na výrobek
  order_items     OrderItem[] // položky objednávek, které na tento výrobek odkazují (pro výrobu a výbavu)
  invoice_items   InvoiceItem[]        @relation("InvoiceItemProduct")

  // Plánovač
  bom_snapshots      BomSnapshot[]
  production_batches ProductionBatch[] @relation("BatchProduct")

  // Factorify referenční sestava zboží (poslední import) — read-only snapshot
  fy_bom ProductFyBom?

  @@index([factorify_id])
  @@map("products")
}

// Prodejní ceník — samostatné prodejní položky s cenami v Kč a EUR bez DPH.
// Volitelně lze položku propojit s Product (výrobkem). Vhodné pro výrobky,
// služby, příslušenství nebo zboží, které zatím nemá výrobní kus.
model SalesPricelistItem {
  id              Int      @id @default(autoincrement())
  name_cs         String   @db.VarChar(255) // název česky (povinný)
  name_en         String?  @db.VarChar(255) // název anglicky
  price_czk       Decimal? @db.Decimal(12, 2) // maloobchodní cena Kč bez DPH
  price_eur       Decimal? @db.Decimal(12, 2) // maloobchodní cena EUR bez DPH
  truck_price_czk Decimal? @db.Decimal(12, 2) // kamionová (velkoobchodní) cena Kč bez DPH
  truck_price_eur Decimal? @db.Decimal(12, 2) // kamionová cena EUR bez DPH
  product_id      Int? // volitelné propojení na Product (když prázdné, UI upozorní červeně)
  product         Product? @relation(fields: [product_id], references: [id], onDelete: SetNull)
  active          Boolean  @default(true) // aktivní / zrušená položka
  note            String?  @db.Text // interní poznámka

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([product_id])
  @@index([active])
  @@map("sales_pricelist_items")
}

// Hala (seskupení pracovišť)
model Hall {
  id         Int    @id @default(autoincrement())
  name       String @db.VarChar(255)
  color      String @default("#14b8a6") @db.VarChar(20) // barva pro rozlišení
  sort_order Int    @default(0) // pořadí zobrazení

  created_at DateTime @default(now())

  workstations Workstation[]

  @@map("halls")
}

model Workstation {
  id           Int     @id @default(autoincrement())
  name         String  @db.VarChar(255)
  code         String? @db.VarChar(50)
  factorify_id Int? // původní Stage ID z Factorify

  // Zařazení do haly
  hall_id Int?

  // Externí pracoviště (kooperace)
  is_external Boolean @default(false)

  // Rozměry pracoviště v metrech
  width_m  Decimal? @db.Decimal(8, 2) // šířka v m
  length_m Decimal? @db.Decimal(8, 2) // délka v m

  // Vstupní a výstupní sklad + pozice
  input_warehouse_id  Int?
  input_location_id   Int?
  output_warehouse_id Int?
  output_location_id  Int?

  // Plánovač — typ toku: 'batch' (klasický dávkový), 'pulse' (pulse line — výrobek stojí, lidi se hýbou).
  // Dnes vše batch; pulse připraveno pro budoucí evoluci hlavní montážní linky.
  flow_type String @default("batch") @db.VarChar(20)

  created_at DateTime @default(now())

  hall             Hall?               @relation(fields: [hall_id], references: [id], onDelete: SetNull)
  input_warehouse  Warehouse?          @relation("WorkstationInputWarehouse", fields: [input_warehouse_id], references: [id])
  input_location   WarehouseLocation?  @relation("WorkstationInputLocation", fields: [input_location_id], references: [id])
  output_warehouse Warehouse?          @relation("WorkstationOutputWarehouse", fields: [output_warehouse_id], references: [id])
  output_location  WarehouseLocation?  @relation("WorkstationOutputLocation", fields: [output_location_id], references: [id])
  operations       ProductOperation[]
  workers          WorkstationWorker[]
  production_slots ProductionSlot[]
  batch_operations BatchOperation[] // Plánovač — instance operací běžících na pracovišti

  @@index([hall_id])
  @@index([factorify_id])
  @@index([input_warehouse_id])
  @@index([input_location_id])
  @@index([output_warehouse_id])
  @@index([output_location_id])
  @@map("workstations")
}

// Vazební tabulka: pracovníci přiřazení k pracovišti
model WorkstationWorker {
  id             Int     @id @default(autoincrement())
  workstation_id Int
  person_id      Int
  role           String? @db.VarChar(100) // role na pracovišti (operátor, seřizovač, kontrolor...)
  is_primary     Boolean @default(false) // hlavní pracovník pracoviště

  created_at DateTime @default(now())

  workstation Workstation @relation(fields: [workstation_id], references: [id], onDelete: Cascade)
  person      Person      @relation(fields: [person_id], references: [id], onDelete: Cascade)

  @@unique([workstation_id, person_id])
  @@index([person_id])
  @@map("workstation_workers")
}

model ProductOperation {
  id               Int     @id @default(autoincrement())
  product_id       Int
  workstation_id   Int?
  step_number      Int // pořadí operace
  name             String  @db.VarChar(255)
  phase            String? @db.VarChar(255)
  duration         Int? // trvání v minutách
  duration_unit    String  @default("MINUTE") @db.VarChar(20) // MINUTE, SECOND, HOUR
  preparation_time Int     @default(0)
  workers_count    Int     @default(1) // počet pracovníků na operaci
  description      String? @db.Text // popis operace
  bom_count        Int? // počet BOM položek

  // Plánovač — původ a kalibrace časů
  from_factorify        Boolean   @default(false) // operace stažená z Factorify (možno přepsat ručně)
  last_calibrated_at    DateTime? // kdy naposledy ručně přepsán čas (override Factorify)
  last_calibrated_by_id Int?

  // Migrační okno — operace je jen staging area pro materiály z FY importu (ne reálná pracovní operace).
  // Plánovač, simulace, normy a Gantt by ji měli ignorovat. Tomáš materiály drag&dropem rozdělí
  // do správných operací a tuto operaci pak smaže.
  is_staging Boolean @default(false)

  product            Product                 @relation(fields: [product_id], references: [id], onDelete: Cascade)
  workstation        Workstation?            @relation(fields: [workstation_id], references: [id])
  materials          OperationMaterial[]
  config_option_ops  ConfigOptionOperation[] // volby, které ovlivňují tuto operaci
  last_calibrated_by Person?                 @relation("ProductOperationCalibrator", fields: [last_calibrated_by_id], references: [id])

  // Plánovač — požadované kompetence
  required_competencies OperationRequiredCompetency[]
  // Plánovač — BOM snapshot itemy, kde je tato operace zdrojem spotřeby materiálu
  bom_snapshot_items    BomSnapshotItem[]             @relation("BomSnapshotItemOperation")
  // Plánovač — instance operace pro výrobní dávky
  batch_operations      BatchOperation[]

  @@index([product_id])
  @@map("product_operations")
}

// Materiály spotřebované v operaci (BOM per operation)
model OperationMaterial {
  id           Int     @id @default(autoincrement())
  operation_id Int
  material_id  Int
  product_id   Int? // přímá vazba na Product (pokud je to výrobek/polotovar)
  quantity     Decimal @db.Decimal(10, 3) // spotřeba materiálu
  unit         String  @default("ks") @db.VarChar(20)

  operation ProductOperation @relation(fields: [operation_id], references: [id], onDelete: Cascade)
  material  Material         @relation(fields: [material_id], references: [id])
  product   Product?         @relation(fields: [product_id], references: [id])

  @@index([operation_id])
  @@index([material_id])
  @@index([product_id])
  @@map("operation_materials")
}

// =============================================================================
// VÝROBA — NÁŘEZOVÉ PLÁNY
// =============================================================================
// Nářezový plán = samostatná operace, do které vstupuje jeden materiál (např.
// deska) a jejímž provedením vznikne více výstupních dílů, které se přijmou na
// sklad. Na rozdíl od ProductOperation není vázaný na konkrétní výrobek a má
// definované VÝSTUPY (co se přijme), ne jen vstupy (co se spotřebuje).
// Vstupní i výstupní sklad jsou POVINNÉ — bez nich plán nelze uložit.
model CuttingPlan {
  id                  Int      @id @default(autoincrement())
  code                String?  @unique @db.VarChar(50) // volitelný interní kód plánu
  name                String   @db.VarChar(255) // název plánu, např. "Nářezový plán NA1612"
  input_material_id   Int // vstupní materiál (deska), který se nařezáním spotřebuje
  input_quantity      Decimal  @default(1) @db.Decimal(10, 3) // kolik vstupního materiálu spotřebuje jedno provedení
  input_warehouse_id  Int // sklad, ze kterého se vstupní materiál vydá (povinné)
  output_warehouse_id Int // sklad, na který se přijmou výstupní díly (povinné)
  note                String?  @db.Text
  created_by          Int?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  input_material   Material               @relation("CuttingPlanInput", fields: [input_material_id], references: [id])
  input_warehouse  Warehouse              @relation("CuttingPlanInputWarehouse", fields: [input_warehouse_id], references: [id])
  output_warehouse Warehouse              @relation("CuttingPlanOutputWarehouse", fields: [output_warehouse_id], references: [id])
  creator          Person?                @relation("CuttingPlanCreatedBy", fields: [created_by], references: [id])
  outputs          CuttingPlanOutput[]
  executions       CuttingPlanExecution[]

  @@index([input_material_id])
  @@index([input_warehouse_id])
  @@index([output_warehouse_id])
  @@map("cutting_plans")
}

// Výstupní díly nářezového plánu — co se po provedení přijme na sklad.
model CuttingPlanOutput {
  id          Int     @id @default(autoincrement())
  plan_id     Int
  material_id Int
  quantity    Decimal @db.Decimal(10, 3) // počet kusů dílu na jedno provedení plánu
  unit        String  @default("ks") @db.VarChar(20)

  plan     CuttingPlan @relation(fields: [plan_id], references: [id], onDelete: Cascade)
  material Material    @relation("CuttingPlanOutputMaterial", fields: [material_id], references: [id])

  @@index([plan_id])
  @@index([material_id])
  @@map("cutting_plan_outputs")
}

// Záznam o provedení nářezového plánu (audit) — každé provedení zaúčtuje
// skladové pohyby: výdej vstupního materiálu + příjem výstupních dílů.
model CuttingPlanExecution {
  id          Int      @id @default(autoincrement())
  plan_id     Int
  multiplier  Decimal  @default(1) @db.Decimal(10, 3) // kolikrát se plán provedl (násobí vstup i výstupy)
  executed_by Int?
  note        String?  @db.Text

  created_at DateTime @default(now())

  plan     CuttingPlan @relation(fields: [plan_id], references: [id], onDelete: Cascade)
  executor Person?     @relation("CuttingPlanExecutor", fields: [executed_by], references: [id])

  @@index([plan_id])
  @@map("cutting_plan_executions")
}

// =============================================================================
// VÝROBA — SIMULACE
// =============================================================================

model Simulation {
  id          String @id @default(uuid())
  name        String @db.VarChar(255)
  version     Int    @default(1)
  objects     Json // pole objektů (areály, stroje, atd.)
  connections Json? // pole propojení
  viewport    Json? // { zoom, panX, panY }

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("simulations")
}

// =============================================================================
// AI ASISTENTI & SKILLY
// =============================================================================

model Assistant {
  id            String  @id @default(uuid())
  name          String  @db.VarChar(255)
  slug          String  @unique @db.VarChar(100)
  role          String  @db.Text
  system_prompt String  @db.Text
  model         String  @default("claude-sonnet-4-6") @db.VarChar(100)
  avatar_url    String? @db.VarChar(255)
  is_active     Boolean @default(true)
  config        Json?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  skills        AssistantSkill[]
  conversations Conversation[]

  @@map("assistants")
}

model Skill {
  id             String  @id @default(uuid())
  name           String  @db.VarChar(255)
  slug           String  @unique @db.VarChar(100)
  description    String  @db.Text
  category       String  @db.VarChar(50) // system, hr, warehouse, production, tasks
  handler_type   String  @db.VarChar(50) // mcp_tool, api_call, db_query, external
  handler_config Json?
  input_schema   Json? // JSON Schema
  output_schema  Json? // JSON Schema
  requires_auth  Boolean @default(true)
  is_active      Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  assistants AssistantSkill[]
  executions SkillExecution[]

  @@map("skills")
}

model AssistantSkill {
  assistant_id    String
  skill_id        String
  priority        Int    @default(0)
  config_override Json?

  assistant Assistant @relation(fields: [assistant_id], references: [id], onDelete: Cascade)
  skill     Skill     @relation(fields: [skill_id], references: [id], onDelete: Cascade)

  @@id([assistant_id, skill_id])
  @@map("assistant_skills")
}

model Conversation {
  id           String  @id @default(uuid())
  user_id      Int
  assistant_id String
  title        String? @db.VarChar(255)
  context      Json? // { module, page, extra_data }

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  assistant Assistant @relation(fields: [assistant_id], references: [id])
  messages  Message[]

  @@index([user_id])
  @@index([assistant_id])
  @@map("conversations")
}

model Message {
  id              String @id @default(uuid())
  conversation_id String
  role            String @db.VarChar(20) // user, assistant, system
  content         String @db.Text
  skill_calls     Json? // [{ skill_id, input, output }]

  created_at DateTime @default(now())

  conversation Conversation     @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  executions   SkillExecution[]

  @@index([conversation_id])
  @@map("messages")
}

model SkillExecution {
  id          String @id @default(uuid())
  message_id  String
  skill_id    String
  input       Json?
  output      Json?
  status      String @db.VarChar(20) // success, error, timeout
  duration_ms Int?

  created_at DateTime @default(now())

  message Message @relation(fields: [message_id], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skill_id], references: [id])

  @@index([skill_id])
  @@index([created_at])
  @@map("skill_executions")
}

model DevAgent {
  id            String  @id @default(uuid())
  slug          String  @unique @db.VarChar(100)
  name          String  @db.VarChar(255)
  icon          String  @default("🤖") @db.VarChar(10)
  module        String? @db.VarChar(100) // mapování na modul (lide-hr, nakup-sklad, ...)
  context_file  String? @db.VarChar(255) // cesta ke kontextovému souboru (.claude/agents/*.md)
  system_prompt String  @db.Text // system prompt pro Claude
  model         String  @default("claude-sonnet-4-6") @db.VarChar(100)
  is_active     Boolean @default(true)
  color         String  @default("#8b5cf6") @db.VarChar(20)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("dev_agents")
}

// =============================================================================
// PRODUKTOVÝ KONFIGURÁTOR — variabilní výbava výrobků
// =============================================================================

// Konfigurační skupina (řádek na objednávkovém listu: Rám, Barva opláštění, Polepy, ...)
model ProductConfigGroup {
  id         Int     @id @default(autoincrement())
  product_id Int
  name       String  @db.VarChar(255) // např. "Rám", "Barva opláštění"
  code       String  @db.VarChar(100) // strojový kód: "ram", "barva_oplasteni"
  type       String  @default("single_select") @db.VarChar(50) // single_select, multi_select, boolean, text
  required   Boolean @default(false) // musí zákazník vybrat?
  sort_order Int     @default(0) // pořadí zobrazení

  product Product               @relation(fields: [product_id], references: [id], onDelete: Cascade)
  options ProductConfigOption[]

  @@unique([product_id, code])
  @@index([product_id])
  @@map("product_config_groups")
}

// Konfigurační volba (možnost v rámci skupiny: Fe natíraný, Nerez, ...)
model ProductConfigOption {
  id             Int     @id @default(autoincrement())
  group_id       Int
  name           String  @db.VarChar(255) // např. "Fe natíraný", "Nerez"
  code           String  @db.VarChar(100) // strojový kód: "fe_natirany", "nerez"
  price_modifier Decimal @default(0) @db.Decimal(10, 2) // příplatek/sleva k ceně
  is_default     Boolean @default(false) // výchozí volba
  sort_order     Int     @default(0)

  group             ProductConfigGroup      @relation(fields: [group_id], references: [id], onDelete: Cascade)
  bom_materials     ConfigOptionMaterial[] // materiály potřebné pro tuto volbu
  operation_effects ConfigOptionOperation[] // vliv na operace v pracovním postupu
  order_configs     OrderItemConfig[] // objednávky s touto volbou

  @@unique([group_id, code])
  @@index([group_id])
  @@map("product_config_options")
}

// Vazba volba → materiál (BOM): jaké materiály se přidají/nahradí při výběru volby
model ConfigOptionMaterial {
  id          Int     @id @default(autoincrement())
  option_id   Int
  material_id Int
  quantity    Decimal @db.Decimal(10, 3)
  unit        String  @default("ks") @db.VarChar(20)

  option   ProductConfigOption @relation(fields: [option_id], references: [id], onDelete: Cascade)
  material Material            @relation(fields: [material_id], references: [id])

  @@index([option_id])
  @@index([material_id])
  @@map("config_option_materials")
}

// Vazba volba → operace: jak volba ovlivní pracovní postup
model ConfigOptionOperation {
  id                Int     @id @default(autoincrement())
  option_id         Int
  operation_id      Int
  action            String  @db.VarChar(20) // "add" = přidej operaci, "skip" = přeskoč, "modify" = uprav
  modified_duration Int? // upravená doba trvání (minuty), pokud action = "modify"
  note              String? @db.VarChar(255) // poznámka pro výrobu

  option    ProductConfigOption @relation(fields: [option_id], references: [id], onDelete: Cascade)
  operation ProductOperation    @relation(fields: [operation_id], references: [id], onDelete: Cascade)

  @@index([option_id])
  @@index([operation_id])
  @@map("config_option_operations")
}

// Vybraná konfigurace na položce prodejní objednávky
model OrderItemConfig {
  id            Int     @id @default(autoincrement())
  order_item_id Int
  option_id     Int? // vybraná volba (pro single_select, multi_select, boolean)
  custom_value  String? @db.VarChar(500) // vlastní hodnota (pro type "text" nebo "jiná barva")

  order_item OrderItem            @relation(fields: [order_item_id], references: [id], onDelete: Cascade)
  option     ProductConfigOption? @relation(fields: [option_id], references: [id])

  @@index([order_item_id])
  @@index([option_id])
  @@map("order_item_configs")
}

// =============================================================================
// VÝROBNÍ SLOTY — časová okna výroby
// =============================================================================

// Výrobní slot = časové okno, do kterého se řadí zakázky
model ProductionSlot {
  id             Int      @id @default(autoincrement())
  name           String   @db.VarChar(255) // např. "Týden 16 — Linka A"
  workstation_id Int? // volitelná vazba na pracoviště
  start_date     DateTime @db.Date // začátek slotu
  end_date       DateTime @db.Date // konec slotu
  capacity_hours Decimal  @default(8) @db.Decimal(8, 2) // kapacita v hodinách za den
  status         String   @default("open") @db.VarChar(20) // open, full, blocked, closed
  color          String   @default("#3b82f6") @db.VarChar(20)
  note           String?  @db.Text

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  workstation Workstation?     @relation(fields: [workstation_id], references: [id], onDelete: SetNull)
  assignments SlotAssignment[]
  blocks      SlotBlock[]

  @@index([workstation_id])
  @@index([start_date])
  @@index([end_date])
  @@index([status])
  @@map("production_slots")
}

// Přiřazení objednávky/produktu do slotu
model SlotAssignment {
  id              Int     @id @default(autoincrement())
  slot_id         Int
  order_id        Int? // vazba na objednávku
  order_item_id   Int? // vazba na konkrétní položku objednávky
  batch_id        Int? // Plánovač — výrobní dávka, která tento slot pokrývá
  product_name    String  @db.VarChar(255) // název produktu (denormalizováno pro rychlý přehled)
  customer_name   String? @db.VarChar(255) // zákazník
  quantity        Decimal @default(1) @db.Decimal(10, 2)
  estimated_hours Decimal @default(0) @db.Decimal(8, 2) // odhadovaný čas výroby
  priority        Int     @default(0) // vyšší = důležitější
  status          String  @default("planned") @db.VarChar(20) // planned, in_progress, done
  note            String? @db.Text

  // Rezervace slotu na 3 dny (migrace 20260513120000_add_slot_reservation).
  reservation_status       String?   @db.VarChar(20)
  reserved_until           DateTime?
  reservation_confirmed_at DateTime?

  created_at DateTime @default(now())

  slot       ProductionSlot   @relation(fields: [slot_id], references: [id], onDelete: Cascade)
  order_item OrderItem?       @relation(fields: [order_item_id], references: [id], onDelete: SetNull)
  batch      ProductionBatch? @relation("SlotAssignmentBatch", fields: [batch_id], references: [id], onDelete: SetNull)

  @@index([slot_id])
  @@index([order_id])
  @@index([order_item_id])
  @@index([batch_id])
  @@index([status])
  @@index([reservation_status])
  @@index([reserved_until])
  @@map("slot_assignments")
}

// Blokace slotu — dovolená, údržba, nepracovní dny apod.
model SlotBlock {
  id         Int      @id @default(autoincrement())
  slot_id    Int
  start_date DateTime @db.Date
  end_date   DateTime @db.Date
  reason     String   @db.VarChar(255) // "Dovolená", "Údržba stroje", "Státní svátek"
  block_type String   @default("holiday") @db.VarChar(30) // holiday, maintenance, other

  created_at DateTime @default(now())

  slot ProductionSlot @relation(fields: [slot_id], references: [id], onDelete: Cascade)

  @@index([slot_id])
  @@index([start_date])
  @@map("slot_blocks")
}

// =============================================================================
// MESSAGING — user-to-user chat, skupinové kanály, thready u požadavků, AI účastník
// Oddělené od Conversation/Message (ty slouží pro AI asistenty se skill_calls)
// =============================================================================

model ChatChannel {
  id              String   @id @default(uuid())
  type            String   @db.VarChar(20) // direct | group | task | system
  name            String?  @db.VarChar(255) // null pro direct - renderuje se z protistrany
  topic           String?  @db.VarChar(500)
  admin_task_id   Int? // vazba na požadavek (pro type = 'task')
  created_by      Int?
  last_message_at DateTime @default(now())

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  creator  User?               @relation("ChatChannelCreator", fields: [created_by], references: [id], onDelete: SetNull)
  members  ChatChannelMember[]
  messages ChatMessage[]

  @@unique([type, admin_task_id]) // jeden task kanál = jeden požadavek
  @@index([type])
  @@index([last_message_at])
  @@index([admin_task_id])
  @@map("chat_channels")
}

model ChatChannelMember {
  id           Int       @id @default(autoincrement())
  channel_id   String
  user_id      Int
  role         String    @default("member") @db.VarChar(20) // member | admin
  joined_at    DateTime  @default(now())
  last_read_at DateTime? // null = nic nepřečteno
  muted        Boolean   @default(false)

  channel ChatChannel @relation(fields: [channel_id], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([channel_id, user_id])
  @@index([user_id])
  @@map("chat_channel_members")
}

model ChatMessage {
  id           String    @id @default(uuid())
  channel_id   String
  sender_id    Int? // null pro 'system' a 'ai' (odesílatel z back-endu)
  sender_type  String    @default("user") @db.VarChar(20) // user | system | ai
  sender_label String?   @db.VarChar(255) // přezdívka pro system/ai ("HolyOS", "Claude")
  content      String    @db.Text
  attachments  Json? // [{ kind, url, name }]
  edited_at    DateTime?
  deleted_at   DateTime?

  created_at DateTime @default(now())

  channel ChatChannel @relation(fields: [channel_id], references: [id], onDelete: Cascade)
  sender  User?       @relation("ChatMessageSender", fields: [sender_id], references: [id], onDelete: SetNull)

  @@index([channel_id, created_at])
  @@index([sender_id])
  @@map("chat_messages")
}

model Notification {
  id      String    @id @default(uuid())
  user_id Int
  type    String    @db.VarChar(50) // chat_message | task_status | task_deployed | mention | system
  title   String    @db.VarChar(255)
  body    String?   @db.Text
  link    String?   @db.VarChar(500) // URL nebo route
  meta    Json? // { channel_id, message_id, task_id, ... }
  read_at DateTime?

  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, read_at])
  @@index([created_at])
  @@map("notifications")
}

// =============================================================================
// VOZOVÝ PARK — VEHICLE FLEET
// =============================================================================

model Vehicle {
  id Int @id @default(autoincrement())

  // Identifikace vozidla
  license_plate String? @db.VarChar(20) // SPZ
  company       String? @db.VarChar(100) // Vlastník/provozovatel: "Best Series" | "Špagetka" | "JTP services"
  model         String  @db.VarChar(255) // Vozidlo / model (např. "Hyundai i30")
  vin           String? @db.VarChar(30) // VIN kód
  category      String  @db.VarChar(50) // "Osobní vůz" | "Dodávka" | "Nákladní" | "Motocykl" | "Jiné"
  color         String? @db.VarChar(50)
  year          Int? // Rok výroby

  // Povinné ručení (POV)
  insurance_from    DateTime? @db.Date
  insurance_to      DateTime? @db.Date
  insurance_company String?   @db.VarChar(255)

  // STK — Státní technická kontrola
  stk_valid_to DateTime? @db.Date

  // Dálniční známka
  toll_sticker_to DateTime? @db.Date

  // Financování / vlastnictví
  // "operativni_leasing" | "vlastnictvi_firmy" | "financni_leasing" | "uver" | "jine"
  financing_type  String?   @db.VarChar(50)
  financing_to    DateTime? @db.Date
  financing_owner String?   @db.VarChar(255) // Např. "Best Series s.r.o.", "ESSOX s.r.o."

  // Disky a pneu
  disk_size String? @db.VarChar(255)
  tire_size String? @db.VarChar(255)

  // Řidič / odpovědná osoba
  driver_id Int?
  driver    Person? @relation("VehicleDriver", fields: [driver_id], references: [id], onDelete: SetNull)

  // Stav vozidla
  active     Boolean @default(true) // Aktivní/vyřazeno
  current_km Int? // Aktuální kilometry
  note       String? @db.Text

  // Vztahy k rozšíření fleet managementu (dokumenty, servisy, pneu, škody)
  documents          VehicleDocument[]
  insurance_policies VehicleInsurancePolicy[]
  services           VehicleService[]
  tire_changes       VehicleTireChange[]
  damage_events      VehicleDamageEvent[]
  tire_stock         TireStockItem[]

  // Účetní doklady — náklady na konkrétní auto (palivo, servis, pojistka)
  invoice_items InvoiceItem[] @relation("InvoiceItemVehicle")
  cost_centers  CostCenter[]  @relation("CostCenterVehicle")

  // Systémové
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([license_plate])
  @@index([company])
  @@index([vin])
  @@index([category])
  @@index([driver_id])
  @@index([active])
  @@index([insurance_to])
  @@index([stk_valid_to])
  @@index([toll_sticker_to])
  @@map("vehicles")
}

// Dokumentace vozu — technický průkaz, leasingová smlouva, STK protokoly atd.
model VehicleDocument {
  id         Int     @id @default(autoincrement())
  vehicle_id Int
  vehicle    Vehicle @relation(fields: [vehicle_id], references: [id], onDelete: Cascade)

  // Typ dokumentu: "technicky_prukaz" | "stk_protokol" | "smlouva" | "protokol" | "jine"
  // (Hodnota "leasing" zůstává podporována pro zpětnou kompatibilitu starších záznamů.)
  doc_type  String  @db.VarChar(50)
  title     String  @db.VarChar(255) // Popisek (např. "Technický průkaz - list A")
  file_url  String  @db.VarChar(500) // /api/storage/files/vehicles/...
  file_name String? @db.VarChar(255) // Původní název souboru
  file_size Int? // v bytech
  mime_type String? @db.VarChar(100)
  note      String? @db.Text

  uploaded_at DateTime @default(now())
  uploaded_by Int? // User.id (kdo nahrál)

  @@index([vehicle_id])
  @@index([doc_type])
  @@map("vehicle_documents")
}

// Pojistky — povinné ručení a havarijní, s platností a přiloženým dokumentem
model VehicleInsurancePolicy {
  id         Int     @id @default(autoincrement())
  vehicle_id Int
  vehicle    Vehicle @relation(fields: [vehicle_id], references: [id], onDelete: Cascade)

  // Typ: "pov" (povinné ručení) | "havarijni" | "jine"
  policy_type  String   @db.VarChar(30)
  // Pojišťovna — preferovaně FK na adresář firem (Company),
  //   company_name zůstává jako fallback / textový snapshot pro starší data.
  company_id   Int?
  company      Company? @relation("InsuranceCompany", fields: [company_id], references: [id], onDelete: SetNull)
  company_name String?  @db.VarChar(255) // Pojišťovna (text fallback)

  // Doplňková krytí — checkboxy v UI. Jedna pojistka může mít víc krytí.
  has_havarijni Boolean @default(false) // Havarijní pojištění
  has_glass     Boolean @default(false) // Pojištění čelního skla
  has_animal    Boolean @default(false) // Pojištění střetu se zvěří
  has_natural   Boolean @default(false) // Živelní pojištění

  policy_number  String?   @db.VarChar(100) // Číslo pojistky
  valid_from     DateTime? @db.Date
  valid_to       DateTime? @db.Date
  premium_amount Decimal?  @db.Decimal(12, 2) // Pojistné (Kč)
  // Pojistná smlouva (nový slot — "Smlouva scan")
  contract_url   String?   @db.VarChar(500)
  contract_name  String?   @db.VarChar(255)
  // Zelená karta (původní file_url — sémanticky se interpretuje jako Zelená karta;
  //   název pole zůstává kvůli zpětné kompatibilitě a načítání starých dat)
  file_url       String?   @db.VarChar(500)
  file_name      String?   @db.VarChar(255)
  note           String?   @db.Text

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([vehicle_id])
  @@index([company_id])
  @@index([policy_type])
  @@index([valid_to])
  @@map("vehicle_insurance_policies")
}

// Servisy — pravidelné + ad-hoc. Plán, provedení, cena, faktura.
model VehicleService {
  id         Int     @id @default(autoincrement())
  vehicle_id Int
  vehicle    Vehicle @relation(fields: [vehicle_id], references: [id], onDelete: Cascade)

  // Stav: "planned" (naplánováno, čeká na provedení)
  //     | "done" (provedeno a potvrzeno správcem)
  //     | "cancelled"
  status String @default("planned") @db.VarChar(20)

  service_type        String    @db.VarChar(255) // Např. "Pravidelný servis", "Výměna oleje", volný text
  scheduled_at        DateTime? // Plánovaný termín (datum + čas)
  done_at             DateTime? // Kdy skutečně proběhlo
  // Napojení na firmu v adresáři (preferovaný zdroj pravdy). Textové pole service_company
  // zůstává pro zpětnou kompatibilitu starších záznamů a při mazání firmy z adresáře.
  service_company_id  Int?
  service_company_ref Company?  @relation("VehicleServiceCompany", fields: [service_company_id], references: [id], onDelete: SetNull)
  service_company     String?   @db.VarChar(255) // Denormalizovaný název firmy (kvůli historii / mazání)
  // Místo provedení (volný text) — zachováno jako fallback pro starší záznamy
  // a pro případ, kdy uživatel zadal lokaci ručně mimo adresář provozoven.
  // Preferovaný zdroj pravdy je M2N relace `branches` (VehicleServiceLocation).
  location            String?   @db.VarChar(500)
  km_at_service       Int? // Stav kilometrů při servisu
  order_number        String?   @db.VarChar(100) // Číslo zakázky

  cost_labor     Decimal? @db.Decimal(12, 2) // Cena za práci (Kč)
  cost_parts     Decimal? @db.Decimal(12, 2) // Cena za díly (Kč)
  invoice_url    String?  @db.VarChar(500) // Napojená faktura (storage URL)
  invoice_number String?  @db.VarChar(100)
  protocol_url   String?  @db.VarChar(500) // Protokol / dodací list (PDF / obrázek, storage URL)

  note         String?   @db.Text
  confirmed_by Int? // User.id správce, který potvrdil provedení
  confirmed_at DateTime?

  created_at DateTime @default(now())
  created_by Int?
  updated_at DateTime @updatedAt

  // Místa provedení (M2N) — vybraná z provozoven firmy provádějící servis.
  branches VehicleServiceLocation[]

  @@index([vehicle_id])
  @@index([status])
  @@index([scheduled_at])
  @@index([service_company_id])
  @@map("vehicle_services")
}

// Výměny pneu — plán, provedení, cena (zvlášť úkon + samotné pneu)
model VehicleTireChange {
  id         Int     @id @default(autoincrement())
  vehicle_id Int
  vehicle    Vehicle @relation(fields: [vehicle_id], references: [id], onDelete: Cascade)

  // Stav: "planned" | "done" | "cancelled"
  status String @default("planned") @db.VarChar(20)

  // Sezóna: "letni" | "zimni"
  season String @db.VarChar(10)

  scheduled_at        DateTime? // Plánovaný termín
  done_at             DateTime?
  // Místo výměny (volný text) — zachováno jako fallback. Preferovaný zdroj pravdy
  // je M2N relace `branches` (VehicleTireChangeLocation).
  location            String?   @db.VarChar(500)
  km_at_service       Int? // Stav kilometrů při výměně
  order_number        String?   @db.VarChar(100) // Číslo zakázky
  // Napojení na firmu v adresáři (preferovaný zdroj pravdy). Textové pole service_company
  // zůstává pro zpětnou kompatibilitu starších záznamů a při mazání firmy z adresáře.
  service_company_id  Int?
  service_company_ref Company?  @relation("VehicleTireCompany", fields: [service_company_id], references: [id], onDelete: SetNull)
  service_company     String?   @db.VarChar(255) // Denormalizovaný název firmy (kvůli historii / mazání)

  // Oddělená cena: úkon (výměna/vyvážení) vs. nové pneu
  cost_service Decimal? @db.Decimal(12, 2) // Cena za úkon — výměna, vyvážení atd.
  cost_tires   Decimal? @db.Decimal(12, 2) // Cena za pneu (když byly kupovány nové)

  invoice_url    String? @db.VarChar(500)
  invoice_number String? @db.VarChar(100)
  // Protokol / dodací list (PDF nebo obrázek) — uložený ve storage stejně
  // jako faktura. Slouží k záznamu předávacího protokolu, dodacího listu od
  // pneuservisu nebo jiné technické dokumentace ke konkrétní výměně.
  protocol_url   String? @db.VarChar(500)

  note         String?   @db.Text
  confirmed_by Int?
  confirmed_at DateTime?

  created_at DateTime @default(now())
  created_by Int?
  updated_at DateTime @updatedAt

  // Místa provedení (M2N) — vybraná z provozoven pneuservisu.
  branches VehicleTireChangeLocation[]

  @@index([vehicle_id])
  @@index([status])
  @@index([scheduled_at])
  @@index([season])
  @@index([service_company_id])
  @@map("vehicle_tire_changes")
}

// Provozovny firem (adresář) — každá Company může mít více provozoven.
// Vznikají v Adresáři firem tlačítkem +Přidat. V Servisu / Pneu management
// se vybírají jako Místo provedení (může jich být více najednou).
model CompanyBranch {
  id         Int     @id @default(autoincrement())
  company_id Int
  company    Company @relation("CompanyBranches", fields: [company_id], references: [id], onDelete: Cascade)

  name           String? @db.VarChar(255) // Název pobočky (např. "Brno - Olomoucká")
  address        String? @db.VarChar(255)
  city           String? @db.VarChar(100)
  zip            String? @db.VarChar(10)
  contact_person String? @db.VarChar(255)
  phone          String? @db.VarChar(50)
  email          String? @db.VarChar(255)
  note           String? @db.Text
  active         Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  service_locations VehicleServiceLocation[]
  tire_locations    VehicleTireChangeLocation[]

  @@index([company_id])
  @@map("company_branches")
}

// M2N: VehicleService ↔ CompanyBranch (více míst provedení pro jeden servis)
model VehicleServiceLocation {
  service_id Int
  branch_id  Int

  service VehicleService @relation(fields: [service_id], references: [id], onDelete: Cascade)
  branch  CompanyBranch  @relation(fields: [branch_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())

  @@id([service_id, branch_id])
  @@index([service_id])
  @@index([branch_id])
  @@map("vehicle_service_locations")
}

// M2N: VehicleTireChange ↔ CompanyBranch (více míst provedení pro jednu výměnu)
model VehicleTireChangeLocation {
  tire_change_id Int
  branch_id      Int

  tire_change VehicleTireChange @relation(fields: [tire_change_id], references: [id], onDelete: Cascade)
  branch      CompanyBranch     @relation(fields: [branch_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())

  @@id([tire_change_id, branch_id])
  @@index([tire_change_id])
  @@index([branch_id])
  @@map("vehicle_tire_change_locations")
}

// Škodní události — datum, místo, popis, přílohy
model VehicleDamageEvent {
  id         Int     @id @default(autoincrement())
  vehicle_id Int
  vehicle    Vehicle @relation(fields: [vehicle_id], references: [id], onDelete: Cascade)

  event_date       DateTime // Datum události
  location         String?  @db.VarChar(500) // Místo události
  description      String?  @db.Text
  claim_number     String?  @db.VarChar(100) // Číslo škodní události u pojišťovny
  estimated_damage Decimal? @db.Decimal(12, 2) // Odhadovaná škoda (Kč)

  documents VehicleDamageDocument[]

  created_at DateTime @default(now())
  created_by Int?
  updated_at DateTime @updatedAt

  @@index([vehicle_id])
  @@index([event_date])
  @@map("vehicle_damage_events")
}

model VehicleDamageDocument {
  id              Int                @id @default(autoincrement())
  damage_event_id Int
  damage_event    VehicleDamageEvent @relation(fields: [damage_event_id], references: [id], onDelete: Cascade)

  title       String?  @db.VarChar(255)
  file_url    String   @db.VarChar(500)
  file_name   String?  @db.VarChar(255)
  mime_type   String?  @db.VarChar(100)
  file_size   Int?
  uploaded_at DateTime @default(now())
  uploaded_by Int?

  @@index([damage_event_id])
  @@map("vehicle_damage_documents")
}

// Sklad pneu — fyzické pneumatiky na skladě, přiřazené vozidlu (či volné)
// Sledujeme hloubku dezénu a pozici ve skladu.
model TireStockItem {
  id Int @id @default(autoincrement())

  // Přiřazení vozidlu (volitelné — může být i univerzální zásoba)
  vehicle_id Int?
  vehicle    Vehicle? @relation(fields: [vehicle_id], references: [id], onDelete: SetNull)

  // Sezóna: "letni" | "zimni"
  season String @db.VarChar(10)

  // Rozměr a výrobce
  tire_size    String? @db.VarChar(100) // např. "205/55 R16 91H"
  manufacturer String? @db.VarChar(100)
  model_name   String? @db.VarChar(255)
  dot_code     String? @db.VarChar(20) // DOT kód (týden/rok výroby)

  // Stav dezénu — v mm, pro hlídání hranic (letní 2-3 mm, zimní 4-5 mm = upozornění)
  tread_depth_mm Decimal? @db.Decimal(4, 1)

  // Zadní sada (axle = rear). Existující pole výše = přední sada (axle = front).
  // Pokud rear_* zůstane null, znamená to, že přední a zadní sada jsou identické
  // (stejný rozměr/výrobce/atd.) — UI to interpretuje jako "stejné jako přední".
  rear_tire_size      String?  @db.VarChar(100)
  rear_manufacturer   String?  @db.VarChar(100)
  rear_model_name     String?  @db.VarChar(255)
  rear_dot_code       String?  @db.VarChar(20)
  rear_tread_depth_mm Decimal? @db.Decimal(4, 1)

  // Lokace ve skladu (volný text: "Regál A3", "Sklad B — pozice 14")
  storage_location String? @db.VarChar(255)

  // Namontováno = aktuálně na voze; false = na skladě
  mounted       Boolean   @default(false)
  mounted_at    DateTime?
  dismounted_at DateTime?

  // Odkaz na nákupní fakturu (nepovinné)
  purchase_price Decimal? @db.Decimal(12, 2)
  invoice_url    String?  @db.VarChar(500)
  invoice_number String?  @db.VarChar(100)

  note String? @db.Text

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([vehicle_id])
  @@index([season])
  @@index([mounted])
  @@map("tire_stock_items")
}

// =============================================================================
// CAD — SolidWorks výkresy, sestavy, kusovníky
// Import ze SolidWorksu přes desktop klienta (kontextové menu "Odevzdat do výroby").
// Původně tok CadExporter → Factorify, migrováno do HolyOS (/api/cad/*).
// =============================================================================

// Projekt = nejvyšší úroveň (zakázka / produktová řada)
model CadProject {
  id          Int     @id @default(autoincrement())
  code        String  @unique @db.VarChar(50) // krátký kód projektu, unikátní
  name        String  @db.VarChar(255)
  customer    String? @db.VarChar(255)
  description String? @db.Text
  active      Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  blocks   CadBlock[]
  drawings CadDrawing[]

  @@index([code])
  @@index([active])
  @@map("cad_projects")
}

// Blok = uzel ve stromu projektu (odpovídá Factorify "goodsBlock")
model CadBlock {
  id         Int     @id @default(autoincrement())
  project_id Int
  parent_id  Int?
  name       String  @db.VarChar(255)
  label      String? @db.VarChar(255) // TokenizedLabel z původního API (volitelné)
  sort_order Int     @default(0)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  project  CadProject   @relation(fields: [project_id], references: [id], onDelete: Cascade)
  parent   CadBlock?    @relation("CadBlockTree", fields: [parent_id], references: [id], onDelete: SetNull)
  children CadBlock[]   @relation("CadBlockTree")
  drawings CadDrawing[]

  @@index([project_id])
  @@index([parent_id])
  @@map("cad_blocks")
}

// Výkres / díl / sestava — jeden soubor ze SolidWorksu
model CadDrawing {
  id         Int  @id @default(autoincrement())
  project_id Int
  block_id   Int?

  // Identifikace
  file_name     String  @db.VarChar(255) // např. "12345-01.SLDDRW"
  relative_path String? @db.VarChar(500)
  extension     String  @db.VarChar(10) // "sldprt" | "sldasm" | "slddrw" | "stl"
  version       Int     @default(1)
  checksum      String? @db.VarChar(64) // SHA256 binárního souboru
  feature_hash  String? @db.VarChar(64) // SHA256 feature-tree ze SW — reálný indikátor změny geometrie
  source_path   String? @db.VarChar(1000) // původní cesta na disku autora

  // Metadata
  title       String? @db.VarChar(255) // pěkný název (z custom property)
  description String? @db.Text

  // Autor / vlastnictví
  created_by_id  Int?
  imported_at    DateTime @default(now())
  last_import_at DateTime @default(now())

  // Systémové
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  project        CadProject            @relation(fields: [project_id], references: [id], onDelete: Cascade)
  block          CadBlock?             @relation(fields: [block_id], references: [id], onDelete: SetNull)
  creator        Person?               @relation("CadDrawingCreator", fields: [created_by_id], references: [id], onDelete: SetNull)
  configurations CadDrawingConfig[]
  change_logs    CadDrawingChangeLog[]

  @@unique([project_id, file_name, version])
  @@index([project_id])
  @@index([block_id])
  @@index([extension])
  @@index([file_name])
  @@map("cad_drawings")
}

// Historie změn výkresu — každý úspěšný import (create / update) zaznamená
// autora, verze, váhu změny a volitelnou poznámku od konstruktéra.
// Zobrazuje se v detailu výkresu jako časová osa.
model CadDrawingChangeLog {
  id          Int      @id @default(autoincrement())
  drawing_id  Int
  author_id   Int?
  action      String   @db.VarChar(20) // "created" | "updated"
  weight      String?  @db.VarChar(20) // "minor" | "medium" | "major" | null
  note        String?  @db.Text
  old_version Int?
  new_version Int
  created_at  DateTime @default(now())

  drawing CadDrawing @relation(fields: [drawing_id], references: [id], onDelete: Cascade)
  author  Person?    @relation("CadDrawingChangeLogAuthor", fields: [author_id], references: [id], onDelete: SetNull)

  @@index([drawing_id])
  @@index([created_at])
  @@map("cad_drawing_change_logs")
}

// Konfigurace výkresu — SolidWorks umí mít více konfigurací v jednom souboru
// (varianty rozměrů, provedení). Pro každou se generuje vlastní PDF/PNG.
model CadDrawingConfig {
  id         Int @id @default(autoincrement())
  drawing_id Int

  config_name String  @db.VarChar(255) // např. "Default", "Levá varianta"
  config_code String? @db.VarChar(100) // ConfigurationID z SW
  quantity    Int     @default(1) // počet ks při odevzdání
  selected    Boolean @default(true)

  custom_properties Json     @default("{}") // všechny custom props karty
  mass_grams        Decimal? @db.Decimal(12, 3) // hmotnost z GetMassProperties

  png_path String? @db.VarChar(500) // cesta uloženého PNG náhledu
  pdf_path String? @db.VarChar(500) // cesta uloženého PDF výkresu
  stl_path String? @db.VarChar(500) // cesta uloženého STL pro 3D web viewer (Three.js)

  // Další přílohy — .step, .dxf, .easm, .eprt, .iges atd. Formát:
  // [{ kind: "step", filename: "BS-S-0325.step", path: "2026/04/ab12…step", size: 123456 }]
  attachments Json @default("[]")

  // Externí reference (odkazy na další SW soubory)
  external_references Json @default("[]")

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  drawing    CadDrawing     @relation(fields: [drawing_id], references: [id], onDelete: Cascade)
  components CadComponent[]

  @@unique([drawing_id, config_name])
  @@index([drawing_id])
  @@map("cad_drawing_configs")
}

// Komponenta = položka v kusovníku sestavy (.sldasm)
// "UnknownComponents" = ty, které index nerozpoznal a čekají na dořešení
model CadComponent {
  id               Int @id @default(autoincrement())
  parent_config_id Int

  name              String  @db.VarChar(255)
  path              String? @db.VarChar(1000)
  quantity          Int     @default(1)
  configuration     String? @db.VarChar(255)
  custom_properties Json?
  is_unknown        Boolean @default(false) // true = index nenašel odpovídající díl
  material_id       Int? // napojení na HolyOS katalog materiálů
  resolved          Boolean @default(false)

  created_at DateTime @default(now())

  parent_config CadDrawingConfig @relation(fields: [parent_config_id], references: [id], onDelete: Cascade)
  material      Material?        @relation(fields: [material_id], references: [id], onDelete: SetNull)

  @@index([parent_config_id])
  @@index([material_id])
  @@index([is_unknown])
  @@map("cad_components")
}

// =============================================================================
// SKLAD 2.0 — PWA ČTEČKA + CENTRÁLNÍ TISK (2026-04)
//
// Nové entity pro skladový modul s podporou PWA na SUNMI L2H/L3 čtečce,
// offline-first provoz (dedup přes client_uuid), pickovací dávky a
// centrální tisk etiket přes TSC TC200 v ZPL.
//
// Doplňuje stávající Warehouse / WarehouseLocation / Material /
// InventoryMovement / Inventory — nenahrazuje je.
// =============================================================================

// Aktuální zásoba dané položky na konkrétní lokaci.
// Transakčně udržovaná z InventoryMovement — rychlý lookup pro čtečku.
model Stock {
  id                Int     @id @default(autoincrement())
  material_id       Int
  location_id       Int
  lot_id            Int? // SKLAD 2.0 — šarže (jen pokud Material.expirable nebo distinguish_batches)
  quantity          Decimal @default(0) @db.Decimal(12, 3)
  reserved_quantity Decimal @default(0) @db.Decimal(12, 3) // rezervováno pro otevřené dávky/výdejky

  updated_at DateTime @updatedAt

  material Material          @relation(fields: [material_id], references: [id])
  location WarehouseLocation @relation(fields: [location_id], references: [id])
  lot      MaterialLot?      @relation(fields: [lot_id], references: [id])

  // Triplet unique — pro nešaržované materiály (lot_id = NULL) PostgreSQL NULL != NULL,
  // takže potenciálně dva záznamy [material, location, NULL]. Business logika v
  // moves.service.js musí takové duplicity hlídat (zatím: upsert po kompozitním klíči).
  @@unique([material_id, location_id, lot_id])
  @@index([location_id])
  @@index([material_id])
  @@index([lot_id])
  @@map("stock")
}

// SKLAD 2.0 — Šarže (lot) pro materiály s expirací nebo rozlišováním dávek.
// Typický use case: prádelna (detergenty s expirací, sledujeme od které šarže
// byl odebrán kus do konkrétního cyklu), potraviny, chemikálie.
// FIFO podle expires_at se řeší v services/warehouse/lots.service.js pickFIFO.
model MaterialLot {
  id          Int    @id @default(autoincrement())
  material_id Int
  lot_code    String @db.VarChar(100)
  status      String @default("in_stock") @db.VarChar(20) // in_stock, consumed, expired, scrapped

  manufactured_at DateTime? @db.Date
  expires_at      DateTime? @db.Date

  supplier_id      Int?
  supplier_lot_ref String? @db.VarChar(100) // externí lot reference od dodavatele

  received_at      DateTime?
  received_move_id Int?
  received_by      Int?

  note       String?  @db.Text
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  material        Material           @relation(fields: [material_id], references: [id], onDelete: Cascade)
  supplier        Company?           @relation("MaterialLotSupplier", fields: [supplier_id], references: [id])
  received_move   InventoryMovement? @relation("MaterialLotReceivedMove", fields: [received_move_id], references: [id])
  received_person Person?            @relation("MaterialLotReceivedBy", fields: [received_by], references: [id])
  stock_rows      Stock[] // Stock záznamy v různých lokacích pro tuto šarži

  @@unique([material_id, lot_code])
  @@index([material_id])
  @@index([status])
  @@index([expires_at])
  @@index([supplier_id])
  @@map("material_lots")
}

// Skladový dokument — zastřešuje skupinu pohybů (dodací list, výdejka, přesunka,
// pickovací list, inventurní protokol). Append-only princip: dokument se
// uzavře (completed) a dál se needituje — oprava je novým opačným dokumentem.
model WarehouseDocument {
  id           Int       @id @default(autoincrement())
  type         String    @db.VarChar(30) // receipt_doc, issue_doc, transfer_doc, pick_list, inventory_doc
  number       String    @unique @db.VarChar(50) // řada per typ, např. PR-2026-00123
  status       String    @default("draft") @db.VarChar(20) // draft, in_progress, completed, cancelled
  partner_id   Int? // dodavatel / odběratel / projekt (Company) — Factorify counterpartyCompany
  reference    String?   @db.VarChar(255) // volný text — číslo DL od dodavatele apod.
  note         String?   @db.Text
  created_by   Int?
  completed_at DateTime?
  completed_by Int?

  // Vazby (Factorify má i tyto vazby na StockDocument)
  cost_center_id Int?
  project_id     Int?

  // Factorify migrace
  factorify_id   String? @db.VarChar(100) // StockDocument.id
  factorify_type String? @db.VarChar(50) // původní type ze StockDocument (Factorify enum)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  partner     Company?            @relation("WarehouseDocumentPartner", fields: [partner_id], references: [id])
  creator     Person?             @relation("WarehouseDocumentCreator", fields: [created_by], references: [id])
  cost_center CostCenter?         @relation("WarehouseDocumentCostCenter", fields: [cost_center_id], references: [id])
  project     Project?            @relation("WarehouseDocumentProject", fields: [project_id], references: [id])
  movements   InventoryMovement[] // pohyby patřící tomuto dokumentu
  invoices    Invoice[]           @relation("InvoiceWarehouseDoc") // faktury vázané na tento doklad (AP příjemka, AR dodací list)

  @@index([type])
  @@index([status])
  @@index([partner_id])
  @@index([created_at])
  @@index([factorify_id])
  @@index([cost_center_id])
  @@index([project_id])
  @@map("warehouse_documents")
}

// Pickovací dávka — skupina položek vychystávaných najednou.
// Typicky e-shop: 20 objednávek za hodinu se zpracuje jako jedna dávka
// a operátor prochází sklad podle optimální trasy.
model Batch {
  id          Int     @id @default(autoincrement())
  number      String  @unique @db.VarChar(50) // např. BAT-2026-0042
  sector      String? @db.VarChar(20) // vyroba, stavba, servis, eshop, pradelna
  status      String  @default("open") @db.VarChar(20) // open, picking, done, cancelled
  assigned_to Int? // operátor (Person), který dávku pickuje
  note        String? @db.Text

  created_at   DateTime  @default(now())
  started_at   DateTime?
  completed_at DateTime?

  assignee Person?     @relation("BatchAssignee", fields: [assigned_to], references: [id])
  items    BatchItem[]

  @@index([status])
  @@index([assigned_to])
  @@index([sector])
  @@map("batches")
}

// Jedna položka pickovací dávky — co, kolik, odkud.
// Seřazeno podle optimální trasy skladem (via sort_order).
model BatchItem {
  id               Int       @id @default(autoincrement())
  batch_id         Int
  material_id      Int
  from_location_id Int? // odkud se má vzít (navrhovaná zdrojová lokace)
  quantity         Decimal   @db.Decimal(12, 3)
  picked_quantity  Decimal?  @db.Decimal(12, 3) // kolik se reálně napickovalo
  status           String    @default("pending") @db.VarChar(20) // pending, picked, short, skipped
  sort_order       Int       @default(0) // pořadí v trase skladem
  picked_by        Int? // Person, kdo položku napickoval
  picked_at        DateTime?
  note             String?   @db.Text

  batch         Batch              @relation(fields: [batch_id], references: [id], onDelete: Cascade)
  material      Material           @relation(fields: [material_id], references: [id])
  from_location WarehouseLocation? @relation(fields: [from_location_id], references: [id])
  picker        Person?            @relation("BatchItemPickedBy", fields: [picked_by], references: [id])

  @@index([batch_id])
  @@index([material_id])
  @@index([status])
  @@map("batch_items")
}

// Tiskárna etiket — centrálně spravovaná, HolyOS backend drží TCP spojení
// a vystavuje tiskové API. Web i PWA volají stejný endpoint.
model Printer {
  id              Int       @id @default(autoincrement())
  name            String    @db.VarChar(100) // např. "Tiskárna Rychnov"
  model           String    @default("TSC_TC200") @db.VarChar(50) // preset: TSC_TC200, ZEBRA_GK420, CUSTOM
  location_id     Int? // kam patří (autoselekce tiskárny podle místa operace)
  connection_type String    @default("lan") @db.VarChar(10) // lan, usb
  ip_address      String?   @db.Inet
  port            Int?
  language        String    @default("ZPL") @db.VarChar(10) // ZPL, TSPL, EPL
  label_width_mm  Decimal   @default(60) @db.Decimal(6, 2)
  label_height_mm Decimal   @default(20) @db.Decimal(6, 2)
  dpi             Int       @default(203)
  priority        Int       @default(0) // autoselekce při více tiskárnách
  is_active       Boolean   @default(true)
  last_ping_ok    DateTime?
  encoding        String    @default("UTF-8") @db.VarChar(20)
  // Pokročilá nastavení (většinou default, skrytá v UI)
  pre_command     String?   @db.Text
  post_command    String?   @db.Text
  gap_mm          Decimal?  @db.Decimal(4, 2)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  location   WarehouseLocation? @relation(fields: [location_id], references: [id])
  print_jobs PrintJob[]

  @@index([location_id])
  @@index([is_active])
  @@map("printers")
}

// Šablona etikety — ZPL/TSPL text s placeholdery {{qr_code}}, {{item_name}}, …
// Backend při tisku dosadí data a pošle na tiskárnu.
model LabelTemplate {
  id          Int     @id @default(autoincrement())
  code        String  @unique @db.VarChar(50) // např. item_label, location_label, document_summary
  name        String  @db.VarChar(255)
  language    String  @default("ZPL") @db.VarChar(10) // ZPL, TSPL, EPL
  width_mm    Decimal @default(60) @db.Decimal(6, 2)
  height_mm   Decimal @default(20) @db.Decimal(6, 2)
  body        String  @db.Text // šablona s placeholdery
  description String? @db.Text
  is_active   Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  print_jobs PrintJob[]

  @@map("label_templates")
}

// Záznam o tisku — auditní stopa. Kdo, kdy, co, kam, úspěch/chyba.
model PrintJob {
  id           Int     @id @default(autoincrement())
  template_id  Int?
  printer_id   Int
  data         Json // hodnoty pro placeholdery šablony
  copies       Int     @default(1)
  status       String  @default("queued") @db.VarChar(20) // queued, printing, done, failed
  error        String? @db.Text
  requested_by Int? // Person
  device_id    String? @db.VarChar(100) // z jaké čtečky/PC byl tisk spuštěn

  created_at  DateTime  @default(now())
  finished_at DateTime?

  template  LabelTemplate? @relation(fields: [template_id], references: [id])
  printer   Printer        @relation(fields: [printer_id], references: [id])
  requester Person?        @relation("PrintJobRequestedBy", fields: [requested_by], references: [id])

  @@index([printer_id])
  @@index([status])
  @@index([created_at])
  @@map("print_jobs")
}

// SKLAD 2.0 — Sériová čísla (servis + trackované kusy)
// Jedno vydané číslo per konkrétní fyzický kus materiálu. Řízení: při příjmu
// materiálu s Material.save_sn_first_scan=true UI vyžádá sken N S/N; při
// výdeji/servisu se S/N mění status + naváže se na zakázku. `sn_mask` na
// Material může obsahovat regex pro validaci formátu S/N.
model SerialNumber {
  id            Int    @id @default(autoincrement())
  material_id   Int
  serial_number String @db.VarChar(100)
  status        String @default("in_stock") @db.VarChar(20) // in_stock, issued, scrapped, returned
  location_id   Int?

  // Audit: kdy se číslo objevilo / vydalo / vyřadilo + vazba na pohyby.
  received_at      DateTime?
  received_move_id Int?
  issued_at        DateTime?
  issued_move_id   Int?
  scrapped_at      DateTime?
  returned_at      DateTime?

  // Vazba na zakázku / servisní případ / dávku.
  reference_type String? @db.VarChar(50) // order, service_case, batch, manual, project
  reference_id   Int?

  received_by Int? // Person — kdo přijal
  issued_by   Int? // Person — kdo vydal
  note        String? @db.Text

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  material        Material           @relation(fields: [material_id], references: [id], onDelete: Cascade)
  location        WarehouseLocation? @relation(fields: [location_id], references: [id])
  received_move   InventoryMovement? @relation("SerialReceivedMove", fields: [received_move_id], references: [id])
  issued_move     InventoryMovement? @relation("SerialIssuedMove", fields: [issued_move_id], references: [id])
  received_person Person?            @relation("SerialReceivedBy", fields: [received_by], references: [id])
  issued_person   Person?            @relation("SerialIssuedBy", fields: [issued_by], references: [id])

  @@unique([material_id, serial_number]) // stejný S/N může teoreticky existovat u různých materiálů
  @@index([material_id])
  @@index([serial_number])
  @@index([status])
  @@index([location_id])
  @@index([reference_type, reference_id])
  @@map("serial_numbers")
}

// =============================================================================
// ÚČETNÍ DOKLADY — FAKTURY, PLATBY, BANKA, POKLADNA, OCR-EMAIL
// Modul "Účetní doklady" (ucetni-doklady). Faktury přijaté i vydané,
// 3-way match (objednávka + příjemka + faktura), workflow schvalování,
// hromadný ABO platební příkaz, výpisy z banky + párování, pokladna,
// upomínky, odevzdání účetní firmě, OCR e-mail ingest.
// =============================================================================

// Faktura (přijatá i vydaná). Pro přijatou: direction=ap, type=received.
// Pro vydanou: direction=ar, type=issued. Dobropisy: type=credit_note_*.
model Invoice {
  id              Int     @id @default(autoincrement())
  invoice_number  String  @unique @db.VarChar(50) // naše interní číslo; sekvenční řada per typ
  external_number String? @db.VarChar(100) // číslo dokladu od dodavatele (AP) nebo ref od zákazníka (AR)
  type            String  @db.VarChar(30) // received, issued, credit_note_received, credit_note_issued, proforma_received, proforma_issued
  direction       String  @db.VarChar(2) // ap (payable), ar (receivable)

  // Partner (dodavatel pro AP, odběratel pro AR)
  company_id Int
  company    Company @relation("InvoiceCompany", fields: [company_id], references: [id])

  // Vazba na objednávku (pro 3-way match)
  order_id Int?
  order    Order? @relation("InvoiceOrder", fields: [order_id], references: [id])

  // Vazba na skladový doklad (příjemka pro AP / dodací list pro AR)
  warehouse_document_id Int?
  warehouse_document    WarehouseDocument? @relation("InvoiceWarehouseDoc", fields: [warehouse_document_id], references: [id])

  // Finanční sumy
  currency      String  @default("CZK") @db.VarChar(3)
  exchange_rate Decimal @default(1) @db.Decimal(12, 6)
  subtotal      Decimal @default(0) @db.Decimal(14, 2) // bez DPH
  vat_amount    Decimal @default(0) @db.Decimal(14, 2)
  total         Decimal @default(0) @db.Decimal(14, 2) // s DPH
  rounding      Decimal @default(0) @db.Decimal(6, 2)
  paid_amount   Decimal @default(0) @db.Decimal(14, 2)

  // DPH režim
  vat_regime String @default("standard") @db.VarChar(30) // standard, reverse_charge, eu_goods, non_vat_payer

  // Data
  date_issued   DateTime  @db.Date
  date_taxable  DateTime? @db.Date // DUZP
  date_received DateTime? // datum doručení (AP)
  date_due      DateTime  @db.Date

  // Platba
  payment_method       String  @default("bank_transfer") @db.VarChar(20) // bank_transfer, cash, card, barter
  variable_symbol      String? @db.VarChar(20)
  constant_symbol      String? @db.VarChar(10)
  specific_symbol      String? @db.VarChar(20)
  partner_bank_account String? @db.VarChar(50) // kam platit (AP) / náš účet (AR)
  partner_iban         String? @db.VarChar(34)
  partner_bic          String? @db.VarChar(11)

  // Stav (workflow):
  //  AP: draft → awaiting_po_match → po_matched → awaiting_goods_receipt → goods_received
  //      → awaiting_approval → approved → ready_to_pay → payment_queued → paid → archived
  //  AR: draft → issued → sent → reminder_1_sent → reminder_2_sent → reminder_3_sent
  //      → paid → overdue → written_off | cancelled
  status String @default("draft") @db.VarChar(30)

  // Schvalování (AP)
  approved_by_id Int?
  approved_by    Person?   @relation("InvoiceApprover", fields: [approved_by_id], references: [id])
  approved_at    DateTime?

  // Upomínky (AR)
  reminder_1_sent_at DateTime?
  reminder_2_sent_at DateTime?
  reminder_3_sent_at DateTime?

  // Role faktury v rámci dvoufázové platby:
  //   'deposit' — záloha (proforma_issued nebo issued se sníženou částkou)
  //   'final'   — doplatek (zbytek po záloze)
  //   'full'    — jednorázová platba (default chování, pokud Order.payment_split=false)
  //   null      — legacy / běžná faktura nesouvisející s platebním schématem
  invoice_role String? @db.VarChar(20)

  // Zdroj dokumentu
  source          String?      @db.VarChar(30) // manual, email, api, import_xml, factorify
  email_ingest_id Int?
  email_ingest    EmailIngest? @relation("InvoiceEmailIngest", fields: [email_ingest_id], references: [id])

  // OCR
  ocr_confidence     Decimal? @db.Decimal(4, 3) // 0.000–1.000
  ocr_passes_done    Int      @default(0)
  needs_human_review Boolean  @default(false)

  // Skenovaný originál (PDF/obrázek)
  source_file_path String? @db.VarChar(500)

  // Zdrojový PDF (vygenerovaný pro AR, nebo scan pro AP)
  pdf_file_path String? @db.VarChar(500)

  // Meta
  note          String?  @db.Text
  internal_note String?  @db.Text
  tags          String[] @default([])

  created_by_id      Int?
  created_by         Person? @relation("InvoiceCreator", fields: [created_by_id], references: [id])
  // Vždy vyplněné — User, který fakturu založil (i když nemá propojený Person)
  created_by_user_id Int?
  created_by_user    User?   @relation("InvoiceCreatorUser", fields: [created_by_user_id], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  items           InvoiceItem[]
  allocations     PaymentAllocation[]
  ocr_extractions OcrExtraction[]          @relation("OcrForInvoice")
  approval_steps  InvoiceApprovalStep[]
  reminders       Reminder[]
  cash_movements  CashMovement[]           @relation("CashMovementInvoice")
  handover_items  AccountantHandoverItem[] @relation("HandoverItemInvoice")
  // Reverzní k Order.final_invoice (1:1) — faktura na doplatek
  order_as_final  Order?                   @relation("OrderFinalInvoice")

  @@index([type, status])
  @@index([direction, status])
  @@index([company_id])
  @@index([order_id])
  @@index([date_issued])
  @@index([date_due])
  @@index([external_number])
  @@index([variable_symbol])
  @@index([invoice_role])
  @@map("invoices")
}

// Řádek faktury. Cost-center umožňuje kategorizaci (auto/osoba/stroj/projekt).
model InvoiceItem {
  id         Int     @id @default(autoincrement())
  invoice_id Int
  invoice    Invoice @relation(fields: [invoice_id], references: [id], onDelete: Cascade)

  line_order  Int     @default(0)
  description String  @db.VarChar(500)
  quantity    Decimal @db.Decimal(12, 4)
  unit        String  @default("ks") @db.VarChar(20)
  unit_price  Decimal @db.Decimal(14, 4) // bez DPH

  vat_rate   Decimal @default(21) @db.Decimal(5, 2) // 0, 12, 15, 21 %
  subtotal   Decimal @db.Decimal(14, 2) // bez DPH
  vat_amount Decimal @db.Decimal(14, 2)
  total      Decimal @db.Decimal(14, 2) // s DPH

  // Cost-center kategorizace (auto, osoba, stroj, projekt, oddělení, obecné)
  cost_center_id Int?
  cost_center    CostCenter? @relation("InvoiceItemCostCenter", fields: [cost_center_id], references: [id])

  // Vazba na master data
  material_id Int?
  material    Material? @relation("InvoiceItemMaterial", fields: [material_id], references: [id])
  product_id  Int?
  product     Product?  @relation("InvoiceItemProduct", fields: [product_id], references: [id])

  // Přímé assety (pro rychlou statistiku bez cost-centeru)
  vehicle_id Int?
  vehicle    Vehicle? @relation("InvoiceItemVehicle", fields: [vehicle_id], references: [id])
  person_id  Int?
  person     Person?  @relation("InvoiceItemPerson", fields: [person_id], references: [id])

  // Vazba na položku objednávky (3-way match)
  order_item_id Int?
  order_item    OrderItem? @relation("InvoiceItemOrderItem", fields: [order_item_id], references: [id])

  note String? @db.VarChar(500)

  @@index([invoice_id])
  @@index([cost_center_id])
  @@index([vehicle_id])
  @@index([person_id])
  @@index([material_id])
  @@map("invoice_items")
}

// Schvalovací krok u faktury (multi-step approval).
model InvoiceApprovalStep {
  id          Int       @id @default(autoincrement())
  invoice_id  Int
  invoice     Invoice   @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  step_order  Int
  approver_id Int
  approver    Person    @relation("InvoiceApprovalStepApprover", fields: [approver_id], references: [id])
  status      String    @default("pending") @db.VarChar(20) // pending, approved, rejected, skipped
  required    Boolean   @default(true)
  decided_at  DateTime?
  note        String?   @db.Text

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([invoice_id])
  @@index([approver_id, status])
  @@map("invoice_approval_steps")
}

// =============================================================================
// COST CENTERS (nákladová střediska)
// =============================================================================

model CostCenter {
  id   Int    @id @default(autoincrement())
  code String @unique @db.VarChar(50)
  name String @db.VarChar(255)
  // vehicle, person, machine, project, department, general
  type String @db.VarChar(30)

  parent_id Int?
  parent    CostCenter?  @relation("CostCenterHierarchy", fields: [parent_id], references: [id])
  children  CostCenter[] @relation("CostCenterHierarchy")

  // Volitelné navázání na konkrétní entitu (auto, osobu, oddělení)
  vehicle_id    Int?
  vehicle       Vehicle?    @relation("CostCenterVehicle", fields: [vehicle_id], references: [id])
  person_id     Int?
  person        Person?     @relation("CostCenterPerson", fields: [person_id], references: [id])
  department_id Int?
  department    Department? @relation("CostCenterDepartment", fields: [department_id], references: [id])

  active Boolean @default(true)
  note   String? @db.Text

  // Factorify migrace
  factorify_id String? @db.VarChar(100) // CostCenter.id

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  invoice_items       InvoiceItem[]       @relation("InvoiceItemCostCenter")
  cash_movements      CashMovement[]      @relation("CashMovementCostCenter")
  orders              Order[]             @relation("OrderCostCenter")
  warehouse_documents WarehouseDocument[] @relation("WarehouseDocumentCostCenter")

  @@index([type, active])
  @@index([vehicle_id])
  @@index([person_id])
  @@index([factorify_id])
  @@map("cost_centers")
}

// =============================================================================
// PLATBY — DÁVKA (ABO BATCH) & JEDNOTLIVÁ PLATBA & ALOKACE
// =============================================================================

// Hromadný platební příkaz do banky (ABO/SEPA/API).
model PaymentBatch {
  id              Int         @id @default(autoincrement())
  batch_number    String      @unique @db.VarChar(50) // PB-2026-0001
  bank_account_id Int
  bank_account    BankAccount @relation(fields: [bank_account_id], references: [id])
  // ABO-KPC, ABO-GPC (pro příkaz), SEPA-XML, MULTICASH, FIO-API, CSOB-API
  format          String      @db.VarChar(30)
  // draft, generated, submitted_to_bank, processed, rejected, cancelled
  status          String      @default("draft") @db.VarChar(30)
  total_count     Int         @default(0)
  total_amount    Decimal     @default(0) @db.Decimal(16, 2)
  file_path       String?     @db.VarChar(500)
  generated_at    DateTime?
  submitted_at    DateTime?
  processed_at    DateTime?
  due_date        DateTime    @db.Date
  note            String?     @db.Text

  created_by_id Int?
  created_by    Person? @relation("PaymentBatchCreator", fields: [created_by_id], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  payments Payment[]

  @@index([status, due_date])
  @@index([bank_account_id])
  @@map("payment_batches")
}

// Jednotlivá platba (outgoing z batche / incoming z výpisu / hotovost).
model Payment {
  id        Int    @id @default(autoincrement())
  direction String @db.VarChar(3) // out (AP), in (AR)
  method    String @default("bank_transfer") @db.VarChar(20) // bank_transfer, cash, card, barter

  batch_id         Int?
  batch            PaymentBatch? @relation(fields: [batch_id], references: [id])
  cash_register_id Int?
  cash_register    CashRegister? @relation("PaymentCashRegister", fields: [cash_register_id], references: [id])

  bank_transaction_id Int?             @unique
  bank_transaction    BankTransaction? @relation(fields: [bank_transaction_id], references: [id])

  amount     Decimal @db.Decimal(14, 2)
  currency   String  @default("CZK") @db.VarChar(3)
  amount_czk Decimal @db.Decimal(14, 2)

  partner_name    String  @db.VarChar(255)
  partner_account String? @db.VarChar(50)
  variable_symbol String? @db.VarChar(20)
  constant_symbol String? @db.VarChar(10)
  specific_symbol String? @db.VarChar(20)
  message         String? @db.VarChar(140) // zpráva pro příjemce

  scheduled_date DateTime? @db.Date
  executed_date  DateTime? @db.Date

  // draft, queued, submitted, executed, failed, cancelled
  status String @default("draft") @db.VarChar(20)

  allocations PaymentAllocation[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([status, scheduled_date])
  @@index([batch_id])
  @@index([variable_symbol])
  @@map("payments")
}

// Alokace platby na fakturu (m:n — jedna platba může pokrýt více faktur, částečné platby).
model PaymentAllocation {
  id         Int     @id @default(autoincrement())
  payment_id Int
  payment    Payment @relation(fields: [payment_id], references: [id], onDelete: Cascade)
  invoice_id Int
  invoice    Invoice @relation(fields: [invoice_id], references: [id])
  amount     Decimal @db.Decimal(14, 2)
  note       String? @db.VarChar(255)

  created_at DateTime @default(now())

  @@index([payment_id])
  @@index([invoice_id])
  @@map("payment_allocations")
}

// =============================================================================
// BANKA — ÚČTY, VÝPISY, TRANSAKCE, PRAVIDLA PRO PÁROVÁNÍ
// =============================================================================

model BankAccount {
  id                  Int       @id @default(autoincrement())
  name                String    @db.VarChar(100) // "Fio firma", "ČSOB provoz"
  // FIO, CSOB, MONETA, UNICREDIT, KB, RB, OTHER
  bank                String    @db.VarChar(20)
  account_number      String    @db.VarChar(30) // 2501234567
  bank_code           String    @db.VarChar(4) // 2010, 0300, 0600, 2700
  iban                String?   @db.VarChar(34)
  bic                 String?   @db.VarChar(11)
  currency            String    @default("CZK") @db.VarChar(3)
  api_enabled         Boolean   @default(false)
  api_credentials_ref String?   @db.VarChar(255) // klíč do secret store (ENV), ne samotný token
  active              Boolean   @default(true)
  opening_balance     Decimal   @default(0) @db.Decimal(16, 2)
  current_balance     Decimal   @default(0) @db.Decimal(16, 2)
  last_statement_date DateTime? @db.Date
  note                String?   @db.Text

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  statements      BankStatement[]
  transactions    BankTransaction[]
  payment_batches PaymentBatch[]

  @@unique([account_number, bank_code])
  @@index([bank, active])
  @@map("bank_accounts")
}

model BankStatement {
  id               Int         @id @default(autoincrement())
  bank_account_id  Int
  bank_account     BankAccount @relation(fields: [bank_account_id], references: [id])
  statement_number String      @db.VarChar(50)
  period_from      DateTime    @db.Date
  period_to        DateTime    @db.Date
  opening_balance  Decimal     @db.Decimal(16, 2)
  closing_balance  Decimal     @db.Decimal(16, 2)
  // api, gpc_upload, csv_upload, mt940_upload
  source           String      @db.VarChar(30)
  file_path        String?     @db.VarChar(500)
  imported_at      DateTime    @default(now())
  imported_by_id   Int?

  transactions BankTransaction[]

  @@unique([bank_account_id, statement_number])
  @@index([period_from, period_to])
  @@map("bank_statements")
}

model BankTransaction {
  id              Int            @id @default(autoincrement())
  bank_account_id Int
  bank_account    BankAccount    @relation(fields: [bank_account_id], references: [id])
  statement_id    Int?
  statement       BankStatement? @relation(fields: [statement_id], references: [id])

  transaction_date DateTime  @db.Date
  value_date       DateTime? @db.Date
  direction        String    @db.VarChar(3) // in, out
  amount           Decimal   @db.Decimal(14, 2)
  currency         String    @default("CZK") @db.VarChar(3)

  counterparty_name    String? @db.VarChar(255)
  counterparty_account String? @db.VarChar(50)
  variable_symbol      String? @db.VarChar(20)
  constant_symbol      String? @db.VarChar(10)
  specific_symbol      String? @db.VarChar(20)
  message              String? @db.VarChar(255)
  reference            String? @db.VarChar(100) // reference banky (unikátní ID transakce)

  // unmatched, matched, ignored, needs_review
  match_status  String        @default("unmatched") @db.VarChar(20)
  // vs, amount_partner, manual, rule
  match_method  String?       @db.VarChar(20)
  match_rule_id Int?
  match_rule    MatchingRule? @relation(fields: [match_rule_id], references: [id])

  // Jedna transakce = 0 nebo 1 Payment (1:1)
  payment Payment?

  note           String?   @db.Text
  resolved_by_id Int?
  resolved_at    DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([bank_account_id, reference])
  @@index([transaction_date])
  @@index([match_status])
  @@index([variable_symbol])
  @@index([counterparty_account])
  @@map("bank_transactions")
}

// Pravidlo pro automatické párování opakovaných plateb (nájem, pojistky, trvalé příkazy).
model MatchingRule {
  id       Int     @id @default(autoincrement())
  name     String  @db.VarChar(255)
  priority Int     @default(100)
  active   Boolean @default(true)

  // Kritéria
  direction                  String?  @db.VarChar(3) // in, out
  counterparty_account       String?  @db.VarChar(50)
  counterparty_name_contains String?  @db.VarChar(255)
  variable_symbol            String?  @db.VarChar(20)
  amount_min                 Decimal? @db.Decimal(14, 2)
  amount_max                 Decimal? @db.Decimal(14, 2)

  // Akce
  // ignore, auto_match_invoice, auto_match_cost_center, notify
  action         String @db.VarChar(30)
  cost_center_id Int?
  assignee_id    Int?

  transactions BankTransaction[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([active, priority])
  @@map("matching_rules")
}

// =============================================================================
// POKLADNA
// =============================================================================

model CashRegister {
  id                 Int       @id @default(autoincrement())
  name               String    @db.VarChar(100)
  currency           String    @default("CZK") @db.VarChar(3)
  location           String?   @db.VarChar(255)
  responsible_id     Int?
  responsible        Person?   @relation("CashRegisterResponsible", fields: [responsible_id], references: [id])
  opening_balance    Decimal   @default(0) @db.Decimal(12, 2)
  current_balance    Decimal   @default(0) @db.Decimal(12, 2)
  last_reconciled_at DateTime?
  active             Boolean   @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  movements CashMovement[]
  payments  Payment[]      @relation("PaymentCashRegister")

  @@index([active])
  @@map("cash_registers")
}

model CashMovement {
  id               Int          @id @default(autoincrement())
  cash_register_id Int
  cash_register    CashRegister @relation(fields: [cash_register_id], references: [id])
  date             DateTime     @db.Date
  document_number  String       @unique @db.VarChar(30) // P2026000123 / V2026000123
  direction        String       @db.VarChar(3) // in, out
  amount           Decimal      @db.Decimal(12, 2)
  // invoice_payment, fuel, salary_advance, petty_cash_top_up, sale, refund, other
  purpose          String       @db.VarChar(50)
  description      String       @db.VarChar(500)

  // Volitelné vazby
  invoice_id     Int?
  invoice        Invoice?    @relation("CashMovementInvoice", fields: [invoice_id], references: [id])
  cost_center_id Int?
  cost_center    CostCenter? @relation("CashMovementCostCenter", fields: [cost_center_id], references: [id])

  receipt_file_path String? @db.VarChar(500) // naskenovaný paragon

  created_by_id Int?
  created_by    Person? @relation("CashMovementCreator", fields: [created_by_id], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([cash_register_id, date])
  @@index([invoice_id])
  @@map("cash_movements")
}

// =============================================================================
// E-MAIL INGEST + OCR
// =============================================================================

// Přijatý e-mail s potenciální fakturou (mailbox faktury@bestseries.cz).
model EmailIngest {
  id          Int      @id @default(autoincrement())
  mailbox     String   @db.VarChar(255)
  message_id  String   @unique @db.VarChar(255) // RFC 5322 Message-ID
  thread_id   String?  @db.VarChar(255)
  from_email  String   @db.VarChar(255)
  from_name   String?  @db.VarChar(255)
  to_email    String   @db.VarChar(255)
  subject     String   @db.VarChar(500)
  body_text   String?  @db.Text
  body_html   String?  @db.Text
  received_at DateTime
  fetched_at  DateTime @default(now())

  // received → parsing → extracting → awaiting_review
  //         → linked_to_invoice | unreadable | spam | duplicate | processed
  status String @default("received") @db.VarChar(30)

  confidence Decimal? @db.Decimal(4, 3)
  attempts   Int      @default(0)

  // Upozornění odesílateli (nečitelný doklad)
  sender_notified_at   DateTime?
  sender_notify_reason String?   @db.VarChar(255)

  note String? @db.Text

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  attachments EmailAttachment[]
  invoices    Invoice[]         @relation("InvoiceEmailIngest")
  extractions OcrExtraction[]   @relation("OcrForEmailIngest")

  @@index([status, received_at])
  @@index([mailbox])
  @@map("email_ingests")
}

model EmailAttachment {
  id                   Int         @id @default(autoincrement())
  email_ingest_id      Int
  email_ingest         EmailIngest @relation(fields: [email_ingest_id], references: [id], onDelete: Cascade)
  filename             String      @db.VarChar(500)
  content_type         String      @db.VarChar(100)
  size_bytes           Int
  file_path            String      @db.VarChar(500)
  source               String      @default("attachment") @db.VarChar(20) // attachment, link_download
  source_url           String?     @db.VarChar(1000)
  sha256               String?     @db.VarChar(64)
  is_invoice_candidate Boolean     @default(false)

  created_at DateTime @default(now())

  extractions OcrExtraction[] @relation("OcrForAttachment")

  @@index([email_ingest_id])
  @@index([sha256])
  @@map("email_attachments")
}

// Jeden pass extrakce (multi-pass pipeline pro vysokou jistotu).
model OcrExtraction {
  id              Int              @id @default(autoincrement())
  email_ingest_id Int?
  email_ingest    EmailIngest?     @relation("OcrForEmailIngest", fields: [email_ingest_id], references: [id])
  attachment_id   Int?
  attachment      EmailAttachment? @relation("OcrForAttachment", fields: [attachment_id], references: [id])
  invoice_id      Int?
  invoice         Invoice?         @relation("OcrForInvoice", fields: [invoice_id], references: [id])

  pass_number    Int
  // claude_vision_header, claude_vision_lines, ares_lookup, vies_lookup,
  // vat_math_check, duplicate_check, link_follow
  pass_type      String  @db.VarChar(50)
  model_used     String? @db.VarChar(50) // claude-sonnet-4-6, claude-opus-4-6
  extracted_data Json
  confidence     Decimal @db.Decimal(4, 3)
  warnings       Json?
  errors         Json?

  input_tokens  Int?
  output_tokens Int?
  cost_czk      Decimal? @db.Decimal(8, 4)

  executed_at DateTime @default(now())
  duration_ms Int?

  @@index([email_ingest_id])
  @@index([invoice_id])
  @@index([pass_type])
  @@map("ocr_extractions")
}

// =============================================================================
// UPOMÍNKY (Fáze 7)
// =============================================================================

model Reminder {
  id            Int       @id @default(autoincrement())
  invoice_id    Int
  invoice       Invoice   @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  level         Int // 1, 2, 3
  scheduled_at  DateTime
  sent_at       DateTime?
  sent_to_email String?   @db.VarChar(255)
  subject       String    @db.VarChar(255)
  body          String    @db.Text
  // scheduled, sent, bounced, cancelled
  status        String    @default("scheduled") @db.VarChar(20)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([invoice_id, level])
  @@index([status, scheduled_at])
  @@map("reminders")
}

// =============================================================================
// ODEVZDÁNÍ ÚČETNÍ FIRMĚ (Fáze 10) — měsíční ZIP balíček
// =============================================================================

model AccountantHandover {
  id           Int    @id @default(autoincrement())
  period_month Int // 1–12
  period_year  Int
  // preparing → ready → sent → confirmed_by_accountant → closed
  status       String @default("preparing") @db.VarChar(30)

  document_count Int     @default(0)
  total_received Decimal @default(0) @db.Decimal(14, 2)
  total_issued   Decimal @default(0) @db.Decimal(14, 2)
  total_cash     Decimal @default(0) @db.Decimal(14, 2)

  zip_file_path String? @db.VarChar(500)
  checklist     Json // [{ item, done: bool, note }]

  sent_at       DateTime?
  sent_to_email String?   @db.VarChar(255)
  confirmed_at  DateTime?
  note          String?   @db.Text

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  items AccountantHandoverItem[]

  @@unique([period_year, period_month])
  @@index([status])
  @@map("accountant_handovers")
}

model AccountantHandoverItem {
  id            Int                @id @default(autoincrement())
  handover_id   Int
  handover      AccountantHandover @relation(fields: [handover_id], references: [id], onDelete: Cascade)
  // invoice_received | invoice_issued | cash_movement_summary | bank_statement | other
  document_type String             @db.VarChar(30)
  document_id   Int

  // Volitelná silná vazba na Invoice (pro AP/AR)
  invoice_id Int?
  invoice    Invoice? @relation("HandoverItemInvoice", fields: [invoice_id], references: [id])

  file_path String? @db.VarChar(500)
  included  Boolean @default(true)
  note      String? @db.VarChar(500)

  created_at DateTime @default(now())

  @@index([handover_id])
  @@index([document_type, document_id])
  @@map("accountant_handover_items")
}

// =============================================================================
// APLIKAČNÍ NASTAVENÍ (key/value)
// =============================================================================
// Universální key/value úložiště pro user-configurable parametry, které:
//  - nejsou per-uživatel (pro to máme User.preferences),
//  - nejsou tajné/secret (pro to máme .env / secret store),
//  - mohou se měnit za běhu bez nasazení (např. limity, prahy, default volby).
//
// Klíče používáme dot-notation per modul (např. "accounting.payment_batch.approval_limit_czk").
// Hodnota je string — typování v aplikaci přes services/settings.js helper.

model AppSetting {
  id          Int     @id @default(autoincrement())
  key         String  @unique @db.VarChar(120)
  value       String  @db.Text
  value_type  String  @default("string") @db.VarChar(20) // string, number, boolean, json
  description String? @db.Text
  scope       String? @db.VarChar(50)

  updated_by_user_id Int?
  updated_by         User? @relation("AppSettingUpdater", fields: [updated_by_user_id], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([scope])
  @@map("app_settings")
}

// =============================================================================
// PLÁNOVAČ — KOMPETENCE (katalog dovedností + matice operace × člověk)
// =============================================================================

// Katalog dovedností (svařování MIG, pájení bondů, montáž rámu, programování PLC, ...).
// Každá kompetence má levely 1..level_max (1 = junior, 2 = standard, 3 = senior/instruktor).
model Competency {
  id          Int     @id @default(autoincrement())
  code        String  @unique @db.VarChar(50) // SVAR_MIG, PAJ_BOND, MONT_RAM, ...
  name        String  @db.VarChar(120)
  category    String? @db.VarChar(50) // svarovna, montaz, elektro, kontrola, ...
  description String? @db.Text
  level_max   Int     @default(3)
  active      Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Reverzní relace
  worker_competencies     WorkerCompetency[]
  required_for_operations OperationRequiredCompetency[]

  @@index([category])
  @@index([active])
  @@map("competencies")
}

// Plná matice: jaké kompetence (a na jakém levelu) má daný pracovník.
// UNIQUE(person, competency) — pracovník může mít každou kompetenci max. jednou.
// valid_until je volitelný (kompetence může být časově omezená — např. ČSN, certifikace).
model WorkerCompetency {
  id            Int       @id @default(autoincrement())
  person_id     Int
  competency_id Int
  level         Int       @default(1) // 1..Competency.level_max
  certified_at  DateTime? @db.Date
  valid_until   DateTime? @db.Date
  note          String?   @db.Text

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  person     Person     @relation("WorkerCompetencyPerson", fields: [person_id], references: [id], onDelete: Cascade)
  competency Competency @relation(fields: [competency_id], references: [id], onDelete: Cascade)

  @@unique([person_id, competency_id])
  @@index([competency_id])
  @@map("worker_competencies")
}

// Plná matice: jaké kompetence (a min level) operace vyžaduje.
// UNIQUE(operation, competency) — operace má každou kompetenci max. jednou.
// Plánovač používá tuto tabulku pro filtrování úkolů v kiosku — pracovník vidí
// operaci jen pokud má všechny required_competencies na úrovni >= min_level.
model OperationRequiredCompetency {
  id            Int @id @default(autoincrement())
  operation_id  Int
  competency_id Int
  min_level     Int @default(1) // 1..3

  created_at DateTime @default(now())

  operation  ProductOperation @relation(fields: [operation_id], references: [id], onDelete: Cascade)
  competency Competency       @relation(fields: [competency_id], references: [id], onDelete: Cascade)

  @@unique([operation_id, competency_id])
  @@index([competency_id])
  @@map("operation_required_competencies")
}

// =============================================================================
// PLÁNOVAČ — VÝROBNÍ DÁVKY & BOM SNAPSHOT
// =============================================================================

// Snapshot kusovníku produktu v okamžiku plánování dávky.
// Plánovač počítá MRP proti zamraženému BOM, aby pozdější změny BOM v Factorify
// neovlivnily už spuštěnou dávku.
// source: 'computed' | 'factorify_pull' | 'manual'
model BomSnapshot {
  id          Int      @id @default(autoincrement())
  product_id  Int
  variant_key String?  @db.VarChar(255) // "ram:nerez|barva:bila" pro variantní BOM
  snapshot_at DateTime @default(now())
  source      String   @default("computed") @db.VarChar(30)
  source_ref  String?  @db.VarChar(255) // Factorify run-id apod.
  note        String?  @db.Text

  product Product           @relation(fields: [product_id], references: [id])
  items   BomSnapshotItem[]
  batches ProductionBatch[] @relation("BatchBomSnapshot")

  @@index([product_id])
  @@index([snapshot_at])
  @@map("bom_snapshots")
}

// Položka snapshotu — řádek BOM (materiál × množství × kontext operace).
// depth = úroveň zanoření v BOM (0 = top-level, 1 = poloprodukt, 2 = surovina, ...).
// source_operation_id ukazuje, ve které operaci se materiál spotřebuje.
model BomSnapshotItem {
  id                  Int     @id @default(autoincrement())
  snapshot_id         Int
  material_id         Int
  source_operation_id Int?
  quantity            Decimal @db.Decimal(12, 4)
  unit                String  @default("ks") @db.VarChar(20)
  depth               Int     @default(0)

  snapshot         BomSnapshot       @relation(fields: [snapshot_id], references: [id], onDelete: Cascade)
  material         Material          @relation(fields: [material_id], references: [id])
  source_operation ProductOperation? @relation("BomSnapshotItemOperation", fields: [source_operation_id], references: [id])

  @@index([snapshot_id])
  @@index([material_id])
  @@index([source_operation_id])
  @@map("bom_snapshot_items")
}

// Výrobní dávka — jednotka plánu, ke které se přiřazují BatchOperation a Stock pohyby.
// batch_number formát: DV-{rok}-W{week}-{seq} (např. DV-2026-W18-001), generuje se při create.
// batch_type: 'main' (montáž), 'feeder' (předmontáž), 'subassembly'.
// status: 'planned' → 'released' → 'in_progress' → 'paused' → 'done' / 'cancelled'.
// parent_batch_id: feeder dávka odkazuje na hlavní dávku, kterou živí.
// bom_snapshot_id: snapshot BOM použitý pro plánování této dávky (frozen view).
model ProductionBatch {
  id           Int     @id @default(autoincrement())
  batch_number String  @unique @db.VarChar(50)
  product_id   Int
  variant_key  String? @db.VarChar(255)
  quantity     Int
  batch_type   String  @default("main") @db.VarChar(20)
  status       String  @default("planned") @db.VarChar(20)
  priority     Int     @default(100)

  planned_start DateTime?
  planned_end   DateTime?
  actual_start  DateTime?
  actual_end    DateTime?

  parent_batch_id Int?
  bom_snapshot_id Int?
  created_by_id   Int?

  note String? @db.Text

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  product        Product           @relation("BatchProduct", fields: [product_id], references: [id])
  parent_batch   ProductionBatch?  @relation("BatchFeederHierarchy", fields: [parent_batch_id], references: [id])
  feeder_batches ProductionBatch[] @relation("BatchFeederHierarchy")
  bom_snapshot   BomSnapshot?      @relation("BatchBomSnapshot", fields: [bom_snapshot_id], references: [id])
  created_by     Person?           @relation("BatchCreatedBy", fields: [created_by_id], references: [id])

  // Reverzní — instance operací této dávky
  batch_operations BatchOperation[]
  // Reverzní — slot assignments (které sloty tato dávka pokrývá)
  slot_assignments SlotAssignment[] @relation("SlotAssignmentBatch")

  @@index([product_id])
  @@index([status])
  @@index([batch_type])
  @@index([planned_start])
  @@index([parent_batch_id])
  @@index([bom_snapshot_id])
  @@map("production_batches")
}

// Instance operace pro konkrétní dávku — to, co pracovník v kiosku vidí jako úkol.
// sequence kopíruje ProductOperation.step_number, ale plánovač ho může měnit (paralelní operace).
// status: 'pending' (závislosti nesplněné) → 'ready' (lze startovat) → 'in_progress' → 'done',
//         'blocked' (chybí materiál / lidi / kompetence).
// duration_minutes je skutečně naměřený čas — používá se pro kalibraci ProductOperation.duration.
model BatchOperation {
  id             Int  @id @default(autoincrement())
  batch_id       Int
  operation_id   Int
  workstation_id Int?
  sequence       Int

  status String @default("pending") @db.VarChar(20)

  planned_start DateTime?
  planned_end   DateTime?

  assigned_person_id Int?
  started_at         DateTime?
  finished_at        DateTime?
  duration_minutes   Int? // skutečné trvání pro kalibraci

  note String? @db.Text

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  batch           ProductionBatch  @relation(fields: [batch_id], references: [id], onDelete: Cascade)
  operation       ProductOperation @relation(fields: [operation_id], references: [id])
  workstation     Workstation?     @relation(fields: [workstation_id], references: [id])
  assigned_person Person?          @relation("BatchOperationAssignee", fields: [assigned_person_id], references: [id])

  logs BatchOperationLog[]

  @@index([batch_id])
  @@index([operation_id])
  @@index([workstation_id])
  @@index([status])
  @@index([assigned_person_id])
  @@map("batch_operations")
}

// Auditní log akcí v kiosku — start, pause, resume, done, problem.
// Slouží jako zdroj pravdy pro výpočet fakticky odpracovaných hodin
// a pro reporting prostojů.
model BatchOperationLog {
  id                 Int     @id @default(autoincrement())
  batch_operation_id Int
  person_id          Int?
  action             String  @db.VarChar(30) // start, pause, resume, done, problem, comment
  note               String? @db.Text

  created_at DateTime @default(now())

  batch_operation BatchOperation @relation(fields: [batch_operation_id], references: [id], onDelete: Cascade)
  person          Person?        @relation("BatchOperationLogPerson", fields: [person_id], references: [id])

  @@index([batch_operation_id])
  @@index([person_id])
  @@index([action])
  @@index([created_at])
  @@map("batch_operation_logs")
}

// =============================================================================
// FACTORIFY SESTAVA ZBOŽÍ (FY BOM) — referenční snímek importovaný z exportu
// Factorify > Sestava zboží. Read-only přehled, ne zdroj pravdy pro plánování.
// 1:1 s Product (last-import wins, žádné verzování).
// =============================================================================

model ProductFyBom {
  id              Int      @id @default(autoincrement())
  product_id      Int      @unique
  imported_at     DateTime @default(now())
  imported_by_id  Int? // User.id, kdo import provedl
  imported_by     String?  @db.VarChar(120) // display name pro snadný výpis
  source_filename String?  @db.VarChar(255)
  row_count       Int      @default(0)
  note            String?  @db.Text

  product Product            @relation(fields: [product_id], references: [id], onDelete: Cascade)
  items   ProductFyBomItem[]

  @@map("product_fy_boms")
}

// Položka FY sestavy — surová data z Factorify exportu, žádný join na HolyOS
// materiály. Identifikujeme podle factorify_item_id + level (Úroveň ve stromu).
model ProductFyBomItem {
  id                   Int      @id @default(autoincrement())
  fy_bom_id            Int
  level                String?  @db.VarChar(20) // Úroveň, např. "1", "1. 1", "1.10"
  factorify_item_id    Int? // ID zboží z Factorify
  name                 String   @db.VarChar(500) // sloupec Zboží
  quantity             Decimal? @db.Decimal(14, 4)
  unit                 String?  @db.VarChar(20)
  item_type            String?  @db.VarChar(50) // Typ (Výrobek, Materiál, ...)
  keywords             String?  @db.Text
  status               String?  @db.VarChar(50) // Stav (Aktivní, ...)
  photo                String?  @db.VarChar(500)
  ignore_stock         Boolean  @default(false) // Nehlídat dostupnost
  used_in_operations   String?  @db.Text // Použito v operacích
  used_at_workstations String?  @db.Text // Použito na pracovištích
  is_purchasable       Boolean  @default(false)
  has_workflow         Boolean  @default(false)
  drawing              String?  @db.VarChar(500)
  drawing_is_draft     Boolean  @default(false)
  defined_in           String?  @db.VarChar(120) // Workflow / Drawing
  position             String?  @db.VarChar(120)
  row_index            Int // pořadí řádku v exportu (zachovat původní pořadí)

  fy_bom ProductFyBom @relation(fields: [fy_bom_id], references: [id], onDelete: Cascade)

  @@index([fy_bom_id, row_index])
  @@index([factorify_item_id])
  @@map("product_fy_bom_items")
}

// =============================================================================
// FACTORIFY MIGRACE — projekty, nákupní ceník
// Naplněno scriptem scripts/import-from-factorify.js v rámci jednorázové migrace
// dat ze Factorify do HolyOS (sklad + nákup). Idempotentní upsert přes factorify_id.
// =============================================================================

// Projekt — Factorify Project (208 záznamů). Vázán na Order a WarehouseDocument.
model Project {
  id     Int     @id @default(autoincrement())
  code   String? @db.VarChar(50)
  name   String  @db.VarChar(255)
  active Boolean @default(true)
  note   String? @db.Text

  factorify_id String? @db.VarChar(100)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  orders              Order[]             @relation("OrderProject")
  warehouse_documents WarehouseDocument[] @relation("WarehouseDocumentProject")

  @@index([factorify_id])
  @@index([code])
  @@map("projects")
}

// Nákupní ceník dodavatele — Factorify BuyingPriceList.
// Jeden záznam = kombinace (supplier × material × validita). Items obsahují
// množstevní cenové tiery (např. 1+ ks za 100 Kč, 100+ ks za 90 Kč).
model SupplierPriceList {
  id                Int       @id @default(autoincrement())
  supplier_id       Int // Company FK (dodavatel)
  material_id       Int // Material FK
  valid_from        DateTime? @db.Date
  valid_to          DateTime? @db.Date
  is_primary        Boolean   @default(false) // primární ceník (default supplier pro materiál)
  is_valid          Boolean   @default(true) // valid flag z Factorify
  country_of_origin String?   @db.VarChar(2)
  note              String?   @db.Text

  factorify_id String? @db.VarChar(100)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  supplier Company                 @relation("SupplierPriceListSupplier", fields: [supplier_id], references: [id])
  material Material                @relation(fields: [material_id], references: [id])
  items    SupplierPriceListItem[]

  @@index([factorify_id])
  @@index([supplier_id])
  @@index([material_id])
  @@index([is_primary])
  @@map("supplier_price_lists")
}

// Položka nákupního ceníku — množstevní cenový tier.
// Faktorify BuyingPriceListItem (1329 záznamů). quantity_min může být null = base price.
model SupplierPriceListItem {
  id                       Int      @id @default(autoincrement())
  price_list_id            Int
  quantity_min             Decimal? @db.Decimal(12, 2) // minimální množství tieru (null = bez podmínky)
  price                    Decimal  @db.Decimal(12, 4) // cena za jednotku
  currency                 String   @default("CZK") @db.VarChar(3)
  additional_cost          Decimal? @db.Decimal(12, 4) // doprava / clo
  additional_cost_currency String?  @db.VarChar(3)
  min_order_quantity       Decimal? @db.Decimal(12, 2)
  delivery_time_days       Int?
  supplier_part_no         String?  @db.VarChar(100) // orderNo — kódovací číslo dodavatele

  factorify_id String? @db.VarChar(100)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  price_list SupplierPriceList @relation(fields: [price_list_id], references: [id], onDelete: Cascade)

  @@index([factorify_id])
  @@index([price_list_id])
  @@map("supplier_price_list_items")
}

// =============================================================================
// NORMOVÁNÍ — měření TAC + Tpz na pracovišti přes mobil
// =============================================================================
// Modul `modules/normovani-fy`: normátor přijde na pracoviště, naskenuje/zadá
// číslo dávky, vybere operaci a měří start/konec u jednotlivých dílů.
// FY je READ-ONLY — všechny start/end události žijí výhradně tady.
// FY identifikátory držíme jako stringy bez FK, aby záznamy zůstaly intaktní
// i když se FY data změní (přejmenování operace, smazání BOM atd.).

model NormovaniSession {
  id Int @id @default(autoincrement())

  // Kdo měří
  person_id Int

  // FY reference (jen jako identifikátory, ne FK)
  fy_batch_id       String  @db.VarChar(50) // = Batch.id (= Batch.number)
  fy_batch_number   String  @db.VarChar(50) // duplicitně pro lidsky čitelný export
  fy_goods_id       String? @db.VarChar(50) // Batch.goods.id
  fy_goods_code     String? @db.VarChar(100) // Batch.goods.code (BS-S-0381)
  fy_goods_name     String? @db.VarChar(500) // Batch.goods.name
  fy_workflow_id    String? @db.VarChar(50) // Batch.workflow.id
  fy_operation_id   String  @db.VarChar(50) // WorkflowOperation.id zvolené operace
  fy_operation_name String? @db.VarChar(500) // WorkflowOperation.operationName

  // Pracoviště (z WorkflowOperation.stage.referenceName, např. "Lakovací BOX")
  workplace_label String? @db.VarChar(255)

  // Časová razítka
  started_at DateTime  @default(now())
  ended_at   DateTime?

  // active = právě měří, paused = pauznuto, done = ukončeno, abandoned = zrušeno
  status String @default("active") @db.VarChar(20)

  notes String? @db.Text

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  person Person           @relation("NormovaniSessionPerson", fields: [person_id], references: [id])
  events NormovaniEvent[] @relation("NormovaniSessionEvents")

  @@index([person_id])
  @@index([fy_batch_id])
  @@index([fy_operation_id])
  @@index([status])
  @@index([started_at])
  @@map("normovani_sessions")
}

model NormovaniEvent {
  id         Int @id @default(autoincrement())
  session_id Int

  // start = chytl díl do ruky, end = díl namontován/dokončen
  event_type String @db.VarChar(10)

  // FY OperationBillOfMaterialsItem reference (string, ne FK)
  fy_item_id  String   @db.VarChar(50) // BOM item.id z FY (např. 46669)
  fy_goods_id String?  @db.VarChar(50) // BOM item.goods.id (např. 973)
  item_code   String?  @db.VarChar(100) // goods.code (např. NA0692)
  item_name   String?  @db.VarChar(500) // goods.name
  item_unit   String?  @db.VarChar(20) // goods.unit (l, ks, m...)
  item_qr     String?  @db.VarChar(255) // QR kód, pokud byl pro vyhledání naskenován
  quantity    Decimal? @db.Decimal(12, 4) // očekávané množství z BOM (pro export)

  occurred_at DateTime @default(now())

  notes String? @db.Text

  created_at DateTime @default(now())

  session NormovaniSession @relation("NormovaniSessionEvents", fields: [session_id], references: [id], onDelete: Cascade)

  @@index([session_id, occurred_at])
  @@index([fy_item_id])
  @@index([event_type])
  @@map("normovani_events")
}

// =============================================================================
// METODICKÉ POKYNY A SMĚRNICE
// =============================================================================
// Centrální evidence interních směrnic, metodických pokynů a postupů.
// Každý dokument má kód, název, kategorii, verzi a stav. Podporuje
// libovolný počet příloh (PDF, Word, atd.) přes /api/storage/upload.

model Directive {
  id             Int       @id @default(autoincrement())
  code           String    @unique @db.VarChar(50) // např. "SM-001", "MP-HR-002"
  title          String    @db.VarChar(500) // krátký název směrnice
  category       String    @default("obecne") @db.VarChar(50) // obecne, hr, vyroba, sklad, kvalita, bozp, atd.
  content        String?   @db.Text // tělo směrnice (markdown / HTML)
  version        String    @default("1.0") @db.VarChar(20) // verze dokumentu
  status         String    @default("draft") @db.VarChar(20) // draft, active, archived
  effective_from DateTime? @db.Date // platnost od
  effective_to   DateTime? @db.Date // platnost do
  tags           Json? // pole stringů — volné štítky
  attachments    Json? // [{ url, name, size, mime }, ...]

  // Audit
  created_by Int?
  updated_by Int?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([category])
  @@index([status])
  @@index([code])
  @@map("directives")
}

// =============================================================================
// AI VÝVOJÁŘ — autonomní agent, který přijímá úkoly z AdminTask, kódí v sandboxu
// a otevírá PR. UI v super admin sekci, komunikace přes ChatChannel typu 'task'.
// Viz docs/ai-vyvojar/brief-v1.md a docs/ai-vyvojar/plan-faze-1.md.
// =============================================================================

// Singleton — nastavení agenta (limity, master switch). Vždy id=1.
model AgentSettings {
  id                      Int     @id @default(1)
  enabled                 Boolean @default(false) // Master kill switch
  default_autonomy        String  @default("pr_review") @db.VarChar(20) // full_auto | pr_review | plan_review
  max_concurrent_runs     Int     @default(1)
  max_runs_per_day        Int     @default(5)
  daily_token_budget      Int     @default(1000000) // hrubý strop pro tokens_used / den
  default_timeout_minutes Int     @default(30)
  max_commits_per_run     Int     @default(10) // pojistka proti zacyklení
  auto_merge_wait_minutes Int     @default(15)

  updated_by Int?
  updated_at DateTime @updatedAt

  updater User? @relation("AgentSettingsUpdater", fields: [updated_by], references: [id], onDelete: SetNull)

  @@map("agent_settings")
}

// Cílová repozitoria, ve kterých agent smí pracovat. CRUD ze super admin UI.
model AgentRepo {
  id                 String   @id @default(uuid())
  name               String   @db.VarChar(100) // "SIS", "holyos-ai-playground"
  git_url            String   @db.VarChar(500) // SSH nebo HTTPS URL
  default_branch     String   @default("main") @db.VarChar(100)
  protected_branches String[] @default([]) // do těchto větví agent přímo nepushne
  allow_auto_merge   Boolean  @default(false)
  required_checks    String[] @default([]) // jména GitHub Actions / checks, která musí projít
  tech_stack         Json? // { runtime, tests, lint, ... } — informativně pro agenta
  active             Boolean  @default(true)

  created_by Int?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  creator User?       @relation("AgentRepoCreator", fields: [created_by], references: [id], onDelete: SetNull)
  runs    AgentRun[]
  tasks   AdminTask[]

  @@index([active])
  @@map("agent_repos")
}

// Jeden řádek = jeden běh agenta nad jedním AdminTaskem.
model AgentRun {
  id             String    @id @default(uuid())
  task_id        Int
  repo_id        String?
  status         String    @default("queued") @db.VarChar(30) // queued | triaging | awaiting_clarification | planning | coding | testing | pr_open | merged | completed | failed | cancelled | escalated
  autonomy_mode  String    @default("pr_review") @db.VarChar(20) // snapshot v okamžiku spuštění
  started_at     DateTime  @default(now())
  ended_at       DateTime?
  container_id   String?   @db.VarChar(100) // pro Fázi 2 (Docker)
  branch         String?   @db.VarChar(255) // ai/REQ-{id}-{slug}
  pr_url         String?   @db.VarChar(500)
  pr_number      Int?
  tokens_used    Int       @default(0)
  commits_count  Int       @default(0)
  failure_reason String?   @db.Text
  summary        String?   @db.Text // krátký final summary po dokončení

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  task      AdminTask       @relation("AdminTaskAgentRuns", fields: [task_id], references: [id], onDelete: Cascade)
  repo      AgentRepo?      @relation(fields: [repo_id], references: [id], onDelete: SetNull)
  events    AgentRunEvent[]
  approvals AgentApproval[]

  @@index([task_id])
  @@index([status])
  @@index([started_at])
  @@map("agent_runs")
}

// Detailní audit log běhu — každý významný krok (tool call, commit, error, ...).
model AgentRunEvent {
  id      String   @id @default(uuid())
  run_id  String
  at      DateTime @default(now())
  kind    String   @db.VarChar(50) // tool_call | file_change | commit | question_to_user | rule_blocked | error | decision | llm_message
  payload Json? // strukturovaná data k události

  run AgentRun @relation(fields: [run_id], references: [id], onDelete: Cascade)

  @@index([run_id, at])
  @@index([kind])
  @@map("agent_run_events")
}

// Pravidla, co agent smí / nesmí / vyžaduje schválení. Editovatelné z UI
// (modul AI Vývojář → záložka Pravidla). Načítají se per-run z DB do paměti
// agenta (žádný hot-reload uvnitř běžícího runu — pravidla se mění zřídka).
//
// Fáze 1: jen kind='forbidden' + scope='path_pattern' jsou implementované
// (nahrazují hardcoded FORBIDDEN_PATTERNS v services/ai-developer/agent.js).
// kind='requires_approval' a 'allowed' jsou ve schématu pro Fázi 2 (approval
// workflow), zatím se na ně neaplikuje žádný backend check.
//
// scope='module' / 'operation_type' / 'db_table' / 'repo' jsou rezerva pro
// Fázi 2/3 — backend check zatím neumí. value='*' nebo prefix-match logiku
// si dopíšeme, až bude potřeba.
model AgentRule {
  id            String  @id @default(uuid())
  kind          String  @db.VarChar(30) // forbidden | requires_approval | allowed
  scope         String  @db.VarChar(30) // path_pattern | module | operation_type | db_table | repo
  value         String  @db.Text // regex pattern (bez /.../ obalu) nebo název modulu / operace
  description   String? @db.Text // popis pro člověka (proč pravidlo existuje)
  active        Boolean @default(true)
  blocked_count Int     @default(0) // kolikrát toto pravidlo zablokovalo agenta — pro statistiku v UI

  created_by Int?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  creator User? @relation("AgentRuleCreator", fields: [created_by], references: [id], onDelete: SetNull)

  @@index([kind, scope, active])
  @@map("agent_rules")
}

// Schvalovací fronta — když agent narazí na akci spadající pod kind=requires_approval
// rule, runner se zastaví na status='awaiting_approval' a vytvoří AgentApproval
// (decision='pending'). Super-admin v UI klikne Schválit / Zamítnout; worker při
// dalším poll cyklu run zvedne podle decision (approved → pokračuj, rejected →
// status='escalated'). MVP této tabulky bez napojení na runner — auto-tvorba a
// resume workflow přijdou v další session. Zatím lze přes UI ručně testovat
// list/decide flow.
model AgentApproval {
  id           String    @id @default(uuid())
  run_id       String
  kind         String    @db.VarChar(30) // plan_review | pr_review | rule_override
  requested_at DateTime  @default(now())
  decided_at   DateTime?
  decided_by   Int?
  decision     String    @default("pending") @db.VarChar(20) // pending | approved | rejected | expired
  comment      String?   @db.Text
  payload      Json? // strukturovaný kontext: plán, diff, rule violation, ...

  run     AgentRun @relation(fields: [run_id], references: [id], onDelete: Cascade)
  decider User?    @relation("AgentApprovalDecider", fields: [decided_by], references: [id], onDelete: SetNull)

  @@index([run_id])
  @@index([decision])
  @@map("agent_approvals")
}

// =============================================================================
// OBCHODNÍ POMŮCKY — sdílení sales-aid nástrojů se zákazníky + tracking
// =============================================================================

model BusinessToolRecipient {
  id          Int       @id @default(autoincrement())
  tool        String    @db.VarChar(60) // 'pradlomat-economy', 'margin-calc', ...
  name        String    @db.VarChar(255)
  email       String    @db.VarChar(255)
  company     String?   @db.VarChar(255)
  note        String?   @db.Text
  share_token String    @unique @db.VarChar(80)
  created_by  Int?
  created_at  DateTime  @default(now())
  last_opened DateTime?
  open_count  Int       @default(0)
  save_count  Int       @default(0)

  // Když příjemce vznikl automaticky pro leada z compounder.world (Portal),
  // odkazuje na jeho CompounderLead.id — umožní sledovat ekonomiku per účet.
  compounder_lead_id Int?

  // Jazykové mutace dostupné na veřejné share stránce (např. ["cs","en","de","fr"]).
  // První kód v poli = výchozí jazyk při otevření odkazu. Default ["cs"].
  languages   String[]  @default(["cs"])

  // AI shrnutí chování zákazníka (cache; regenerace na vyžádání)
  ai_summary_text         String?   @db.Text
  ai_summary_generated_at DateTime?
  ai_summary_model        String?   @db.VarChar(60)

  creator User?               @relation("BusinessToolRecipientCreator", fields: [created_by], references: [id])
  models  BusinessToolModel[]
  events  BusinessToolEvent[]

  @@index([created_by])
  @@index([tool])
  @@index([share_token])
  @@index([compounder_lead_id])
  @@map("business_tool_recipients")
}

model BusinessToolModel {
  id            Int      @id @default(autoincrement())
  recipient_id  Int
  name          String   @default("Pracovní model") @db.VarChar(255)
  data_json     Json // snapshot vstupů (state)
  computed_json Json? // snapshot vypočítaných výstupů (volitelný, pro audit)
  saved_from    String   @default("customer") @db.VarChar(20) // 'customer' | 'admin'
  created_at    DateTime @default(now())

  recipient BusinessToolRecipient @relation(fields: [recipient_id], references: [id], onDelete: Cascade)

  @@index([recipient_id])
  @@map("business_tool_models")
}

model BusinessToolEvent {
  id           Int      @id @default(autoincrement())
  recipient_id Int
  event_type   String   @db.VarChar(30) // 'sent' | 'opened' | 'edited' | 'saved' | 'exported' | 'resent'
  payload      Json?
  ip           String?  @db.VarChar(45)
  user_agent   String?  @db.Text
  created_at   DateTime @default(now())

  recipient BusinessToolRecipient @relation(fields: [recipient_id], references: [id], onDelete: Cascade)

  @@index([recipient_id])
  @@index([event_type])
  @@index([created_at])
  @@map("business_tool_events")
}

// Globální výchozí hodnoty pomůcky (singleton per tool). Adminem nastavený
// startovací stav, který se použije pro každého nového příjemce + pro otevření
// nástroje v admin pohledu.
model BusinessToolDefaults {
  id         Int      @id @default(autoincrement())
  tool       String   @unique @db.VarChar(60)
  data_json  Json
  locks_json Json     @default("{}") // { field_key: true } — pole, která zákazník nesmí měnit
  updated_by Int?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  updater User? @relation("BusinessToolDefaultsUpdater", fields: [updated_by], references: [id], onDelete: SetNull)

  @@map("business_tool_defaults")
}

// =============================================================================
// NÁBOR — uchazeči o práci
// =============================================================================
//
// Evidence kandidátů, kteří mají zájem pracovat ve firmě. Zdroje:
//   - manuální zadání
//   - Meta (Facebook) Lead Ads webhook
//   - import z CSV
//
// Workflow status: new → contacted → interview → offer → hired / rejected
// Po stavu "hired" volitelně proběhne convert na Person (zachová se historie
// jako converted_person_id, applicant zůstane v DB jako archiv).
model JobApplicant {
  id         Int     @id @default(autoincrement())
  first_name String  @db.VarChar(255)
  last_name  String? @db.VarChar(255)
  email      String? @db.VarChar(255)
  phone      String? @db.VarChar(50)

  // Pozice o kterou má kandidát zájem (volný text — operátor, šička, řidič…)
  position      String? @db.VarChar(255)
  // Životopis — base64 (stejně jako Document.file_data)
  cv_data       String? @db.Text
  cv_filename   String? @db.VarChar(255)
  cv_mime       String? @db.VarChar(100)

  // Zdroj kandidáta: facebook_ads, manual, referral, web, other
  source        String  @default("manual") @db.VarChar(50)
  source_detail String? @db.VarChar(255) // např. ID kampaně, jméno doporučitele

  // Status náboru
  status        String  @default("new") @db.VarChar(30)
  // new | contacted | interview | offer | hired | rejected

  // Volné poznámky (souhrn — detailní komunikace jde do ApplicantNote)
  notes         String? @db.Text

  // Komu je uchazeč přiřazen (HR/náborář)
  assigned_to_id Int?
  assigned_to    Person? @relation("ApplicantAssignedTo", fields: [assigned_to_id], references: [id], onDelete: SetNull)

  // Po přijetí — odkaz na vytvořeného Person
  converted_person_id Int?     @unique
  converted_person    Person?  @relation("ApplicantConverted", fields: [converted_person_id], references: [id], onDelete: SetNull)
  converted_at        DateTime?

  // Meta Lead Ads — pokud kandidát přišel z FB webhooku
  meta_lead_id    String? @unique @db.VarChar(255)
  meta_form_id    String? @db.VarChar(255)
  meta_page_id    String? @db.VarChar(255)
  meta_ad_id      String? @db.VarChar(255)
  meta_raw        Json?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  applicant_notes ApplicantNote[]

  @@index([status])
  @@index([source])
  @@index([assigned_to_id])
  @@map("job_applicants")
}

// Časová osa komunikace s uchazečem — hovor, e-mail, schůzka, poznámka.
model ApplicantNote {
  id           Int      @id @default(autoincrement())
  applicant_id Int
  applicant    JobApplicant @relation(fields: [applicant_id], references: [id], onDelete: Cascade)

  // Kdo poznámku napsal (HR/náborář). Volitelné — webhooky píší bez autora.
  author_id Int?
  author    Person? @relation("ApplicantNoteAuthor", fields: [author_id], references: [id], onDelete: SetNull)

  // Typ kontaktu: call, email, meeting, sms, note, status_change, system
  kind    String  @default("note") @db.VarChar(30)
  content String  @db.Text

  // Pro status_change — odkud kam
  old_status String? @db.VarChar(30)
  new_status String? @db.VarChar(30)

  created_at DateTime @default(now())

  @@index([applicant_id])
  @@index([author_id])
  @@map("applicant_notes")
}

// =============================================================================
// MODUL OBCHOD — Sales CRM (potenciální zákazníci prádelen)
// =============================================================================

model SalesContact {
  id                   Int     @id @default(autoincrement())
  first_name           String  @db.VarChar(255)
  last_name            String? @db.VarChar(255)
  email                String? @db.VarChar(255)
  phone                String? @db.VarChar(50)
  company_name         String? @db.VarChar(255)
  position             String? @db.VarChar(255)
  web                  String? @db.VarChar(500)
  address              String? @db.VarChar(255)
  city                 String? @db.VarChar(100)
  zip                  String? @db.VarChar(10)
  source               String  @default("manual") @db.VarChar(50)
  source_detail        String? @db.VarChar(255)
  status               String  @default("new") @db.VarChar(30)
  potential            String  @default("medium") @db.VarChar(20)
  expected_value       Decimal? @db.Decimal(12, 2)
  next_action_at       DateTime?
  notes                String? @db.Text
  assigned_to_id       Int?
  assigned_to          Person? @relation("SalesContactAssignee", fields: [assigned_to_id], references: [id], onDelete: SetNull)
  converted_company_id Int?
  converted_company    Company? @relation("SalesContactConverted", fields: [converted_company_id], references: [id], onDelete: SetNull)
  converted_at         DateTime?
  meta_lead_id         String? @unique @db.VarChar(255)
  meta_form_id         String? @db.VarChar(255)
  meta_page_id         String? @db.VarChar(255)
  meta_ad_id           String? @db.VarChar(255)
  meta_raw             Json?
  linkedin_id          String? @db.VarChar(255)
  linkedin_url         String? @db.VarChar(500)
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  sales_notes  SalesContactNote[]
  sales_events SalesEvent[]
  assignments  SalesContactAssignment[]

  @@index([status])
  @@index([source])
  @@index([potential])
  @@index([assigned_to_id])
  @@index([converted_company_id])
  @@index([next_action_at])
  @@map("sales_contacts")
}

model SalesContactNote {
  id         Int          @id @default(autoincrement())
  contact_id Int
  contact    SalesContact @relation(fields: [contact_id], references: [id], onDelete: Cascade)

  author_id Int?
  author    Person? @relation("SalesNoteAuthor", fields: [author_id], references: [id], onDelete: SetNull)

  kind    String @default("note") @db.VarChar(30)
  content String @db.Text

  old_status String? @db.VarChar(30)
  new_status String? @db.VarChar(30)

  created_at DateTime @default(now())

  @@index([contact_id])
  @@index([author_id])
  @@map("sales_contact_notes")
}

model SalesEvent {
  id         Int           @id @default(autoincrement())
  contact_id Int?
  contact    SalesContact? @relation(fields: [contact_id], references: [id], onDelete: Cascade)

  organizer_id Int?
  organizer    Person? @relation("SalesEventOrganizer", fields: [organizer_id], references: [id], onDelete: SetNull)

  title       String  @db.VarChar(500)
  description String? @db.Text
  event_type  String  @default("meeting") @db.VarChar(30)
  location    String? @db.VarChar(500)

  start_at DateTime
  end_at   DateTime?
  all_day  Boolean   @default(false)

  status      String @default("planned") @db.VarChar(20)
  reminder_min Int?

  // Vazba na kontakt z obchodní agendy (volitelná — schůzka může být i samostatná).
  compounder_lead_id Int?
  site_id            Int?

  // Napojení na M365/Outlook událost (synchronizace přes Graph).
  graph_event_id      String? @db.VarChar(255)
  graph_calendar_user String? @db.VarChar(255)
  graph_sync_error    String? @db.Text
  attendees           String? @db.Text

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([contact_id])
  @@index([organizer_id])
  @@index([start_at])
  @@index([status])
  @@index([compounder_lead_id])
  @@index([site_id])
  @@map("sales_events")
}

// SalesContactAssignment — M:N přidělení obchodníka ke kontaktu + provize
// Jeden kontakt může mít více obchodníků (např. sdílený lead). Vedoucí obchodu
// nebo admin zde nastavují individuální % provize. Po zaplacení objednávky se
// hodnota uzamkne (locked_*) a další změny defaultu už neovlivní tento obchod.
model SalesContactAssignment {
  id         Int          @id @default(autoincrement())
  contact_id Int
  contact    SalesContact @relation(fields: [contact_id], references: [id], onDelete: Cascade)

  person_id Int
  person    Person @relation("SalesAssignmentPerson", fields: [person_id], references: [id], onDelete: Cascade)

  // Aktuální (default) % provize. Nastavuje vedoucí, mění se libovolně.
  commission_pct Decimal? @db.Decimal(5, 2)

  // Zafixovaná % v okamžiku, kdy byl obchod uzavřen (objednávka zaplacena).
  // Pokud je vyplněno, považuje se za neměnné — slouží pro výpočet vyplacených
  // provizí. Změna commission_pct po locked_at už neovlivní tento záznam.
  commission_locked_pct Decimal?  @db.Decimal(5, 2)
  commission_locked_at  DateTime?

  // Kdo přidělil (vedoucí / admin)
  assigned_by_id Int?
  assigned_by    Person? @relation("SalesAssignmentCreator", fields: [assigned_by_id], references: [id], onDelete: SetNull)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([contact_id, person_id])
  @@index([contact_id])
  @@index([person_id])
  @@map("sales_contact_assignments")
}

// =============================================================================
// SITE DEVELOPMENT — vyhledávání a řízení lokalit pro prádlomaty
// =============================================================================
// Hlavní entita: potenciální lokalita / pozemek. Uživatel ji zadá ručně nebo
// importem. Pracuje s ní (komunikace, fotky, finanční podmínky, katastr) a
// vyhodnocuje její vhodnost (skóre, status).
//
// Typy `site_type`: rent / purchase / other
// `status` pipeline: lead → researching → negotiating → contract → operational
//                    (boční: rejected, lost)
// =============================================================================

model Site {
  id Int @id @default(autoincrement())

  name        String  @db.VarChar(255)
  site_type   String  @default("rent") @db.VarChar(20)
  status      String  @default("lead") @db.VarChar(30)
  description String? @db.Text

  address      String? @db.VarChar(500)
  city         String? @db.VarChar(120)
  zip          String? @db.VarChar(10)
  country      String? @default("CZ") @db.VarChar(60)
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)
  map_link     String?  @db.Text

  owner_name    String? @db.VarChar(255)
  owner_phone   String? @db.VarChar(40)
  owner_email   String? @db.VarChar(255)
  owner_note    String? @db.Text
  // Poznámky obchodníka (editovatelný scratchpad, oddělené od owner_note zájemce).
  sales_notes   String? @db.Text
  company_id    Int?
  company       Company? @relation("SiteCompany", fields: [company_id], references: [id], onDelete: SetNull)

  rent_monthly         Decimal? @db.Decimal(12, 2)
  rent_currency        String?  @default("CZK") @db.VarChar(3)
  deposit              Decimal? @db.Decimal(12, 2)
  energy_deposit       Decimal? @db.Decimal(12, 2)
  energy_monthly       Decimal? @db.Decimal(12, 2)
  other_costs_monthly  Decimal? @db.Decimal(12, 2)
  purchase_price       Decimal? @db.Decimal(14, 2)
  contract_terms       String?  @db.Text
  contract_start       DateTime? @db.Date
  contract_end         DateTime? @db.Date

  area_m2          Decimal? @db.Decimal(10, 2)
  ceiling_height_m Decimal? @db.Decimal(5, 2)
  electricity_kw   Decimal? @db.Decimal(8, 2)
  water_supply     Boolean?
  sewage           Boolean?
  parking          Boolean?
  capacity_note    String?  @db.Text

  cadastral_area    String? @db.VarChar(255)
  cadastral_parcel  String? @db.VarChar(120)
  cadastral_lv      String? @db.VarChar(40)
  cadastral_link    String? @db.Text

  score            Int?
  pros             String? @db.Text
  cons             String? @db.Text
  rejection_reason String? @db.Text

  assigned_to_id Int?
  assigned_to    Person? @relation("SiteAssignee", fields: [assigned_to_id], references: [id], onDelete: SetNull)
  created_by_id  Int?
  created_by     Person? @relation("SiteCreator", fields: [created_by_id], references: [id], onDelete: SetNull)

  pradlomat_ref String? @db.VarChar(255)

  // ─── Nabídka lokality z veřejného webu bestseries.global ───────────────────
  // Zdroj veřejné nabídky (např. "bestseries.global"). null = interní záznam
  // založený obchodníkem. Podle tohoto pole filtruje záložka Lokality.
  public_source String? @db.VarChar(60)
  // Půdorys prádlomatu, který zájemce umístil na mapu. Střed obdélníku =
  // latitude/longitude výše. Rotace ve stupních (0 = zarovnáno sever-jih),
  // rozměry stroje v mm (výchozí 3182 × 2015 mm = 6,4 m²).
  footprint_rotation Decimal? @db.Decimal(6, 2)
  footprint_w_mm     Int?     @default(3182)
  footprint_h_mm     Int?     @default(2015)
  // Body přípojek, které zájemce označil na mapě (sloupky). JSON:
  // { electricity: {lat,lng}, water: {lat,lng}, sewage: {lat,lng} } — klíče volitelné.
  utility_points     Json?
  // Je zájemce vlastníkem místa/pozemku? true = ano, false = ne, null = neuvedeno.
  is_property_owner  Boolean?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  contacts        SiteContact[]
  communications  SiteCommunication[]
  photos          SitePhoto[]
  documents       SiteDocument[]

  @@index([status])
  @@index([site_type])
  @@index([city])
  @@index([assigned_to_id])
  @@index([created_by_id])
  @@index([company_id])
  @@index([created_at])
  @@index([public_source])
  @@map("sites")
}

model SiteContact {
  id      Int  @id @default(autoincrement())
  site_id Int
  site    Site @relation(fields: [site_id], references: [id], onDelete: Cascade)

  name        String  @db.VarChar(255)
  role        String? @db.VarChar(120)
  phone       String? @db.VarChar(40)
  email       String? @db.VarChar(255)
  company     String? @db.VarChar(255)
  note        String? @db.Text
  is_primary  Boolean @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([site_id])
  @@index([is_primary])
  @@map("site_contacts")
}

model SiteCommunication {
  id      Int  @id @default(autoincrement())
  site_id Int
  site    Site @relation(fields: [site_id], references: [id], onDelete: Cascade)

  channel    String   @default("note") @db.VarChar(20)
  subject    String?  @db.VarChar(500)
  body       String   @db.Text
  occurred_at DateTime @default(now())

  author_id Int?
  author    Person? @relation("SiteCommunicationAuthor", fields: [author_id], references: [id], onDelete: SetNull)

  followup_at DateTime?
  followup_done Boolean  @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([site_id])
  @@index([occurred_at])
  @@index([followup_at])
  @@index([channel])
  @@map("site_communications")
}

model SitePhoto {
  id      Int  @id @default(autoincrement())
  site_id Int
  site    Site @relation(fields: [site_id], references: [id], onDelete: Cascade)

  file_path    String  @db.VarChar(500)
  url          String? @db.VarChar(500)
  caption      String? @db.VarChar(500)
  mime_type    String? @db.VarChar(80)
  size_bytes   Int?
  sort_order   Int     @default(0)

  created_at DateTime @default(now())

  @@index([site_id])
  @@index([sort_order])
  @@map("site_photos")
}

model SiteDocument {
  id      Int  @id @default(autoincrement())
  site_id Int
  site    Site @relation(fields: [site_id], references: [id], onDelete: Cascade)

  doc_type   String  @default("other") @db.VarChar(30)
  title      String  @db.VarChar(500)
  file_path  String? @db.VarChar(500)
  external_url String? @db.Text
  size_bytes Int?
  mime_type  String? @db.VarChar(80)
  note       String? @db.Text

  signed_at  DateTime?
  valid_from DateTime?
  valid_to   DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([site_id])
  @@index([doc_type])
  @@map("site_documents")
}

// =============================================================================
// SERVIS — Znalostní báze pro servisáky + AI chat Hugo pro partnery
// =============================================================================
// Cíl: Naši servisáci v HolyOS spravují návody, řešené případy, kontrolní postupy.
// Partneři na bestseries.cash se přihlásí k AI servisákovi Hugo, který nad touto
// znalostní bází radí. Hugo má vlastní login (PartnerAccount), oddělený od interního
// User auth. Znalost je vázána na Product (prádlomat 750, 1000, …) a Appliance
// (motor, čerpadlo, řídicí jednotka, displej, mince…).

// Kategorie servisních článků — Mechanika / Elektro / Voda / Software / Údržba…
model ServiceCategory {
  id          Int     @id @default(autoincrement())
  name        String  @unique @db.VarChar(100)
  slug        String  @unique @db.VarChar(120)
  icon        String? @db.VarChar(10)
  color       String? @db.VarChar(20)
  sort_order  Int     @default(0)
  description String? @db.Text

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  articles ServiceArticle[]

  @@map("service_categories")
}

// Spotřebič — fyzický komponent uvnitř produktu (motor, čerpadlo, kompresor,
// displej, mincovník…). Volitelně provázáno s Material (BOM položka).
model ServiceAppliance {
  id           Int     @id @default(autoincrement())
  name         String  @db.VarChar(255)
  manufacturer String? @db.VarChar(255)
  model_code   String? @db.VarChar(100)
  description  String? @db.Text
  manual_url   String? @db.VarChar(500) // externí PDF manuál výrobce
  photo_url    String? @db.VarChar(500)

  // Volitelná vazba na Material (BOM položka — pokud se spotřebič i objednává jako materiál)
  material_id Int?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  product_links ServiceProductAppliance[]
  articles      ServiceArticleAppliance[]
  manuals       ServiceApplianceManual[]

  @@index([material_id])
  @@map("service_appliances")
}

// PDF manuál výrobce přiložený ke spotřebiči. Při uploadu extrahujeme text
// (pdf-parse) a uložíme do extracted_text — Hugo z něj pak čerpá při RAG retrievalu.
model ServiceApplianceManual {
  id             Int     @id @default(autoincrement())
  appliance_id   Int
  title          String  @db.VarChar(500)
  file_path      String  @db.VarChar(500) // relativní cesta k souboru v data/service-manuals/<id>/
  mime_type      String? @db.VarChar(80)
  size_bytes     Int?
  page_count     Int?
  language       String? @db.VarChar(5)
  extracted_text String? @db.Text // plain text z PDF pro Hugo retrieval (ILIKE search)

  appliance ServiceAppliance @relation(fields: [appliance_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([appliance_id])
  @@map("service_appliance_manuals")
}

// M:N Product ↔ ServiceAppliance — který spotřebič je v kterém produktu, kde
model ServiceProductAppliance {
  id           Int     @id @default(autoincrement())
  product_id   Int
  appliance_id Int
  position     String? @db.VarChar(255) // "v zadní části, vlevo nahoře"
  quantity     Int     @default(1)

  appliance ServiceAppliance @relation(fields: [appliance_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())

  @@unique([product_id, appliance_id])
  @@index([product_id])
  @@index([appliance_id])
  @@map("service_product_appliances")
}

// Servisní článek — návod / řešený případ / kontrolní postup / FAQ
model ServiceArticle {
  id          Int     @id @default(autoincrement())
  title       String  @db.VarChar(500)
  slug        String  @unique @db.VarChar(550)
  kind        String  @default("GUIDE") @db.VarChar(20) // GUIDE | CASE | CHECKLIST | FAQ
  summary     String? @db.VarChar(1000) // krátký výtah pro vyhledávání + chat citace
  body_md     String  @db.Text          // Markdown
  body_search String? @db.Text          // body bez Markdown syntaxe pro ILIKE search (auto-generated)
  tags        Json    @default("[]")    // ["motor", "hlučnost", "vibrace"]

  // Viditelnost — internal = jen servisáci v HolyOS, partner = Hugo to může citovat partnerům
  visibility String @default("partner") @db.VarChar(20) // internal | partner
  status     String @default("draft") @db.VarChar(20)   // draft | published | archived

  category_id Int?
  category    ServiceCategory? @relation(fields: [category_id], references: [id], onDelete: SetNull)

  // Autor (servisák, který článek napsal)
  author_person_id Int?

  // Statistiky pro retrieval
  views_count    Int @default(0)
  helpful_count  Int @default(0)
  not_helpful_count Int @default(0)

  // Vazby M:N
  products   ServiceArticleProduct[]
  appliances ServiceArticleAppliance[]

  attachments ServiceArticleAttachment[]
  embeddings  ServiceArticleEmbedding[]
  citations   ServiceChatCitation[]

  published_at DateTime?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@index([kind])
  @@index([status])
  @@index([visibility])
  @@index([category_id])
  @@index([author_person_id])
  @@map("service_articles")
}

// M:N — článek se týká konkrétních produktů (prádlomat 750, 1000…)
model ServiceArticleProduct {
  id         Int @id @default(autoincrement())
  article_id Int
  product_id Int

  article ServiceArticle @relation(fields: [article_id], references: [id], onDelete: Cascade)

  @@unique([article_id, product_id])
  @@index([product_id])
  @@map("service_article_products")
}

// M:N — článek se týká konkrétních spotřebičů (motor, čerpadlo…)
model ServiceArticleAppliance {
  id           Int @id @default(autoincrement())
  article_id   Int
  appliance_id Int

  article   ServiceArticle   @relation(fields: [article_id], references: [id], onDelete: Cascade)
  appliance ServiceAppliance @relation(fields: [appliance_id], references: [id], onDelete: Cascade)

  @@unique([article_id, appliance_id])
  @@index([appliance_id])
  @@map("service_article_appliances")
}

// Přílohy článku — PDF, fotky, videa
model ServiceArticleAttachment {
  id         Int    @id @default(autoincrement())
  article_id Int
  title      String @db.VarChar(255)
  file_path  String? @db.VarChar(500)
  url        String? @db.VarChar(500)
  mime_type  String? @db.VarChar(80)
  size_bytes Int?
  sort_order Int    @default(0)

  article ServiceArticle @relation(fields: [article_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())

  @@index([article_id])
  @@map("service_article_attachments")
}

// Embeddings pro RAG — pgvector, připraveno pro budoucí AI retrieval.
// V MVP zatím nepoužívané (Hugo používá ILIKE/fulltext), ale schema je hotové
// aby bylo později jednoduché doplnit Voyage/OpenAI embedding worker.
model ServiceArticleEmbedding {
  id          Int    @id @default(autoincrement())
  article_id  Int
  chunk_index Int    @default(0)
  chunk_text  String @db.Text
  // Embedding vector (1536-dim pro OpenAI text-embedding-3-small / Voyage voyage-2)
  // Až bude aktivováno, doplnit přes raw SQL: ALTER TABLE service_article_embeddings ADD COLUMN embedding vector(1536);
  // Zatím držíme jen text chunky.

  article ServiceArticle @relation(fields: [article_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())

  @@index([article_id])
  @@map("service_article_embeddings")
}

// Partner — externí uživatel, který se přihlašuje na bestseries.cash k Hugovi.
// Oddělené od User (interní HolyOS). Vlastní username + bcrypt password_hash.
model PartnerAccount {
  id            Int     @id @default(autoincrement())
  username      String  @unique @db.VarChar(100)
  email         String? @db.VarChar(255)
  phone         String? @db.VarChar(20)
  display_name  String  @db.VarChar(255)
  password_hash String  @db.VarChar(255)
  active        Boolean @default(true)
  // Volitelná vazba na Company v adresáři (partner = naše zákaznická firma)
  company_id    Int?
  company       Company? @relation("PartnerCompany", fields: [company_id], references: [id], onDelete: SetNull)
  // Volitelná vazba na konkrétní kontaktní osobu (Person)
  contact_person_id Int?
  language          String @default("cs") @db.VarChar(5) // cs | en | de | pl

  last_login_at DateTime?
  last_ip       String?   @db.VarChar(45)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  products      PartnerProductAccess[]
  chat_sessions ServiceChatSession[]
  // Spare Parts Shop — objednávky, které tento partner vytvořil
  shop_orders   ShopOrder[]            @relation("ShopOrderPartner")

  @@index([company_id])
  @@index([active])
  @@map("partner_accounts")
}

// M:N — které produkty (prádlomaty) má partner přidělené.
// Hugo retrieval filtruje znalostní bázi podle těchto produktů.
model PartnerProductAccess {
  id         Int @id @default(autoincrement())
  partner_id Int
  product_id Int
  // Volitelné sériové číslo konkrétního kusu, který partner provozuje
  serial_no String? @db.VarChar(100)

  partner PartnerAccount @relation(fields: [partner_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())

  @@unique([partner_id, product_id, serial_no])
  @@index([product_id])
  @@map("partner_product_access")
}

// Chat session s Hugem — jedna session = jedno otevření chatu, držíme do
// auto-archivace po N hodinách neaktivity.
model ServiceChatSession {
  id         Int     @id @default(autoincrement())
  partner_id Int
  title      String? @db.VarChar(500) // auto-generovaný název z první otázky
  language   String  @default("cs") @db.VarChar(5)
  status     String  @default("active") @db.VarChar(20) // active | archived

  partner  PartnerAccount       @relation(fields: [partner_id], references: [id], onDelete: Cascade)
  messages ServiceChatMessage[]

  // Audit — co se odehrálo
  message_count Int @default(0)
  // Příznak: dostala některá zpráva v této session feedback "Hugo nepomohl"?
  needs_attention Boolean @default(false)

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  closed_at  DateTime?

  @@index([partner_id])
  @@index([status])
  @@index([needs_attention])
  @@map("service_chat_sessions")
}

// Jedna zpráva v Hugově chatu.
model ServiceChatMessage {
  id         Int    @id @default(autoincrement())
  session_id Int
  role       String @db.VarChar(20) // user | assistant | system
  body       String @db.Text

  // Které články Hugo použil jako kontext / odkazoval na ně.
  // citations = strukturovaná tabulka, retrieved_article_ids = jen IDs pro audit.
  retrieved_article_ids Json @default("[]") // [12, 34, 56]
  // Volitelný feedback od partnera
  feedback String? @db.VarChar(20) // helpful | not_helpful | null

  // Token spotřeba (pro audit nákladů)
  tokens_input  Int?
  tokens_output Int?
  model         String? @db.VarChar(50)

  session   ServiceChatSession   @relation(fields: [session_id], references: [id], onDelete: Cascade)
  citations ServiceChatCitation[]

  created_at DateTime @default(now())

  @@index([session_id])
  @@index([role])
  @@map("service_chat_messages")
}

// Strukturovaná citace = explicitní odkaz z Hugovy zprávy na konkrétní ServiceArticle.
// Umožňuje partnerovi v UI kliknout na "Více v návodu X" a otevřít plný článek.
model ServiceChatCitation {
  id         Int @id @default(autoincrement())
  message_id Int
  article_id Int
  // Pořadí citace v rámci zprávy (1, 2, 3…)
  position   Int @default(0)

  message ServiceChatMessage @relation(fields: [message_id], references: [id], onDelete: Cascade)
  article ServiceArticle     @relation(fields: [article_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())

  @@index([message_id])
  @@index([article_id])
  @@map("service_chat_citations")
}

// =============================================================================
// VELÍN — Mobilní aplikace pro řízení dne kolegů
// =============================================================================
// Velín je kapesní agent pro každého kolegu. Dostane denní plán (DailyPlan),
// úkoly (TaskAssignment) z plánovače výroby / od vedoucího / od AI dispečera,
// chatuje nad nimi (TaskMessage), večer odevzdá zpětnou vazbu (EveningReflection)
// a docházku punctuje GPS (AttendancePunch) v rámci provozu (GeoFence).
// Auth: Person.velin_pin_hash + DeviceRegistration s push tokenem (Expo).

// Denní plán jedné osoby na konkrétní den. Generuje se ráno z plánovače
// výroby + ad-hoc úkolů od vedoucích + AI návrhů. Po publikaci se uzamkne
// (kolega neuvidí čerstvé draft změny mid-day).
model DailyPlan {
  id                Int       @id @default(autoincrement())
  person_id         Int
  date              DateTime  @db.Date
  generated_by      String    @default("system") @db.VarChar(20) // system | manager | ai | self
  generated_at      DateTime  @default(now())
  morning_pushed_at DateTime?
  evening_pushed_at DateTime?
  status            String    @default("draft") @db.VarChar(20) // draft | published | locked
  ai_summary        String?   @db.Text // krátké AI shrnutí dne pro vedoucího

  person      Person           @relation("DailyPlanPerson", fields: [person_id], references: [id], onDelete: Cascade)
  assignments TaskAssignment[] @relation("TaskAssignmentDailyPlan")

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([person_id, date])
  @@index([date, status])
  @@map("velin_daily_plans")
}

// Konkrétní úkol pro osobu. Zdroj může být plánovač výroby (BatchOperation),
// ad-hoc úkol od vedoucího (AdminTask), AI dispečer, nebo self-task.
// Lifecycle: proposed → accepted → in_progress → done | blocked | cancelled.
model TaskAssignment {
  id              Int       @id @default(autoincrement())
  daily_plan_id   Int?
  person_id       Int

  // Kdo úkol vytvořil — buď konkrétní osoba (vedoucí) přes Person FK, nebo
  // systém / AI agent (created_by="system" / "ai_dispatcher", created_by_person_id=null)
  created_by      String    @default("system") @db.VarChar(20) // system | manager | ai | self
  created_by_person_id Int?

  // Origin reference — odkaz na zdrojový objekt (BatchOperation, AdminTask…)
  source          String    @default("manager") @db.VarChar(30) // production | manager | ai_dispatcher | self | agenda
  source_ref_type String?   @db.VarChar(50) // "BatchOperation" | "AdminTask" | "ProductionBatch" | ...
  source_ref_id   Int?

  title           String    @db.VarChar(500)
  description     String?   @db.Text
  priority        Int       @default(3) // 1=critical, 5=low
  estimated_min   Int?       // norma TAC+Tpz nebo manuální odhad
  due_at          DateTime?

  status          String    @default("proposed") @db.VarChar(20)
  // proposed → accepted → in_progress → blocked → done | cancelled | timed_out
  accepted_at     DateTime?
  started_at      DateTime?
  completed_at    DateTime?
  blocked_at      DateTime?
  blocked_reason  String?   @db.Text
  cancelled_at    DateTime?
  cancel_reason   String?   @db.VarChar(500)

  actual_min      Int?       // skutečný čas po dokončení (vyplní kolega)

  location_hint     String?  @db.VarChar(255) // "Hala A", "Sklad-A-RK"
  requires_gps_fence Boolean @default(false)
  fence_id          Int?     // pokud requires_gps_fence=true, který fence

  daily_plan        DailyPlan?    @relation("TaskAssignmentDailyPlan", fields: [daily_plan_id], references: [id], onDelete: SetNull)
  person            Person        @relation("TaskAssignmentPerson", fields: [person_id], references: [id], onDelete: Cascade)
  creator_person    Person?       @relation("TaskAssignmentCreator", fields: [created_by_person_id], references: [id], onDelete: SetNull)
  fence             GeoFence?     @relation(fields: [fence_id], references: [id], onDelete: SetNull)
  messages          TaskMessage[]
  feedback          TaskFeedback?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([person_id, status])
  @@index([due_at])
  @@index([daily_plan_id])
  @@index([source, source_ref_type, source_ref_id])
  @@map("velin_task_assignments")
}

// Chat nad úkolem — kolega↔vedoucí, kolega↔AI Hugo, system notifikace.
model TaskMessage {
  id              Int      @id @default(autoincrement())
  task_id         Int
  author_kind     String   @db.VarChar(20) // person | ai | system
  author_person_id Int?
  body            String   @db.Text
  attachments     Json?     // [{kind:"photo", url:"...", caption:"..."}]
  read_at         DateTime?
  created_at      DateTime @default(now())

  task   TaskAssignment @relation(fields: [task_id], references: [id], onDelete: Cascade)
  author Person?        @relation("TaskMessageAuthor", fields: [author_person_id], references: [id], onDelete: SetNull)

  @@index([task_id, created_at])
  @@map("velin_task_messages")
}

// Feedback k jednomu úkolu (na konci úkolu, krátký — self_rating + blokátory).
// Pozn.: agregovaná denní reflexe je v EveningReflection.
model TaskFeedback {
  id              Int       @id @default(autoincrement())
  task_id         Int       @unique
  self_rating     Int?      // 1-5 sebehodnocení splnění úkolu
  difficulty      Int?      // 1-5 jak bylo náročné
  time_actual_min Int?
  blockers        String?   @db.Text
  free_text       String?   @db.Text
  ai_summary      String?   @db.Text // Claude Haiku shrnutí pro vedoucího
  created_at      DateTime  @default(now())

  task TaskAssignment @relation(fields: [task_id], references: [id], onDelete: Cascade)

  @@map("velin_task_feedbacks")
}

// Denní reflexe — strukturovaný formulář na konci směny. Jedna na osobu/den.
model EveningReflection {
  id              Int       @id @default(autoincrement())
  person_id       Int
  date            DateTime  @db.Date
  mood            Int?      // 1-5
  energy          Int?      // 1-5
  wins            String?   @db.Text
  struggles       String?   @db.Text
  tomorrow_focus  String?   @db.Text
  free_text       String?   @db.Text
  ai_summary      String?   @db.Text // shrnutí pro vedoucího (Claude Haiku)
  submitted_at    DateTime  @default(now())

  person Person @relation("EveningReflectionPerson", fields: [person_id], references: [id], onDelete: Cascade)

  @@unique([person_id, date])
  @@index([date])
  @@map("velin_evening_reflections")
}

// Skill profile osoby — co umí, jak rychle, případná omezení/certifikace.
// AI dispečer (Mistr) z toho čte při výběru kandidáta na úkol.
model PersonSkillProfile {
  id              Int       @id @default(autoincrement())
  person_id       Int       @unique
  // Volné pole: [{key:"sewing", level:4, certified:true, valid_to:"2027-01-01"}]
  skills          Json      @default("[]")
  preferred_shift String?   @db.VarChar(20) // morning | afternoon | night | flex
  speed_factor    Float     @default(1.0)   // 1.2 = o 20 % rychlejší než norma
  notes           String?   @db.Text
  updated_at      DateTime  @updatedAt

  person Person @relation("PersonSkillProfilePerson", fields: [person_id], references: [id], onDelete: Cascade)

  @@map("velin_skill_profiles")
}

// Registrované zařízení s Expo push tokenem. Jedna osoba může mít víc zařízení
// (telefon + tablet) — push posíláme na všechny active.
model DeviceRegistration {
  id              Int       @id @default(autoincrement())
  person_id       Int
  expo_push_token String    @unique @db.VarChar(255)
  // Server-side bearer token pro mobile API (oddělený od HolyOS web JWT).
  // Generuje se při aktivaci, hashuje se v DB (bcrypt) a kolega ho neuvidí.
  device_token_hash String  @db.VarChar(255)
  platform        String    @db.VarChar(10) // ios | android
  device_label    String?   @db.VarChar(255) // "iPhone 15 Tomáš"
  app_version     String?   @db.VarChar(30)
  os_version      String?   @db.VarChar(30)
  last_seen_at    DateTime  @default(now())
  active          Boolean   @default(true)
  revoked_at      DateTime?
  revoke_reason   String?   @db.VarChar(255)
  created_at      DateTime  @default(now())

  person Person @relation("DeviceRegistrationPerson", fields: [person_id], references: [id], onDelete: Cascade)

  @@index([person_id, active])
  @@map("velin_device_registrations")
}

// Docházkové punche přes mobilní aplikaci. Inside_fence se vyhodnotí
// proti GeoFence — pokud false a fence vyžadovaný, vyžádá si admin schválení.
model AttendancePunch {
  id            Int       @id @default(autoincrement())
  person_id     Int
  kind          String    @db.VarChar(20) // in | out | break_start | break_end
  source        String    @default("pracacek_gps") @db.VarChar(30) // pracacek_gps | pracacek_manual | kiosk | admin
  lat           Float?
  lng           Float?
  accuracy_m    Float?
  inside_fence  Boolean   @default(false)
  fence_id      Int?
  punched_at    DateTime  @default(now())
  // Pokud admin punch ručně schválil ex-post (např. GPS selhalo)
  approved_by_user_id Int?
  approved_at   DateTime?
  notes         String?   @db.Text

  person Person     @relation("AttendancePunchPerson", fields: [person_id], references: [id], onDelete: Cascade)
  fence  GeoFence?  @relation(fields: [fence_id], references: [id], onDelete: SetNull)

  @@index([person_id, punched_at])
  @@index([fence_id])
  @@map("velin_attendance_punches")
}

// GeoFence — kruhová zóna kolem provozu. Telefon vyhodnocuje inside_fence
// proti center_lat/lng + radius_m. Více fence = více provozů.
model GeoFence {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(255) // "Provoz Velké Hamry"
  center_lat  Float
  center_lng  Float
  radius_m    Int       @default(150) // typicky 100–300 m
  active      Boolean   @default(true)
  notes       String?   @db.Text
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  task_assignments  TaskAssignment[]
  attendance_punches AttendancePunch[]

  @@map("velin_geo_fences")
}

// =============================================================================
// SPARE PARTS SHOP — partner-facing eshop náhradních dílů na bestseries.cash/spare-parts
// =============================================================================
// Sdílí login s Hugem (PartnerAccount). Vlastní agenda objednávek (ShopOrder)
// oddělená od výrobních Order. Skladová dostupnost se počítá nad Stock přes
// EshopMaterial.eshop_warehouse_id (viz memory holyos_stock_warehouse_join).
//
// Rozhodnutí 2026-05-18 (memory holyos_eshop_iniciativa):
// - Primární měna EUR (model multi-currency, CZK později jako další pricelist)
// - Rezervace skladu hned při vytvoření (status='new'), auto-release po
//   ESHOP_RESERVATION_HOURS hodinách neaktivity (default 72)
// - Notifikace nové objednávky: e-mail + Velín push na Person z EshopSettings
// =============================================================================

// Kategorie zboží v eshopu — motory, řemeny, čerpadla, elektronika, doplňky...
// Hierarchická (parent_id) pro budoucí filter sidebar; ve Fázi 1 jen flat.
model EshopCategory {
  id          Int     @id @default(autoincrement())
  name        String  @unique @db.VarChar(100)
  slug        String  @unique @db.VarChar(120)
  icon        String? @db.VarChar(10)
  description String? @db.Text
  sort_order  Int     @default(0)
  parent_id   Int?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  parent    EshopCategory?  @relation("EshopCategoryHierarchy", fields: [parent_id], references: [id], onDelete: SetNull)
  children  EshopCategory[] @relation("EshopCategoryHierarchy")
  // M:N (požadavek #85) — díly přiřazené do této kategorie; jeden díl jich může mít víc.
  materials Material[]      @relation("MaterialEshopCategories")

  @@index([parent_id])
  @@index([sort_order])
  @@map("eshop_categories")
}

// Ceník — per měna, per firma (Company.eshop_pricelist_id). Bez ceníku
// přiřazeného firmě nevidí partner žádné ceny → tlačítko shopu disabled.
model EshopPricelist {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(255) // "Standard EUR", "Velkoodběr CZ"
  currency    String   @default("EUR") @db.VarChar(3)
  vat_pct     Decimal  @default(21) @db.Decimal(5, 2)
  active      Boolean  @default(true)
  description String?  @db.Text

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  items     EshopPricelistItem[]
  companies Company[]            @relation("CompanyEshopPricelist")

  @@index([active])
  @@map("eshop_pricelists")
}

// Položka ceníku — cena bez DPH za jeden Material. Per (pricelist, material) unique.
model EshopPricelistItem {
  id             Int     @id @default(autoincrement())
  pricelist_id   Int
  material_id    Int
  price_excl_vat Decimal @db.Decimal(12, 2)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  pricelist EshopPricelist @relation(fields: [pricelist_id], references: [id], onDelete: Cascade)
  material  Material       @relation(fields: [material_id], references: [id], onDelete: Cascade)

  @@unique([pricelist_id, material_id])
  @@index([pricelist_id])
  @@index([material_id])
  @@map("eshop_pricelist_items")
}

// Způsob dopravy — Zásilkovna, kurýr, osobní odběr...
// free_above_amount = doprava zdarma od částky (currency match s objednávkou).
model EshopShippingMethod {
  id                Int      @id @default(autoincrement())
  name              String   @db.VarChar(255)
  description       String?  @db.Text
  price_excl_vat    Decimal  @db.Decimal(10, 2)
  vat_pct           Decimal  @default(21) @db.Decimal(5, 2)
  free_above_amount Decimal? @db.Decimal(12, 2)
  currency          String   @default("EUR") @db.VarChar(3)
  active            Boolean  @default(true)
  sort_order        Int      @default(0)
  // price_on_request = cena dopravy se v checkoutu NEpočítá; doplní ji až
  // agenda Doprava (kurýr do zahraničí). Objednávka jde do stavu shipping
  // pending a faktura se nesmí vytvořit, dokud cena není definována.
  price_on_request  Boolean  @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  shop_orders ShopOrder[] @relation("ShopOrderShipping")

  @@index([active])
  @@map("eshop_shipping_methods")
}

// Způsob platby — bankovní převod, dobírka, hotově, online card (Fáze 2).
model EshopPaymentMethod {
  id           Int     @id @default(autoincrement())
  name         String  @db.VarChar(255) // "Bankovní převod", "Dobírka"
  code         String  @unique @db.VarChar(50) // 'bank_transfer' | 'cod' | 'cash' | 'card'
  description  String? @db.Text
  fee_excl_vat Decimal @default(0) @db.Decimal(10, 2)
  vat_pct      Decimal @default(21) @db.Decimal(5, 2)
  active       Boolean @default(true)
  sort_order   Int     @default(0)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  shop_orders ShopOrder[] @relation("ShopOrderPayment")

  @@index([active])
  @@map("eshop_payment_methods")
}

// Eshopová objednávka — samostatná agenda, oddělená od výrobních Order.
// Adresa + ceny jsou snapshotované v okamžiku objednávky (audit; firma se
// později může změnit, ale historická objednávka drží svůj stav).
// Workflow: new → confirmed → picking → shipped → delivered → closed
//                                                              ↘ cancelled
model ShopOrder {
  id                  Int     @id @default(autoincrement())
  order_number        String  @unique @db.VarChar(50) // např. E2026-00001
  partner_id          Int
  company_id          Int?
  shipping_method_id  Int
  payment_method_id   Int

  // Adresa dodání — snapshot v okamžiku objednávky
  ship_to_name    String  @db.VarChar(255)
  ship_to_company String? @db.VarChar(255)
  ship_to_address String  @db.VarChar(500)
  ship_to_city    String  @db.VarChar(120)
  ship_to_zip     String  @db.VarChar(20)
  ship_to_country String  @default("CZ") @db.VarChar(2)
  ship_to_email   String? @db.VarChar(255)
  ship_to_phone   String? @db.VarChar(40)

  customer_note   String? @db.Text

  // Celkové částky — snapshot v okamžiku objednávky (z partnerova ceníku)
  currency         String  @db.VarChar(3)
  vat_pct          Decimal @db.Decimal(5, 2)
  subtotal_excl    Decimal @db.Decimal(12, 2)
  shipping_excl    Decimal @db.Decimal(10, 2)
  payment_fee_excl Decimal @default(0) @db.Decimal(10, 2)
  total_excl       Decimal @db.Decimal(12, 2)
  total_incl_vat   Decimal @db.Decimal(12, 2)

  // Workflow stav
  status        String    @default("new") @db.VarChar(20) // new | confirmed | picking | shipped | delivered | closed | cancelled
  cancel_reason String?   @db.VarChar(255) // např. "auto_release_expired" pro auto-release worker

  // Doprava — stav ceny. 'defined' = cena dopravy je známá (výchozí pro běžné
  // metody i historické objednávky). 'pending' = kurýr price_on_request, cenu
  // teprve doplní agenda Doprava přes ShippingRequest. Faktura se nesmí
  // vytvořit, dokud není 'defined'.
  shipping_price_status String @default("defined") @db.VarChar(20)

  // Tracking
  tracking_number  String? @db.VarChar(100)
  tracking_carrier String? @db.VarChar(60)

  // Fakturace — po dodání admin vygeneruje Invoice (issued/ar), ID se uloží sem.
  // Bez explicitní @relation — informativní pointer, nikoli DB FK.
  invoice_id Int?

  // Auto-pick (Fáze 3) — po confirmu objednávky admin vyrobí Batch (sector='eshop')
  // se všemi položkami. Také informativní pointer bez @relation.
  pick_batch_id Int?

  // Audit milníky workflow
  confirmed_at DateTime?
  picked_at    DateTime?
  shipped_at   DateTime?
  delivered_at DateTime?
  closed_at    DateTime?
  cancelled_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  partner         PartnerAccount      @relation("ShopOrderPartner", fields: [partner_id], references: [id], onDelete: Restrict)
  company         Company?            @relation("ShopOrderCompany", fields: [company_id], references: [id], onDelete: SetNull)
  shipping_method EshopShippingMethod @relation("ShopOrderShipping", fields: [shipping_method_id], references: [id], onDelete: Restrict)
  payment_method  EshopPaymentMethod  @relation("ShopOrderPayment", fields: [payment_method_id], references: [id], onDelete: Restrict)
  items           ShopOrderItem[]
  shipping_requests ShippingRequest[]

  @@index([partner_id])
  @@index([company_id])
  @@index([status])
  @@index([created_at])
  @@index([partner_id, status])
  @@map("eshop_orders")
}

// Požadavek na dopravu (agenda Doprava). Vzniká u eshop objednávek s kurýrem
// (price_on_request). Řešitel poptá cenu u dopravce, zapíše domluvený náklad
// + provizi (%), systém dopočte prodejní cenu (sell_excl) a po potvrzení ji
// zapíše do ShopOrder.shipping_excl + shipping_price_status='defined'.
// Workflow: new → quoting → quoted → confirmed (↘ cancelled)
model ShippingRequest {
  id       Int @id @default(autoincrement())
  order_id Int

  status String @default("new") @db.VarChar(20) // new | quoting | quoted | confirmed | cancelled

  carrier    String? @db.VarChar(120) // zvolený dopravce (DPD, GLS, DHL…)
  quote_note String? @db.Text         // kam/komu poptáno, čísla poptávek, poznámky

  // Ceny (bez DPH), v měně objednávky
  currency   String  @default("EUR") @db.VarChar(3)
  cost_excl  Decimal @default(0) @db.Decimal(10, 2)  // domluvená nákupní cena dopravy
  markup_pct Decimal @default(0) @db.Decimal(5, 2)   // provize (% navýšení)
  sell_excl  Decimal @default(0) @db.Decimal(10, 2)  // dopočet = cost × (1 + markup/100)

  assigned_to Int? // Person, který zásilku řeší
  created_by  Int? // User, který požadavek založil

  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  quoted_at   DateTime?
  confirmed_at DateTime?

  order    ShopOrder @relation(fields: [order_id], references: [id], onDelete: Cascade)
  assignee Person?   @relation("ShippingRequestAssignee", fields: [assigned_to], references: [id], onDelete: SetNull)

  @@index([order_id])
  @@index([status])
  @@index([assigned_to])
  @@map("shipping_requests")
}

// Položka eshopové objednávky. material_id je nullable — kdyby byl Material
// později smazán, zachováme aspoň snapshot kódu+názvu+ceny pro audit.
model ShopOrderItem {
  id              Int     @id @default(autoincrement())
  order_id        Int
  material_id     Int?
  material_code   String  @db.VarChar(50)
  material_name   String  @db.VarChar(255)
  quantity        Decimal @db.Decimal(10, 3)
  unit            String  @default("ks") @db.VarChar(20)
  unit_price_excl Decimal @db.Decimal(12, 2)
  total_excl      Decimal @db.Decimal(12, 2)

  created_at DateTime @default(now())

  order    ShopOrder @relation(fields: [order_id], references: [id], onDelete: Cascade)
  material Material? @relation(fields: [material_id], references: [id], onDelete: SetNull)

  @@index([order_id])
  @@index([material_id])
  @@map("eshop_order_items")
}

// Globální konfigurace eshopu — singleton (id=1). Admin UI tab Nastavení.
// notification_person_id = osoba, která dostane Velín push při nové objednávce
// (vedle nebo místo e-mailu).
model EshopSettings {
  id                     Int      @id @default(autoincrement())
  notification_email     String?  @db.VarChar(255) // fallback na env ESHOP_NOTIFICATION_EMAIL
  notification_person_id Int?
  default_currency       String   @default("EUR") @db.VarChar(3)
  default_vat_pct        Decimal  @default(21) @db.Decimal(5, 2)
  reservation_hours      Int      @default(72) // override env ESHOP_RESERVATION_HOURS
  // Výchozí provize (% navýšení) na dopravu — předvyplní se u nové zásilky
  // v agendě Doprava, lze přepsat u konkrétní zásilky.
  shipping_markup_pct    Decimal  @default(0) @db.Decimal(5, 2)
  footer_html            String?  @db.Text
  contact_email          String?  @db.VarChar(255)
  contact_phone          String?  @db.VarChar(40)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  notification_person Person? @relation("EshopSettingsNotifyPerson", fields: [notification_person_id], references: [id], onDelete: SetNull)

  @@map("eshop_settings")
}

// =============================================================================
// COMPOUNDER — brandový web compounder.world (iniciativa Compounder)
// =============================================================================

// Lead z registrace na compounder.world. Veřejná registrace (bez auth) —
// návštěvník vyplní jméno + e-mail a zvolí, zda chce vstoupit jako Compounder
// (investor) nebo Distributor. Slouží k identifikaci vážných zájemců a vstupu
// do Compounder Portal. Oddělené od JobApplicant i SalesContact (jiný kontext).
model CompounderLead {
  id    Int    @id @default(autoincrement())
  // Zobrazované jméno (složené) — drží se kvůli zpětné kompatibilitě (karty, dedup, notifikace).
  name  String @db.VarChar(255)
  // Strukturované údaje kontaktu (nepovinné) — jméno, příjmení, firma, město, země.
  first_name String? @db.VarChar(120)
  last_name  String? @db.VarChar(120)
  company    String? @db.VarChar(200)
  city       String? @db.VarChar(120)
  country    String? @db.VarChar(120)
  // E-mail je nepovinný — kontakt lze založit i jen s telefonem (aspoň jeden údaj povinný).
  email String? @db.VarChar(255)
  // Telefon z portálu (žádost o kontakt) — uloží si ho lead sám přes tlačítko
  phone String? @db.VarChar(40)

  // compounder | distributor
  role String @default("compounder") @db.VarChar(20)

  // Preferovaný jazyk z webu (ISO kód: en, cs, de…)
  lang String? @db.VarChar(10)

  // Stav zpracování leadu
  status String @default("new") @db.VarChar(30)
  // new | contacted | qualified | converted | rejected

  // Zdroj a kontext příchodu
  source     String  @default("web") @db.VarChar(50)
  ref        String? @db.VarChar(500) // document.referrer
  ip         String? @db.VarChar(64)
  user_agent String? @db.Text

  // Volné poznámky obchodníka (editovatelné, prázdné pole na cokoli)
  notes String? @db.Text
  // Append-only log aktivit (řádek po řádku s časem) — nejde ručně přepisovat
  activity_log String? @db.Text

  // Které sekce portálu lead vidí (CSV klíčů skupin: ekonomika,nabidka,distributor)
  // null = výchozí (jen ekonomika)
  visible_sections String? @db.Text
  // Zpřístupněné vzory smluv (mustry) ke čtení: CSV typů rezervacni,kupni,servisni.
  // Prázdné = zákazník nevidí žádný vzor (výchozí).
  visible_templates String? @db.Text

  // Zda zákazník v portálu (sekce Investor) vidí statistiky tržeb lokalit.
  // Výchozí false — zapíná obchodník z HolyOS pro konkrétní lead.
  show_revenue_stats Boolean @default(false)

  // Schovat „živou ztrátu" v portálu tomuto leadovi: časomíru + „přišli jste o…" v horní
  // liště a kartu „Cena vašeho váhání" v sekci Příklad. Výchozí false (ztráta se ukazuje).
  hide_live_loss Boolean @default(false)

  // Testovací kontakt — slouží jen k testování systému. Nezapočítává se do
  // statistik obchodníka ani do konverzí/registrací a systém ho nebere jako
  // standardní kontakt. Výchozí false.
  is_test Boolean @default(false)

  // Sekce „Příklad" (skládačka portfolia) v portálu — viditelná jen pro tento
  // lead, když ji obchodník zapne. Výchozí vypnuto.
  show_example Boolean @default(false)
  // Uložený model zákazníka (JSON): { codes:[kiosk kódy], savedAt, ... }.
  example_model String? @db.Text

  // Heslo pro prihlaseni (bcrypt hash). Null = uzivatel heslo nenastavil (jen magic link).
  password_hash String? @db.Text

  // Schválení přístupu k portálu. Relevantní pro nezvané (source='access_request'):
  // dokud je null, nemají přístup ani přihlašovací odkaz. Ostatní zdroje (web/pozvánka)
  // mají přístup jako dosud (nezávisle na tomto poli).
  access_approved_at DateTime?

  // Individuální nabídka lokalit navíc (CSV kódů kiosků). Lead vidí společnou
  // nabídku (forSale) PLUS tyto lokality — přidává je admin z HolyOS.
  extra_offers String? @db.Text

  // Obchod — přiřazený obchodník (komu se kontakt zobrazí na obrazovce obchodníka)
  // a kdo kontakt založil. Odkaz na Person (bez formální relace, jméno se dohledá zvlášť).
  owner_person_id      Int?
  created_by_person_id Int?
  // Externí obchodník, který kontakt založil/spravuje (id z AppSetting external.sales_reps).
  external_rep_id      Int?

  // Kolikrát obchodník poslal leadovi přihlašovací odkaz + kdy naposledy.
  access_sent_count   Int       @default(0)
  access_last_sent_at DateTime?

  // ── Sleva per-lead (vstupní cena prádlomatu + cena lokality) ─────────────
  // Efektivní sleva je aktivní když: discount_permanent, NEBO now <= discount_until
  // (ruční prodloužení), NEBO auto (now <= start přístupu + settings.discount.validDays).
  // discount_disabled slevu vypne bez ohledu na ostatní.
  discount_until     DateTime?
  discount_permanent Boolean   @default(false)
  discount_disabled  Boolean   @default(false)

  // ── Meta (Facebook/Instagram) Lead Ads ──────────────────────────────────
  // Lead přišel z FB reklamy (rychlý formulář). meta_lead_id drží idempotenci
  // (stejný lead se nezaloží 2×). meta_form_id se páruje s nastavením formulářů
  // (AppSetting compounder.fb_lead_forms) → přiřazení obchodníka + kampaně.
  meta_lead_id String? @unique @db.VarChar(64)
  meta_form_id String? @db.VarChar(64)
  meta_page_id String? @db.VarChar(64)
  meta_ad_id   String? @db.VarChar(64)
  // Štítek kampaně (volný text z nastavení formuláře) — pro rozlišení reklam.
  campaign     String? @db.VarChar(160)
  // Surová data leadu z FB (celý JSON) pro dohledání dalších polí.
  meta_raw     Json?

  // Varianta prádlomatu pro ekonomiku Provozovatele: 'V3' (plný, s malou pračkou)
  // nebo 'V2' (menší/levnější, bez malé pračky). Řídí přepočet na portálu.
  pradlomat_version String @default("V3") @db.VarChar(8)
  eco_no_price Boolean @default(false)

  // Kdy obchodník naposledy klikl na „Volat" (evidence pokusů o hovor).
  last_called_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Historie komunikace s leadem (oslovení napříč kanály).
  messages LeadMessage[]

  @@index([status])
  @@index([role])
  @@index([email])
  @@index([owner_person_id])
  @@index([external_rep_id])
  @@index([is_test])
  @@index([meta_form_id])
  @@map("compounder_leads")
}

// Historie komunikace s leadem — každé oslovení / zpráva napříč kanály (LinkedIn,
// e-mail, WhatsApp…), včetně AI návrhů. Slouží k timeline komunikace u obchodníka.
model LeadMessage {
  id      Int            @id @default(autoincrement())
  lead_id Int
  lead    CompounderLead @relation(fields: [lead_id], references: [id], onDelete: Cascade)

  channel   String  @default("note") @db.VarChar(20) // linkedin | email | whatsapp | sms | note
  direction String  @default("out") @db.VarChar(10)  // out (my leadovi) | in (od leada)
  subject   String? @db.VarChar(300)
  body      String  @db.Text
  status    String  @default("draft") @db.VarChar(20) // draft | sent | copied | failed

  generated_by_ai      Boolean   @default(false)
  created_by_person_id Int?
  sent_at              DateTime?
  created_at           DateTime  @default(now())

  // Identifikátor externí zprávy (internetMessageId) — u příchozích odpovědí z e-mailu,
  // slouží k deduplikaci, aby se stejná odpověď nezaložila víckrát. U odchozích null.
  ext_message_id String? @unique @db.VarChar(500)

  @@index([lead_id, created_at])
  @@map("lead_messages")
}

// Do-not-contact seznam pro Compounder — obchodník nesmí oslovit tyto kontakty.
// Ukládá se jen e-mail + telefon (normalizované), ne celý osobní záznam.
model CompounderBlocklist {
  id         Int      @id @default(autoincrement())
  name       String?  @db.VarChar(160)
  email      String?  @db.VarChar(255)
  phone      String?  @db.VarChar(40)
  note       String?  @db.VarChar(255)
  created_at DateTime @default(now())

  @@index([email])
  @@index([phone])
  @@map("compounder_blocklist")
}

// =============================================================================
// COMPOUNDING — rezervace lokality (prádlomatu) k prodeji
// =============================================================================
// Životní cyklus: reserved (blokuje, čeká podpis rezervační smlouvy + poplatek)
//   → active (poplatek přišel, drží se po rezervační dobu, čeká kupní smlouvu)
//   → completed (kupní smlouva podepsána + zaplacena)
//   nebo cancelled / expired (uvolní lokalitu ostatním).
model LocationReservation {
  id         Int    @id @default(autoincrement())
  kiosk_code String @db.VarChar(40) // kód lokality (kiosku) ze SIS
  lead_id    Int? // CompounderLead, kdo rezervuje

  // Hlavička smlouvy (identita kupujícího)
  buyer_name    String? @db.VarChar(255)
  buyer_email   String? @db.VarChar(255)
  buyer_phone   String? @db.VarChar(40)
  buyer_ico     String? @db.VarChar(20)
  buyer_dic     String? @db.VarChar(20) // DIČ / VAT ID — plátce DPH; prefix země určuje reverse charge
  buyer_address String? @db.Text
  buyer_rep     String? @db.VarChar(255) // zastoupen(a) / jednatel zájemce
  buyer_bank    String? @db.VarChar(120) // bankovní spojení zájemce (IBAN)

  // Rezervace + poplatek (Kč), poplatek se odečítá z kupní ceny
  days           Int    @default(0)
  fee_per_day    Int    @default(0)
  fee_total      Int    @default(0)
  purchase_price Int? // snapshot celkové kupní ceny (Kč)
  currency       String @default("CZK") @db.VarChar(3)

  // hold | reserved | active | completed | cancelled | expired
  // hold = 1h blokace po kliknutí (jen rezervující smí dokončit hlavičku)
  status String @default("reserved") @db.VarChar(20)

  // Rezervace „na důvěru" (podání ruky) — bez rezervační smlouvy a poplatku.
  // Blokuje lokalitu jako běžná rezervace a sama vyprší k reserved_until.
  on_trust Boolean @default(false)

  // Lhůty
  hold_until     DateTime? // konec 1h blokace (fáze hold)
  sign_until     DateTime? // podpis rezervační smlouvy do
  fee_until      DateTime? // připsání poplatku do
  reserved_until DateTime? // konec rezervační doby (kupní smlouva do)

  fee_paid_at      DateTime?
  purchase_paid_at DateTime?
  signed_at        DateTime?
  cancel_reason    String?   @db.VarChar(200)

  // Pokyny k platbě — kolikrát odeslány (e-mail/WhatsApp) + kdy naposledy.
  pay_instr_sent_count   Int       @default(0)
  pay_instr_last_sent_at DateTime?

  // Sběr identifikačních údajů kupujícího přes veřejný odkaz (compounder.world) — token + poznámka.
  details_token       String?   @unique @db.VarChar(64) // magic-link pro veřejný formulář údajů
  details_expires_at  DateTime? // platnost odkazu
  details_filled_at   DateTime? // kdy zákazník vyplnil
  note                String?   @db.Text // poznámka od zákazníka

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([kiosk_code])
  @@index([status])
  @@index([lead_id])
  @@map("location_reservations")
}

// =============================================================================
// COMPOUNDER â€” analytika chovĂˇnĂ­ (eventy z webu i Portalu compounder.world)
// =============================================================================
// AnonymnĂ­ behaviorĂˇlnĂ­ eventy (sid = session id z prohlĂ­ĹľeÄŤe). register_success
// nese v props lead_id â†’ spojenĂ­ session â†” lead pro per-lead cestu.
model CompounderEvent {
  id         Int      @id @default(autoincrement())
  sid        String   @db.VarChar(64)
  event      String   @db.VarChar(60)
  props      Json?
  path       String?  @db.VarChar(300)
  lang       String?  @db.VarChar(10)
  ua         String?  @db.Text
  ip         String?  @db.VarChar(64)
  created_at DateTime @default(now())

  @@index([sid])
  @@index([event])
  @@index([created_at])
  @@map("compounder_events")
}

// =============================================================================
// COMPOUNDER â€” push odbÄ›ry (Web Push / VAPID) pro compounder.world
// =============================================================================
// OdbÄ›r push notifikacĂ­ z prohlĂ­ĹľeÄŤe. lead_id spojuje odbÄ›r s registrovanĂ˝m
// leadem (pĹ™es magic-link token), sid s anonymnĂ­ session.
model CompounderPushSub {
  id           Int       @id @default(autoincrement())
  endpoint     String    @unique @db.VarChar(500)
  p256dh       String    @db.VarChar(255)
  auth         String    @db.VarChar(255)
  lead_id      Int?
  sid          String?   @db.VarChar(64)
  lang         String?   @db.VarChar(10)
  ua           String?   @db.Text
  last_sent_at DateTime?
  created_at   DateTime  @default(now())

  @@index([lead_id])
  @@map("compounder_push_subs")
}

// =============================================================================
// COMPOUNDING — evidence smluv k lokalitám (kupní/servisní/rezervační)
// =============================================================================
// Smlouvy generované u lokalit prádlomatů (tab Compounding). Lokalita je
// identifikovaná kódem ze SIS (kiosk_code), ne přes Site. fields = uložené
// hodnoty polí smlouvy, share_token = veřejný odkaz na vyplnění hlavičky.
model CompoundingContract {
  id               Int       @id @default(autoincrement())
  kiosk_code       String    @db.VarChar(40)
  kiosk_label      String?   @db.VarChar(300)
  type             String    @db.VarChar(20)   // kupni | servisni | rezervacni
  status           String    @default("koncept") @db.VarChar(20) // koncept|odeslano|vyplneno|podepsano
  fields           Json      @default("{}")
  share_token      String?   @unique @db.VarChar(64)
  share_expires_at DateTime?
  filled_at        DateTime?
  signed_at        DateTime?
  created_by_id    Int?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  @@index([kiosk_code])
  @@index([status])
  @@map("compounding_contracts")
}

// Osobní prodejní cíl obchodníka. metric: new_contacts|conversions|reservations|revenue,
// period: day|week|month|year. value = cílová hodnota (počet, resp. Kč u revenue).
model SalesTarget {
  id        Int      @id @default(autoincrement())
  person_id Int
  metric    String   @db.VarChar(20)
  period    String   @db.VarChar(10)
  value     Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([person_id, metric, period])
  @@index([person_id])
  @@map("sales_targets")
}

// =============================================================================
// OBCHOD — Autonomní AI vedoucí obchodu
// =============================================================================
// AI agent, který obchodníkovi každý den rozdá úkoly (SalesDayPlan + SalesTask),
// večer den vyhodnotí a týdně/měsíčně sestaví hodnocení k výplatě (SalesReview).
// Odděleno od výrobního Velína (velin_*), aby se agendy nemíchaly.
// Vazby na Person/CompounderLead/Site jsou volné (jen ID, bez formální relace).

// Denní plán obchodníka — jedna hlavička na osobu/den, sdružuje úkoly dne.
model SalesDayPlan {
  id           Int      @id @default(autoincrement())
  person_id    Int
  date         DateTime @db.Date
  generated_by String   @default("ai") @db.VarChar(20) // ai | manager | self
  generated_at DateTime @default(now())
  focus        String?  @db.Text // AI shrnutí zaměření dne (1-2 věty)
  status       String   @default("published") @db.VarChar(20) // draft | published | locked
  morning_pushed_at DateTime?

  tasks SalesTask[] @relation("SalesTaskDayPlan")

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([person_id, date])
  @@index([date])
  @@map("sales_day_plans")
}

// Konkrétní úkol pro obchodníka na den. Zdroj = AI vedoucí (nebo ruční/self).
model SalesTask {
  id          Int  @id @default(autoincrement())
  day_plan_id Int?
  person_id   Int
  lead_id     Int? // CompounderLead (volná vazba)
  site_id     Int? // Site / lokalita (volná vazba)

  // call | followup | invite | close | reservation | meeting | admin | other
  kind      String @default("other") @db.VarChar(20)
  title     String @db.VarChar(500)
  detail    String? @db.Text
  reasoning String? @db.Text // proč to AI navrhla
  priority  Int    @default(3) // 1=nejvyšší … 5=nejnižší
  est_min   Int? // odhad trvání v minutách (kapacita dne = Po-Pá 8 h)

  status         String    @default("open") @db.VarChar(20) // open | done | skipped
  done_at        DateTime?
  done_note      String?   @db.Text
  skipped_reason String?   @db.Text

  day_plan SalesDayPlan? @relation("SalesTaskDayPlan", fields: [day_plan_id], references: [id], onDelete: SetNull)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([person_id, status])
  @@index([day_plan_id])
  @@index([lead_id])
  @@map("sales_tasks")
}

// Hodnocení obchodníka — denní / týdenní / měsíční. Měsíční nese i podklad
// k výplatě (návrh + schválení vedoucím).
model SalesReview {
  id           Int      @id @default(autoincrement())
  person_id    Int
  kind         String   @db.VarChar(10) // day | week | month
  period_start DateTime @db.Date
  period_end   DateTime @db.Date

  score        Int     @default(0) // 0-100
  grade        String? @db.VarChar(30) // slovní stupeň: Výborný/Dobrý/Slabý…
  summary      String? @db.Text // slovní hodnocení
  highlights   String? @db.Text // co se povedlo
  improvements String? @db.Text // co zlepšit
  metrics      Json? // snapshot metrik (plán vs skutečnost, úkoly)

  // Podklad k výplatě (relevantní pro week/month)
  pay_currency   String? @db.VarChar(3)
  pay_base       Int? // navržená základní odměna
  pay_bonus      Int? // navržený bonus
  pay_commission Int? // navržená provize
  pay_total      Int? // celkem návrh
  pay_note       String? @db.Text // zdůvodnění návrhu

  // Schválení vedoucím obchodu
  approved_at           DateTime?
  approved_by_person_id Int?
  approved_total        Int? // schválená výsledná částka
  approved_note         String? @db.Text

  generated_at DateTime @default(now())
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@unique([person_id, kind, period_start])
  @@index([person_id, kind])
  @@map("sales_reviews")
}

// =============================================================================
// OBCHOD — CRM databáze leadů (import z předchozího CRM, po deduplikaci)
// =============================================================================
// Vyčištěné a informačně sloučené kontakty ze staré databáze. Plní import skript
// scripts/import-crm-leads.js. Segment se počítá ze stavu; dedup_key je
// normalizovaný telefon nebo e-mail (duplicity se slučují do jednoho záznamu).
model CrmLead {
  id        Int    @id @default(autoincrement())
  dedup_key String @unique @db.VarChar(140) // "t:<9 číslic>" | "e:<email>" | "r:<row>"

  first_name String? @db.VarChar(200)
  last_name  String? @db.VarChar(200)
  email      String? @db.VarChar(255)
  phone      String? @db.VarChar(60)
  city       String? @db.VarChar(200)
  country    String? @db.VarChar(120)

  status      String? @db.VarChar(60) // původní Stav z CRM
  // horky | volat | nedovolano | novy | nezajem | smlouva | ostatni
  segment     String  @default("ostatni") @db.VarChar(20)
  contactable Boolean @default(false)

  owner_name String? @db.VarChar(200) // obchodník z CRM (sloupec Typ)
  source     String? @db.VarChar(300) // INFO - reklama (kampaň/zdroj)
  note       String? @db.Text // sloučené poznámky
  dup_count  Int     @default(0) // kolik duplicit sloučeno do tohoto záznamu

  crm_created_at DateTime?
  imported_at    DateTime  @default(now())
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  @@index([segment])
  @@index([contactable])
  @@index([country])
  @@index([owner_name])
  @@map("crm_leads")
}

// Výběry — požadavky zákazníků na výběr (kontrola/evidence). Veřejná stránka bestseries.cash/vybery.
model WithdrawalRequest {
  id                Int      @id @default(autoincrement())
  email             String
  amount            Float?
  withdrawal_number String?
  note              String?
  status            String   @default("novy")
  status_log        Json?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@map("withdrawal_request")
}

// =============================================================================
// HLASOVÝ AI AGENT — příchozí hovory (Twilio ConversationRelay)
// =============================================================================
model VoiceCall {
  id              String    @id @default(uuid())
  direction       String    @default("inbound")
  agent_kind      String    @default("personal") // personal | infoline
  owner_person_id Int?
  from_number     String    @db.VarChar(32)
  to_number       String    @db.VarChar(32)
  twilio_call_sid String    @unique @db.VarChar(64)
  started_at      DateTime
  ended_at        DateTime?
  duration_sec    Int?
  transcript      Json?     // [{ role: 'caller'|'agent', text, ts }]
  summary         String?   @db.Text
  caller_name     String?   @db.VarChar(255)
  caller_intent   String?   @db.Text
  audio_url       String?   @db.Text // R2
  lead_id         String?   // CompounderLead (infolinka)
  sales_event_id  Int?      // zapsaná schůzka
  handoff         Boolean   @default(false)
  cost_usd        Decimal?  @db.Decimal(10, 4)
  created_at      DateTime  @default(now())

  owner_person    Person?   @relation("VoiceCallOwner", fields: [owner_person_id], references: [id])

  @@index([owner_person_id])
  @@index([from_number])
  @@index([started_at])
  @@map("voice_calls")
}
